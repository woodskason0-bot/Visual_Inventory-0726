@using Visual_Inventory_System.Models
@using Visual_Inventory_System.Services
@{
    ViewData["Title"] = "App Settings";
    var users = ViewBag.Users as List<User> ?? new List<User>();
    var pickupSubs = ViewBag.PickupSubscriptions as Dictionary<int, bool> ?? new Dictionary<int, bool>();
    var orgStructureJson = ViewBag.OrgStructureJson as string ?? "{}";
}

<style>
    .settings-wrap { max-width: 1100px; margin: 1.5rem auto; }

    .settings-card {
        background-color: var(--vis-card);
        border: 1px solid var(--vis-card-border);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.45);
    }

    .settings-card table { color: var(--vis-text); margin-bottom: 0; }
    .settings-card thead th {
        background-color: #14151A;
        color: #CBD5E1;
        border-color: var(--vis-card-border) !important;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.4px;
    }
    .settings-card tbody td {
        border-color: var(--vis-card-border) !important;
        vertical-align: middle;
    }
    .settings-card select.form-select-sm, .settings-card input.form-control-sm {
        background-color: #14151A;
        color: #fff;
        border-color: #3D4351;
    }
</style>

<div class="settings-wrap px-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-white">
            <i class="bi bi-gear-fill me-2" style="color: var(--vis-red);"></i>App Settings
        </h2>
        <form asp-controller="Settings" asp-action="Lock" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-light btn-sm">
                <i class="bi bi-lock-fill me-1"></i>Lock
            </button>
        </form>
    </div>

    <!-- USERS & ACCESS -->
<!-- ============ PENDING INTAKES (Pass 9) ============ -->
@{
    var pending = (List<Visual_Inventory_System.Models.IntakeBatch>)(ViewBag.PendingIntakes ?? new List<Visual_Inventory_System.Models.IntakeBatch>());
    var allLocs = (List<Visual_Inventory_System.Models.Location>)ViewBag.Locations;
}
<div class="settings-card p-4 mb-4">
    <h5 class="text-white fw-bold mb-1">
        Pending Intakes
        @if (pending.Any()) { <span class="badge bg-warning text-dark ms-2">@pending.Count</span> }
    </h5>
    <p class="text-light-gray small mb-3">
        Batches held because the location they named isn&rsquo;t recognised. Either
        <strong>map</strong> it onto somewhere that already exists under a different name,
        or <strong>create</strong> it. Either way the rows import through the same path a
        known-location batch takes.
    </p>

    @if (!pending.Any())
    {
        <div class="text-light-gray small">Nothing waiting.</div>
    }
    @foreach (var b in pending)
    {
        <div class="mb-3 p-3" style="background:#14151A; border:1px solid #3D4351; border-radius:6px;">
            <div class="d-flex justify-content-between flex-wrap">
                <div>
                    <span class="fw-bold text-white">Batch #@b.Id</span>
                    <span class="text-light-gray small ms-2">
                        @b.SubmittedBy · @b.SubmittedAt.ToLocalTime().ToString("MMM d h:mm tt")
                        · @b.Rows.Count row(s)
                        · Line: @(string.IsNullOrWhiteSpace(b.Line) ? "unassigned" : b.Line)
                        · Team: @(string.IsNullOrWhiteSpace(b.Team) ? "none" : b.Team)
                    </span>
                </div>
                <div class="text-warning small">asked for &ldquo;@b.RequestedLocation&rdquo;</div>
            </div>

            <table class="table table-sm mt-2 mb-2">
                <thead><tr><th>Model</th><th>Type</th><th>Brand</th><th>PN</th><th>Qty</th><th>Serial</th></tr></thead>
                <tbody>
                @foreach (var r in b.Rows)
                {
                    <tr>
                        <td class="fw-bold">@r.ItemName</td><td>@r.Type</td><td>@r.Brand</td>
                        <td>@r.RheemPartNumber</td><td>@r.Quantity</td>
                        <td class="text-light-gray small">@(string.IsNullOrWhiteSpace(r.SerialNumber) ? "—" : r.SerialNumber)</td>
                    </tr>
                }
                </tbody>
            </table>

            <form asp-controller="Settings" asp-action="ApproveIntake" method="post" class="d-flex gap-2 flex-wrap align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="batchId" value="@b.Id" />
                <div>
                    <label class="form-label small text-light-gray mb-0">Map to existing</label>
                    <select name="mapToLocationId" class="form-select form-select-sm" style="max-width:260px;">
                        <option value="0">— or create new below —</option>
                        @foreach (var l in allLocs.Where(x => x.IsActive))
                        {
                            <option value="@l.Id">@l.Level: @l.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label small text-light-gray mb-0">…or new</label>
                    <input type="text" name="newName" placeholder="Name" class="form-control form-control-sm" style="max-width:160px;" />
                </div>
                <select name="newLevel" class="form-select form-select-sm" style="max-width:110px;">
                    <option value="Parent">Parent</option><option value="Major">Major</option><option value="Sub">Sub</option>
                </select>
                <select name="newOwnerId" class="form-select form-select-sm" style="max-width:190px;">
                    <option value="0">— top level —</option>
                    @foreach (var l in allLocs.Where(x => x.IsActive && x.Level != "Sub"))
                    {
                        <option value="@l.Id">@l.Level: @l.Name</option>
                    }
                </select>
                <input type="text" name="rack" value="@b.Rack" placeholder="Rack" class="form-control form-control-sm" style="max-width:110px;" />
                <input type="text" name="row" value="@b.Row" placeholder="Row" class="form-control form-control-sm" style="max-width:100px;" />
                <button type="submit" class="btn btn-sm btn-success fw-bold">Approve &amp; Import</button>
            </form>

            <form asp-controller="Settings" asp-action="RejectIntake" method="post" class="d-flex gap-2 mt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="batchId" value="@b.Id" />
                <input type="text" name="note" placeholder="Reason (optional)" class="form-control form-control-sm" style="max-width:280px;" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
            </form>
        </div>
    }
</div>

<!-- ============ MAP ZONES (Pass 8) ============ -->
<div class="settings-card p-4 mb-4">
    <h5 class="text-white fw-bold mb-1">Locations &mdash; Map</h5>
    <p class="text-light-gray small mb-3">
        Drag a box on the floorplan to make a <strong>Parent</strong> location clickable.
        Pick an existing one, or choose <em>＋ New parent…</em> to create it and draw it in
        one go.
        Coordinates are stored as fractions of the image, so a zone stays put if the
        floorplan is ever re-exported at another size. One Parent can have several
        zones &mdash; draw again to add another.
    </p>

    @{
        var zones = (dynamic)ViewBag.MapZones;
        var parentLocs = ((List<Visual_Inventory_System.Models.Location>)ViewBag.Locations)
            .Where(x => x.Level == "Parent" && x.IsActive).OrderBy(x => x.Name).ToList();
    }

    <div id="zone-editor" style="position:relative; display:inline-block; max-width:100%; border:1px solid var(--vis-card-border); border-radius:6px; overflow:hidden;">
        <img id="zone-map-img" src="~/images/facility.png" alt="Facility Map" style="display:block; max-width:100%; height:auto; user-select:none;" draggable="false" />
        <div id="zone-overlay" style="position:absolute; inset:0; cursor:crosshair;"></div>
    </div>

    <form asp-controller="Settings" asp-action="AddZone" method="post" id="zone-form" class="d-flex gap-2 flex-wrap align-items-center mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="x" id="zone-x" /><input type="hidden" name="y" id="zone-y" />
        <input type="hidden" name="w" id="zone-w" /><input type="hidden" name="h" id="zone-h" />
        <span class="text-light-gray small" id="zone-readout">Drag a box on the map first.</span>
        @* Drawing a box round an area that isn't registered yet is the normal case
           when a team turns up, so the Parent can be created right here rather than
           forcing a trip to the Locations panel and back. *@
        <select name="locationId" id="zone-parent" class="form-select form-select-sm" style="max-width:220px;">
            @foreach (var p in parentLocs)
            {
                <option value="@p.Id">@p.Name</option>
            }
            <option value="0">＋ New parent…</option>
        </select>
        <input type="text" name="newParentName" id="zone-newparent" placeholder="New parent name"
               class="form-control form-control-sm" style="max-width:200px; display:none;" />
        <input type="text" name="label" placeholder="Label (optional)" class="form-control form-control-sm" style="max-width:180px;" />
        <button type="submit" class="btn btn-sm btn-success fw-bold" id="zone-save" disabled>Save Zone</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="zone-clear">Clear</button>
    </form>

    <table class="table table-sm align-middle mt-3">
        <thead><tr><th>Parent</th><th>Label</th><th>Position</th><th>Size</th><th class="text-end"></th></tr></thead>
        <tbody>
        @foreach (var z in zones)
        {
            <tr>
                <td class="fw-bold">@z.Name</td>
                <td class="text-light-gray small">@(string.IsNullOrWhiteSpace((string)z.Label) ? "—" : z.Label)</td>
                <td class="text-light-gray small"><code>@(((double)z.X).ToString("F3")), @(((double)z.Y).ToString("F3"))</code></td>
                <td class="text-light-gray small"><code>@(((double)z.W).ToString("F3")) × @(((double)z.H).ToString("F3"))</code></td>
                <td class="text-end">
                    <form asp-controller="Settings" asp-action="DeleteZone" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="zoneId" value="@z.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <div class="text-light-gray small">
        <i class="bi bi-info-circle me-1"></i>Removing a zone only takes it off the map.
        The location, its stock and every picker are untouched.
    </div>
</div>

<!-- ============ LOCATIONS (Pass 7C) ============ -->
<div class="settings-card p-4 mb-4">
    <h5 class="text-white fw-bold mb-1">Locations</h5>
    <p class="text-light-gray small mb-3">
        The Parent / Major / Sub vocabulary used everywhere locations are picked.
        <strong>Codes are derived, never typed</strong> &mdash; the 1st, 3rd, 5th and last
        character of the name, the same rule the app has always used. Rack and Row stay
        free text on each item.
    </p>

    @{
        var locs = (List<Visual_Inventory_System.Models.Location>)ViewBag.Locations;
        var codes = (Dictionary<int, string>)ViewBag.LocationCodes;
        var byId = locs.ToDictionary(x => x.Id, x => x);
        string OwnerOf(Visual_Inventory_System.Models.Location l) =>
            l.ParentId.HasValue && byId.ContainsKey(l.ParentId.Value) ? byId[l.ParentId.Value].Name : "—";
    }

    <table class="table table-sm align-middle">
        <thead><tr><th>Level</th><th>Name</th><th>Code</th><th>Within</th><th class="text-end">Status</th></tr></thead>
        <tbody>
        @foreach (var lvl in Visual_Inventory_System.Models.LocationLevel.All)
        {
            foreach (var l in locs.Where(x => x.Level == lvl).OrderBy(x => x.Name))
            {
                <tr style="@(l.IsActive ? "" : "opacity:.5;")">
                    <td class="text-light-gray small">@l.Level</td>
                    <td class="fw-bold">@l.Name</td>
                    <td><code>@(codes.ContainsKey(l.Id) ? codes[l.Id] : "")</code></td>
                    <td class="text-light-gray small">@OwnerOf(l)</td>
                    <td class="text-end">
                        <form asp-controller="Settings" asp-action="ToggleLocationActive" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="locationId" value="@l.Id" />
                            <button type="submit" class="btn btn-sm @(l.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                @(l.IsActive ? "Hide" : "Restore")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>

    <h6 class="text-white fw-bold mb-2 mt-4">Add Location</h6>
    <form asp-controller="Settings" asp-action="AddLocation" method="post" class="d-flex gap-2 flex-wrap align-items-center">
        @Html.AntiForgeryToken()
        <select name="level" id="loc-level" class="form-select form-select-sm" style="max-width:130px;">
            <option value="Parent">Parent</option>
            <option value="Major">Major</option>
            <option value="Sub">Sub</option>
        </select>
        <input type="text" name="name" placeholder="Location name" required
               class="form-control form-control-sm" style="max-width:220px;" />
        <select name="parentId" id="loc-owner" class="form-select form-select-sm" style="max-width:230px;" disabled>
            <option value="">— top level —</option>
        </select>
        <button type="submit" class="btn btn-sm btn-success fw-bold">Add Location</button>
    </form>
    <div class="text-light-gray small mt-2">
        <i class="bi bi-info-circle me-1"></i>Hiding a location drops it from the pickers
        <em>and</em> from the decode map, so anything still stored there reverts to showing its raw
        code until it's moved. A name whose code would collide with an existing one is rejected.
    </div>
</div>

<!-- ============ TEAMS / PROJECTS (Pass 7A) ============ -->
<div class="settings-card p-4 mb-4">
    <h5 class="text-white fw-bold mb-1">Teams &amp; Projects</h5>
    <p class="text-light-gray small mb-3">
        The Team / Project options offered at registration. Team is a
        <strong>label</strong>, not a permission &mdash; who can see an item is decided by
        its Line, not its team. Blank / <code>N/A</code> is always allowed.
    </p>

    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Team</th><th>Project Code</th><th>Home Branch / Line</th><th>In Use</th><th class="text-end">Status</th></tr>
        </thead>
        <tbody>
        @foreach (var t in (List<Visual_Inventory_System.Models.Team>)ViewBag.Teams)
        {
            <tr style="@(t.IsActive ? "" : "opacity:.5;")">
                <td class="fw-bold">@t.Name</td>
                <td>
                    <form asp-controller="Settings" asp-action="UpdateProjectCode" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="teamId" value="@t.Id" />
                        <input type="text" name="projectCode" value="@t.ProjectCode" maxlength="30"
                               class="form-control form-control-sm" style="width:120px;" placeholder="(none)" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                    </form>
                </td>
                <td>
                    @* Metadata only -- does not gate visibility. Feeds the registration/
                       ownership auto-fill and the compressor filter's Team suggestion. *@
                    <form asp-controller="Settings" asp-action="UpdateTeamLine" method="post" class="d-flex gap-2 line-picker" data-current-line="@t.Line">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="teamId" value="@t.Id" />
                        <select class="form-select form-select-sm branch-select" style="width: 150px;">
                            <option value="">-- Branch --</option>
                        </select>
                        <select name="line" class="form-select form-select-sm line-select" style="width: 170px;">
                            <option value="">Unassigned</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                    </form>
                </td>
                <td class="text-light-gray small">@(ViewBag.TeamUsage != null && ((Dictionary<string,int>)ViewBag.TeamUsage).ContainsKey(t.Name) ? ((Dictionary<string,int>)ViewBag.TeamUsage)[t.Name] : 0) item(s)</td>
                <td class="text-end">
                    <form asp-controller="Settings" asp-action="ToggleTeamActive" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="teamId" value="@t.Id" />
                        <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                            @(t.IsActive ? "Hide" : "Restore")
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <h6 class="text-white fw-bold mb-2 mt-4">Add Team</h6>
    <form asp-controller="Settings" asp-action="AddTeam" method="post" class="d-flex gap-2 flex-wrap">
        @Html.AntiForgeryToken()
        <input type="text" name="name" placeholder="Team name" required
               class="form-control form-control-sm" style="max-width:200px;" />
        <input type="text" name="projectCode" placeholder="Project code (optional)"
               class="form-control form-control-sm" style="max-width:200px;" />
        <button type="submit" class="btn btn-sm btn-success fw-bold">Add Team</button>
    </form>
    <div class="text-light-gray small mt-2">
        <i class="bi bi-info-circle me-1"></i>Hiding a team removes it from the pickers but leaves
        existing items untouched. Renaming isn't offered &mdash; items store the team name directly,
        so a rename would orphan them. Add the new name and hide the old one.
    </div>
</div>

<!-- ============ BRANCHES & LINES (Pass 13) ============ -->
<div class="settings-card p-4 mb-4">
    <h5 class="text-white fw-bold mb-1">Branches &amp; Lines</h5>
    <p class="text-light-gray small mb-3">
        The org structure offered everywhere a Branch/Line is picked (registration, transfer,
        team home line, user assignment). <strong>Line is what gates visibility</strong> on
        items/users &mdash; hiding one here only removes it from future picks, it never touches
        a Line string an item or user already carries.
    </p>

    <h6 class="text-white fw-bold mb-2">Branches</h6>
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Branch</th><th>Lines</th><th class="text-end">Status</th></tr>
        </thead>
        <tbody>
        @foreach (var b in (List<Visual_Inventory_System.Models.Branch>)ViewBag.Branches)
        {
            var linesUnder = ((List<Visual_Inventory_System.Models.OrgLine>)ViewBag.OrgLinesAll)
                .Where(l => l.BranchId == b.Id).ToList();
            <tr style="@(b.IsActive ? "" : "opacity:.5;")">
                <td class="fw-bold">@b.Name</td>
                <td class="text-light-gray small">@linesUnder.Count(l => l.IsActive) active / @linesUnder.Count total</td>
                <td class="text-end">
                    <form asp-controller="Settings" asp-action="ToggleBranchActive" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="branchId" value="@b.Id" />
                        <button type="submit" class="btn btn-sm @(b.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                            @(b.IsActive ? "Hide" : "Restore")
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <form asp-controller="Settings" asp-action="AddBranch" method="post" class="d-flex gap-2 flex-wrap mb-4">
        @Html.AntiForgeryToken()
        <input type="text" name="name" placeholder="Branch name" required
               class="form-control form-control-sm" style="max-width:220px;" />
        <button type="submit" class="btn btn-sm btn-success fw-bold">Add Branch</button>
    </form>

    <h6 class="text-white fw-bold mb-2">Lines</h6>
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Line</th><th>Branch</th><th>In Use</th><th class="text-end">Status</th></tr>
        </thead>
        <tbody>
        @{ var lineUsage = ViewBag.LineUsage as Dictionary<string, int> ?? new Dictionary<string, int>(); }
        @foreach (var l in (List<Visual_Inventory_System.Models.OrgLine>)ViewBag.OrgLinesAll)
        {
            <tr style="@(l.IsActive ? "" : "opacity:.5;")">
                <td class="fw-bold">@l.Name</td>
                <td class="text-light-gray small">@(l.Branch?.Name ?? "(unknown)")</td>
                <td class="text-light-gray small">@(lineUsage.ContainsKey(l.Name) ? lineUsage[l.Name] : 0) item(s)</td>
                <td class="text-end">
                    <form asp-controller="Settings" asp-action="ToggleLineActive" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="lineId" value="@l.Id" />
                        <button type="submit" class="btn btn-sm @(l.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                            @(l.IsActive ? "Hide" : "Restore")
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <h6 class="text-white fw-bold mb-2 mt-4">Add Line</h6>
    <form asp-controller="Settings" asp-action="AddLine" method="post" class="d-flex gap-2 flex-wrap">
        @Html.AntiForgeryToken()
        <input type="text" name="name" placeholder="Line name" required
               class="form-control form-control-sm" style="max-width:260px;" />
        <select name="branchId" required class="form-select form-select-sm" style="max-width:200px;">
            <option value="">-- Branch --</option>
            @foreach (var b in (List<Visual_Inventory_System.Models.Branch>)ViewBag.Branches)
            {
                if (b.IsActive)
                {
                    <option value="@b.Id">@b.Name</option>
                }
            }
        </select>
        <button type="submit" class="btn btn-sm btn-success fw-bold">Add Line</button>
    </form>
    <div class="text-light-gray small mt-2">
        <i class="bi bi-info-circle me-1"></i>Hiding a Branch takes its Lines out of the pickers
        with it. Renaming isn't offered here either, same reason as Teams &mdash; add the new
        name and hide the old one.
    </div>
</div>

    <div class="settings-card p-4 mb-4">
        <h5 class="text-white fw-bold mb-3">Users &amp; Access</h5>
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Login</th>
                    <th>Team</th>
                    <th>Line</th>
                    <th>Access Level</th>
                    <th>Active</th>
                    <th>Pickup Alerts</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    bool subscribed = pickupSubs.TryGetValue(u.Id, out var en) && en;
                    <tr>
                        <td>@u.DisplayName</td>
                        <td class="text-dim">@u.UserName</td>
                        <td class="text-dim">@(string.IsNullOrEmpty(u.Team) ? "All" : u.Team)</td>
                        <td>
                            <form asp-controller="Settings" asp-action="UpdateLine" method="post" class="d-flex gap-2 line-picker" data-current-line="@u.Line" data-current-branch="@u.Branch">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <select name="branch" class="form-select form-select-sm branch-select" style="width: 150px;">
                                    <option value="">-- Branch --</option>
                                </select>
                                <select name="line" class="form-select form-select-sm line-select" style="width: 170px;">
                                    <option value="">Unassigned</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-danger">Save</button>
                            </form>
                        </td>
                        <td>
                            <form asp-controller="Settings" asp-action="UpdateAccessLevel" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <select name="newLevel" class="form-select form-select-sm" style="width: 140px;">
                                    @foreach (var lvl in new[] { AccessLevels.Viewer, AccessLevels.Standard, AccessLevels.Engineer, AccessLevels.Management, AccessLevels.Admin })
                                    {
                                        if (lvl == u.AccessLevel)
                                        {
                                            <option value="@lvl" selected>@AccessLevels.Name(lvl)</option>
                                        }
                                        else
                                        {
                                            <option value="@lvl">@AccessLevels.Name(lvl)</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-danger">Save</button>
                            </form>
                        </td>
                        <td>
                            <form asp-controller="Settings" asp-action="ToggleActive" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-light" : "btn-outline-secondary")">
                                    @(u.IsActive ? "Active" : "Hidden")
                                </button>
                            </form>
                        </td>
                        <td>
                            <form asp-controller="Settings" asp-action="UpdateNotificationSubscription" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <input type="hidden" name="category" value="PickupRequested" />
                                <input type="hidden" name="enabled" value="@(!subscribed ? "true" : "false")" />
                                <button type="submit" class="btn btn-sm @(subscribed ? "btn-outline-success" : "btn-outline-secondary")">
                                    @(subscribed ? "On" : "Off")
                                </button>
                            </form>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteUserModal-@u.Id" title="Remove @u.DisplayName">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h6 class="text-white fw-bold mb-2 mt-4">Add New User</h6>
        <form id="addUserForm" asp-controller="Settings" asp-action="AddUser" method="post" class="d-flex gap-2 flex-wrap">
            @Html.AntiForgeryToken()
            <input type="text" name="displayName" class="form-control form-control-sm" placeholder="First Last"
                   style="max-width: 200px;" required pattern="^[A-Za-z'-]+\s[A-Za-z'-]+$"
                   title="Enter as First Last, e.g. Jane Doe" />
            <input type="text" name="team" class="form-control form-control-sm" placeholder="Team (optional)" style="max-width: 160px;" />
            <select class="form-select form-select-sm branch-select" style="max-width: 160px;">
                <option value="">-- Branch --</option>
            </select>
            <select name="line" class="form-select form-select-sm line-select" style="max-width: 180px;">
                <option value="">Unassigned</option>
            </select>
            <select name="accessLevel" class="form-select form-select-sm" style="max-width: 160px;">
                <option value="1">Viewer</option>
                <option value="2" selected>Standard</option>
                <option value="3">Engineer</option>
                <option value="4">Management</option>
                <option value="5">Admin</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Add User</button>
        </form>
    </div>
</div>

<!-- DELETE USER CONFIRM MODALS -->
@foreach (var u in users)
{
    <div class="modal fade" id="deleteUserModal-@u.Id" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: var(--vis-card); border: 1px solid var(--vis-card-border);">
                <div class="modal-header" style="border-bottom: 1px solid var(--vis-card-border);">
                    <h5 class="modal-title fw-bold text-white">Remove @u.DisplayName?</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Settings" asp-action="DeleteUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@u.Id" />
                    <div class="modal-body text-white">
                        <p class="small">
                            This permanently removes @u.DisplayName (@u.UserName) from the roster.
                            Their past transactions and orders keep their name in the log, but they'll
                            need to be re-added here to sign in again.
                        </p>
                        <label class="form-label small fw-bold text-light-gray">Type "@u.DisplayName" to confirm</label>
                        <input type="text" name="confirmName" class="form-control form-control-sm" required autocomplete="off" />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--vis-card-border);">
                        <button type="button" class="btn btn-outline-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm">Delete Permanently</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    (function () {
        var orgStructure = @Html.Raw(orgStructureJson);

        function populateBranches(branchSelect) {
            branchSelect.innerHTML = '<option value="">-- Branch --</option>';
            Object.keys(orgStructure).forEach(function (branch) {
                var opt = document.createElement('option');
                opt.value = branch;
                opt.textContent = branch;
                branchSelect.appendChild(opt);
            });
        }

        function populateLines(lineSelect, branch, selectedLine) {
            lineSelect.innerHTML = '<option value="">Unassigned</option>';
            var lines = orgStructure[branch] || [];
            if (branch) {
                var wholeBranchOpt = document.createElement('option');
                wholeBranchOpt.value = '__WHOLE_BRANCH__';
                wholeBranchOpt.textContent = '— Entire Branch —';
                if (selectedLine === '__WHOLE_BRANCH__') wholeBranchOpt.selected = true;
                lineSelect.appendChild(wholeBranchOpt);
            }
            lines.forEach(function (line) {
                var opt = document.createElement('option');
                opt.value = line;
                opt.textContent = line;
                if (line === selectedLine) opt.selected = true;
                lineSelect.appendChild(opt);
            });
        }

        function branchForLine(line) {
            for (var branch in orgStructure) {
                if (orgStructure[branch].indexOf(line) !== -1) return branch;
            }
            return "";
        }

        function wireLinePicker(container) {
            var branchSelect = container.querySelector('.branch-select');
            var lineSelect = container.querySelector('.line-select');
            if (!branchSelect || !lineSelect) return;

            populateBranches(branchSelect);

            var currentLine = container.getAttribute('data-current-line') || '';
            var currentBranch = branchForLine(currentLine);
            var lineToSelect = currentLine;
            if (!currentBranch) {
                // No specific Line -- check for a whole-Branch assignment instead.
                var wholeBranch = container.getAttribute('data-current-branch') || '';
                if (wholeBranch) {
                    currentBranch = wholeBranch;
                    lineToSelect = '__WHOLE_BRANCH__';
                }
            }
            if (currentBranch) branchSelect.value = currentBranch;
            populateLines(lineSelect, currentBranch, lineToSelect);

            branchSelect.addEventListener('change', function () {
                populateLines(lineSelect, branchSelect.value, '');
            });
        }

        document.querySelectorAll('.line-picker').forEach(wireLinePicker);

        var addUserForm = document.getElementById('addUserForm');
        if (addUserForm) wireLinePicker(addUserForm);
    })();
</script>

<script>
    // Add-Location owner picker: a Major belongs to a Parent, a Sub to a Major.
    // Built from the same rows the table above renders, so it can't offer an
    // owner that doesn't exist.
    (function () {
        const levelSel = document.getElementById('loc-level');
        const ownerSel = document.getElementById('loc-owner');
        if (!levelSel || !ownerSel) return;

        const parents = [@Html.Raw(string.Join(",", ((List<Visual_Inventory_System.Models.Location>)ViewBag.Locations).Where(x => x.Level == "Parent" && x.IsActive).Select(x => $"{{id:{x.Id},name:\"{x.Name}\"}}")))];
        const majors  = [@Html.Raw(string.Join(",", ((List<Visual_Inventory_System.Models.Location>)ViewBag.Locations).Where(x => x.Level == "Major" && x.IsActive).Select(x => $"{{id:{x.Id},name:\"{x.Name}\"}}")))];

        function refresh() {
            const lvl = levelSel.value;
            const src = lvl === 'Major' ? parents : (lvl === 'Sub' ? majors : []);
            ownerSel.innerHTML = '';
            if (lvl === 'Parent') {
                ownerSel.innerHTML = '<option value="">— top level —</option>';
                ownerSel.disabled = true;
                return;
            }
            ownerSel.disabled = false;
            src.forEach(function (o) {
                const opt = document.createElement('option');
                opt.value = o.id; opt.textContent = o.name;
                ownerSel.appendChild(opt);
            });
        }
        levelSel.addEventListener('change', refresh);
        refresh();
    })();
</script>

<script>
    // ---- Pass 8: drag-to-draw map zones -------------------------------------
    // Everything is normalised against the OVERLAY's rendered box, so the numbers
    // saved are fractions of the image and independent of how big it happens to
    // be drawn on this screen.
    (function () {
        const overlay = document.getElementById('zone-overlay');
        const readout = document.getElementById('zone-readout');
        const saveBtn = document.getElementById('zone-save');
        if (!overlay || !readout || !saveBtn) return;

        const fx = document.getElementById('zone-x'), fy = document.getElementById('zone-y');
        const fw = document.getElementById('zone-w'), fh = document.getElementById('zone-h');

        const existing = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            ((IEnumerable<dynamic>)ViewBag.MapZones).Select(z => new {
                name = (string)z.Name, x = (double)z.X, y = (double)z.Y, w = (double)z.W, h = (double)z.H }))); 

        // Paint what's already placed so you can see coverage before adding more.
        existing.forEach(function (z) {
            const d = document.createElement('div');
            d.style.cssText = 'position:absolute;border:2px solid #22C55E;background:rgba(34,197,94,.18);'
                + 'pointer-events:none;font-size:10px;color:#DCFCE7;padding:1px 3px;overflow:hidden;';
            d.style.left = (z.x * 100) + '%'; d.style.top = (z.y * 100) + '%';
            d.style.width = (z.w * 100) + '%'; d.style.height = (z.h * 100) + '%';
            d.textContent = z.name;
            overlay.appendChild(d);
        });

        let box = null, startX = 0, startY = 0, drawing = false;

        function frac(e) {
            const r = overlay.getBoundingClientRect();
            // Clamp: a drag that leaves the image would otherwise post coordinates
            // the server has to reject, which reads as the save mysteriously failing.
            return {
                x: Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)),
                y: Math.min(1, Math.max(0, (e.clientY - r.top) / r.height))
            };
        }

        overlay.addEventListener('mousedown', function (e) {
            e.preventDefault();
            const p = frac(e);
            startX = p.x; startY = p.y; drawing = true;
            if (box) box.remove();
            box = document.createElement('div');
            box.style.cssText = 'position:absolute;border:2px dashed #F59E0B;background:rgba(245,158,11,.20);pointer-events:none;';
            overlay.appendChild(box);
        });

        window.addEventListener('mousemove', function (e) {
            if (!drawing || !box) return;
            const p = frac(e);
            // Dragging up or left is normal -- take the min corner and an absolute
            // size so any direction produces a valid rectangle.
            const x = Math.min(startX, p.x), y = Math.min(startY, p.y);
            const w = Math.abs(p.x - startX), h = Math.abs(p.y - startY);
            box.style.left = (x * 100) + '%'; box.style.top = (y * 100) + '%';
            box.style.width = (w * 100) + '%'; box.style.height = (h * 100) + '%';
            fx.value = x.toFixed(6); fy.value = y.toFixed(6);
            fw.value = w.toFixed(6); fh.value = h.toFixed(6);
            readout.textContent = `x ${x.toFixed(3)} · y ${y.toFixed(3)} · ${w.toFixed(3)} × ${h.toFixed(3)}`;
        });

        window.addEventListener('mouseup', function () {
            if (!drawing) return;
            drawing = false;
            const ok = parseFloat(fw.value) > 0.005 && parseFloat(fh.value) > 0.005;
            saveBtn.disabled = !ok;
            if (!ok) readout.textContent = 'That box is too small to click — drag a larger area.';
        });

        // "＋ New parent…" swaps the dropdown for a name box. The field is only
        // sent when it's visible -- an empty newParentName means "use the picked
        // Parent", which is what the server branches on.
        const parentSel = document.getElementById('zone-parent');
        const newParentIn = document.getElementById('zone-newparent');
        if (parentSel && newParentIn) {
            parentSel.addEventListener('change', function () {
                const creating = parentSel.value === '0';
                newParentIn.style.display = creating ? '' : 'none';
                newParentIn.required = creating;
                if (!creating) newParentIn.value = '';
                else newParentIn.focus();
            });
        }

        document.getElementById('zone-clear').addEventListener('click', function () {
            if (box) { box.remove(); box = null; }
            fx.value = fy.value = fw.value = fh.value = '';
            saveBtn.disabled = true;
            readout.textContent = 'Drag a box on the map first.';
            if (parentSel && newParentIn) {
                parentSel.selectedIndex = 0;
                newParentIn.style.display = 'none';
                newParentIn.required = false;
                newParentIn.value = '';
            }
        });
    })();
</script>
