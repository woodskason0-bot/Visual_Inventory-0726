@model List<Visual_Inventory_System.Models.ViewModels.DeliveryViewModel>
@inject Visual_Inventory_System.Services.CurrentUserService CurrentUser
@{
    ViewData["Title"] = "Deliveries";
    var deliveries = Model ?? new List<Visual_Inventory_System.Models.ViewModels.DeliveryViewModel>();
    string me = CurrentUser.Name;

    string Person(string? p) => string.IsNullOrEmpty(p) ? "—" : p.Replace('.', ' ');
    string Ago(DateTime utc)
    {
        var a = DateTime.UtcNow - utc;
        return a.TotalMinutes < 1 ? "just now"
            : a.TotalHours < 1 ? $"{(int)a.TotalMinutes}m ago"
            : a.TotalDays < 1 ? $"{(int)a.TotalHours}h ago"
            : $"{(int)a.TotalDays}d ago";
    }
}

<style>
    .delivery-board-wrap { max-width: 1200px; margin: 1.5rem auto; }
    .text-dim { color: #94A3B8 !important; }
    .board { display: flex; flex-wrap: wrap; gap: 1rem; }
    .delivery-card {
        flex: 0 1 280px;
        background-color: var(--vis-card);
        border: 1px solid var(--vis-card-border);
        border-left: 4px solid #F59E0B;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }
    .delivery-card.claimed { border-left-color: #64748B; opacity: 0.92; }
    .delivery-card .thumb { width: 100%; height: 160px; object-fit: cover; display: block; background: #14151A; }
    /* The thumb is a 160px CENTRE CROP -- a tracking number or label near an edge
       is simply not on screen, and the stored file is a full 1600px JPEG. A button
       (not an <img onclick>) so it's tab-reachable and announced as activatable. */
    .delivery-card .thumb-btn { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; position: relative; }
    .delivery-card .thumb-btn:focus-visible { outline: 2px solid var(--vis-red); outline-offset: -2px; }
    .delivery-card .zoom-hint {
        position: absolute; right: 0.5rem; bottom: 0.5rem;
        background: rgba(0,0,0,0.62); color: #fff; border-radius: 4px;
        padding: 0.15rem 0.4rem; font-size: 11px; line-height: 1.4;
        opacity: 0; transition: opacity 0.15s ease;
    }
    .delivery-card .thumb-btn:hover .zoom-hint,
    .delivery-card .thumb-btn:focus-visible .zoom-hint { opacity: 1; }
    /* Only the PHOTO's own ground is forced dark -- object-fit:contain letterboxes
       a 4:3 snap inside the box, and a neutral surround is what makes it readable.
       The modal chrome is deliberately left to theme normally: forcing .modal-content
       dark put the light-theme .modal-title color (#1A1D23) on a #0E0F13 panel at
       ~1.1:1, the same dark-on-dark trap 2d.1 had to add .comp-row/.filter-bar-dark
       exclusions for. Cheaper to not leave the theme system than to override it. */
    #deliveryPhotoModal .photo-full { width: 100%; max-height: 80vh; object-fit: contain; display: block; background: #0E0F13; }
    .delivery-card .body { padding: 0.9rem 1rem; }
    .delivery-card h6 { color: var(--vis-text); font-weight: 700; margin-bottom: 0.35rem; }
    .delivery-card .field { color: var(--vis-text-muted); font-size: 12px; }
    .delivery-card .meta { color: var(--vis-text-muted); font-size: 10px; margin-top: 0.5rem; }
</style>

<div class="delivery-board-wrap px-3">
    <h2 class="fw-bold mb-1"><i class="bi bi-box-seam-fill me-2" style="color: var(--vis-red);"></i>Deliveries</h2>
    <div class="text-dim mb-3">Unknown Delivery (everyone sees these) plus anything sent straight to you.</div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success py-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["Error"]</div>
    }

    @if (!deliveries.Any())
    {
        <div class="delivery-card p-4 text-center text-dim" style="flex-basis: 100%; border-left: none;">Nothing waiting.</div>
    }
    else
    {
        <div class="board">
            @foreach (var d in deliveries)
            {
                var claimed = d.Status == "Claimed";
                var mine = claimed && string.Equals(d.ClaimedBy, me, StringComparison.OrdinalIgnoreCase);
                <div class="delivery-card @(claimed ? "claimed" : "")">
                    <button type="button" class="thumb-btn" data-photo="@d.PhotoUrl" data-label="@d.RecipientLabel"
                            title="View the full photo">
                        <img src="@d.PhotoUrl" class="thumb" alt="Delivery photo for @d.RecipientLabel" />
                        <span class="zoom-hint"><i class="bi bi-arrows-fullscreen me-1"></i>Expand</span>
                    </button>
                    <div class="body">
                        <h6>@d.RecipientLabel</h6>
                        @if (!string.IsNullOrWhiteSpace(d.BrandOfItem) && d.BrandOfItem != "N/A")
                        {
                            <div class="field"><i class="bi bi-tag me-1"></i>Item: @d.BrandOfItem</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(d.BrandOfShipping) && d.BrandOfShipping != "N/A")
                        {
                            <div class="field"><i class="bi bi-truck me-1"></i>Ship: @d.BrandOfShipping</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(d.TrackingNumber) && d.TrackingNumber != "N/A")
                        {
                            <div class="field"><i class="bi bi-upc-scan me-1"></i>Tracking: @d.TrackingNumber</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(d.OrderNumber) && d.OrderNumber != "N/A")
                        {
                            <div class="field"><i class="bi bi-receipt me-1"></i>Order #: @d.OrderNumber</div>
                        }
                        <div class="meta"><i class="bi bi-person me-1"></i>Logged by @Person(d.LoggedBy) &middot; @Ago(d.LoggedAt)</div>

                        <div class="mt-2">
                            @if (!claimed)
                            {
                                <form asp-controller="Home" asp-action="ClaimDelivery" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold w-100"><i class="bi bi-hand-index me-1"></i>Claim</button>
                                </form>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge" style="background:#64748B;"><i class="bi bi-person-check me-1"></i>Claimed by @Person(d.ClaimedBy)</span>
                                    @if (mine)
                                    {
                                        <form asp-controller="Home" asp-action="CompleteDelivery" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold"><i class="bi bi-check2 me-1"></i>Done</button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <p class="mt-4"><a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-secondary">&larr; Back to Dashboard</a></p>
</div>

<!-- ONE shared modal for the whole board, not one per card: the src is swapped in
     on click, so a board of 30 deliveries still renders exactly one of these. -->
<div class="modal fade" id="deliveryPhotoModal" tabindex="-1" aria-hidden="true" aria-labelledby="deliveryPhotoLabel">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-bold" id="deliveryPhotoLabel">Delivery photo</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <img src="" alt="" class="photo-full" id="deliveryPhotoFull" />
            </div>
            <div class="modal-footer py-2">
                @* The saved file is a 1600px JPEG. Handing it to a real browser tab is
                   what actually lets someone pinch/zoom into a tracking number -- no
                   in-page zoom widget can beat the browser's own. *@
                <a href="#" target="_blank" rel="noopener" class="btn btn-sm btn-outline-info fw-bold" id="deliveryPhotoOpen">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Open full size in new tab
                </a>
                <button type="button" class="btn btn-sm btn-secondary fw-bold" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Delegated off document, and every value read from data-* attributes rather
    // than interpolated into JS: a recipient label is a real person's name and an
    // apostrophe in an inline onclick would take the whole handler out.
    (function bindDeliveryPhotoExpand() {
        var modalEl = document.getElementById('deliveryPhotoModal');
        if (!modalEl) return;
        var img = document.getElementById('deliveryPhotoFull');
        var cap = document.getElementById('deliveryPhotoLabel');
        var openLink = document.getElementById('deliveryPhotoOpen');

        document.addEventListener('click', function (e) {
            var btn = e.target.closest ? e.target.closest('.thumb-btn') : null;
            if (!btn) return;
            var url = btn.getAttribute('data-photo') || '';
            var label = btn.getAttribute('data-label') || 'Delivery photo';
            if (!url) return;
            img.setAttribute('src', url);
            img.setAttribute('alt', 'Delivery photo for ' + label);
            cap.textContent = label;
            openLink.setAttribute('href', url);
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });

        // The src is deliberately NOT cleared on close. Clearing it on
        // hidden.bs.modal raced the next open -- close-then-reopen let the
        // teardown's removeAttribute land AFTER the new src was assigned, so the
        // modal came up permanently blank. Setting src before show() already
        // means the right photo is assigned before anything is visible, which is
        // what the clear was reaching for anyway.
    })();
</script>
