@{
    ViewData["Title"] = "Bulk Intake";
    var teams = (List<Visual_Inventory_System.Models.Team>)(ViewBag.ActiveTeams ?? new List<Visual_Inventory_System.Models.Team>());
    var parents = (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string, string)>());
    var knownTypes = (List<string>)(ViewBag.KnownTypes ?? new List<string>());
    var myPending = (List<Visual_Inventory_System.Models.IntakeBatch>)(ViewBag.MyPending ?? new List<Visual_Inventory_System.Models.IntakeBatch>());
    var preview = TempData["IntakePreview"] as string;
}

<style>
    .intake-card { background: var(--vis-card); border: 1px solid var(--vis-card-border); border-radius: 10px; }
    .intake-card table { color: var(--vis-text); }
    .intake-card input, .intake-card select { background: var(--vis-card-border); color: var(--vis-text); border: 1px solid #3D4351; }
</style>

<div class="container-fluid py-4">
    <h2 class="fw-bold text-white mb-1">Bulk Intake</h2>
    <p class="text-light-gray small mb-4">
        Enter a list of stock for <strong>one place</strong>. Models you already have will
        match as you type &mdash; that adds stock to the existing item rather than creating
        a second one. If your location isn&rsquo;t listed, pick <em>Not listed</em> and the
        batch is held for approval; nothing you typed is lost.
    </p>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div> }

    @if (!string.IsNullOrEmpty(preview))
    {
        <div class="intake-card p-3 mb-4" id="preview-box">
            <h6 class="text-white fw-bold">Preview &mdash; nothing has been written</h6>
            <pre class="text-light-gray small mb-0" style="white-space:pre-wrap;">@preview</pre>
        </div>
    }

    @if (myPending.Any())
    {
        <div class="intake-card p-3 mb-4">
            <h6 class="text-white fw-bold mb-2">Your batches waiting on a location</h6>
            @foreach (var b in myPending)
            {
                <div class="text-light-gray small">
                    <strong>#@b.Id</strong> &mdash; @b.Rows.Count row(s), asked for
                    &ldquo;<span class="text-warning">@b.RequestedLocation</span>&rdquo;,
                    sent @b.SubmittedAt.ToLocalTime().ToString("MMM d h:mm tt")
                </div>
            }
        </div>
    }

    <form asp-controller="Home" asp-action="SubmitIntake" method="post" class="intake-card p-3">
        @Html.AntiForgeryToken()

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Branch</label>
                <select id="in-branch" class="form-select"><option value="">-- Branch --</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Line <span class="text-danger">*</span></label>
                <select name="line" id="in-line" class="form-select" required><option value="">-- Select a Line --</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Team / Project</label>
                <select name="team" id="in-team" class="form-select">
                    <option value="">N/A &mdash; no team</option>
                    @foreach (var t in teams) { <option value="@t.Name">@t.Name</option> }
                </select>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Parent</label>
                <select name="parentCode" id="in-parent" class="form-select">
                    <option value="">-- Where --</option>
                    @foreach (var p in parents) { <option value="@p.Code">@p.Name</option> }
                    <option value="__NEW__">Not listed&hellip;</option>
                </select>
            </div>
            <div class="col-md-2"><label class="form-label small fw-bold text-light-gray">Major</label>
                <select name="majorCode" id="in-major" class="form-select"><option value="">&mdash;</option></select></div>
            <div class="col-md-2"><label class="form-label small fw-bold text-light-gray">Sub</label>
                <select name="subCode" id="in-sub" class="form-select"><option value="">&mdash;</option></select></div>
            <div class="col-md-2"><label class="form-label small fw-bold text-light-gray">Rack</label>
                <input type="text" name="rack" class="form-control" /></div>
            <div class="col-md-2"><label class="form-label small fw-bold text-light-gray">Row</label>
                <input type="text" name="row" class="form-control" /></div>
        </div>

        <div class="mb-3" id="req-loc-row" style="display:none;">
            <label class="form-label small fw-bold text-warning">What do you call this place?</label>
            <input type="text" name="requestedLocation" id="in-reqloc" class="form-control" style="max-width:340px;"
                   placeholder="e.g. North Bay" />
            <div class="text-light-gray small mt-1">
                Held for approval. It may already exist under another name &mdash; that gets sorted on approval.
            </div>
        </div>

        <table class="table table-sm align-middle">
            <thead><tr>
                <th style="width:24%;">Model</th><th style="width:13%;">Type</th><th style="width:14%;">Brand</th>
                <th style="width:14%;">Rheem PN</th><th style="width:7%;">Qty</th>
                <th style="width:20%;">Serial(s) / TC <span class="text-light-gray">(by type, optional)</span></th><th></th>
            </tr></thead>
            <tbody id="intake-rows"></tbody>
        </table>

        <datalist id="known-items"></datalist>
        <datalist id="known-types">@foreach (var t in knownTypes) { <option value="@t"></option> }</datalist>

        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary" id="add-row">+ Add row</button>
            <button type="submit" name="preview" value="true" class="btn btn-outline-info fw-bold">Preview</button>
            <button type="submit" class="btn btn-success fw-bold">Import</button>
        </div>
    </form>
</div>

<script>
    const orgStructure = @Html.Raw(ViewBag.OrgStructureJson ?? "{}");
    const locTree      = @Html.Raw(ViewBag.LocationTreeJson ?? "{}");
    const knownItems   = @Html.Raw(ViewBag.KnownItemsJson ?? "[]");
    // Team -> home Line (metadata, suggestion only -- same map Registration
    // already uses) and the signed-in user's own assignment, for autofilling
    // Branch/Line on page load and on Team change.
    const teamLines    = @Html.Raw(ViewBag.TeamLinesJson ?? "{}");
    const myLine       = @Html.Raw(ViewBag.MyLineJson ?? "\"\"");
    const myBranch     = @Html.Raw(ViewBag.MyBranchJson ?? "\"\"");

    // Same 1/3/5/last rule as Services/LocationCodec.Encode(). Duplicated from
    // Index.cshtml -- see the note there for why it isn't in site.js.
    function encodeLoc(name) {
        if (!name) return "";
        const clean = String(name).toUpperCase().replace(/[^A-Z0-9]/g, "");
        if (!clean.length) return "";
        const n = clean.length;
        const pos = [...new Set([1, 3, 5, n].filter(p => p >= 1 && p <= n))].sort((a, b) => a - b);
        return pos.map(p => clean[p - 1]).join("");
    }

    // Branch -> Line cascade, plus autofill: seeded from the signed-in user on
    // page load, and overwritten whenever a Team with a home Line is picked
    // (a deliberate act, so it wins over whatever was there -- still editable
    // after). Neither ever touches server-side validation; Line stays
    // required and checked exactly as before on submit.
    (function () {
        const bSel = document.getElementById('in-branch'), lSel = document.getElementById('in-line');
        const tSel = document.getElementById('in-team');

        Object.keys(orgStructure).forEach(function (b) {
            bSel.appendChild(Object.assign(document.createElement('option'), { value: b, textContent: b }));
        });

        function fillLines(branch, selected) {
            lSel.innerHTML = '<option value="">-- Select a Line --</option>';
            (orgStructure[branch] || []).forEach(function (l) {
                const opt = Object.assign(document.createElement('option'), { value: l, textContent: l });
                if (selected && l === selected) opt.selected = true;
                lSel.appendChild(opt);
            });
        }

        function branchForLine(line) {
            for (const b in orgStructure) {
                if ((orgStructure[b] || []).includes(line)) return b;
            }
            return null;
        }

        bSel.addEventListener('change', function () { fillLines(bSel.value, null); });

        // Team change: a team with a recognized home Line overwrites Branch/Line
        // to match. A team with no home Line (or clearing back to N/A) touches
        // nothing -- there's no suggestion to make.
        tSel.addEventListener('change', function () {
            const line = teamLines[tSel.value];
            if (!line) return;
            const branch = branchForLine(line);
            if (!branch) return;
            bSel.value = branch;
            fillLines(branch, line);
        });

        // Page-load seed from the signed-in user's own assignment: a specific
        // Line wins (Branch derived from it); else a whole-Branch assignment
        // (Branch preset, Line left for them to pick); else neither.
        if (myLine) {
            const branch = branchForLine(myLine);
            if (branch) { bSel.value = branch; fillLines(branch, myLine); }
        } else if (myBranch) {
            bSel.value = myBranch;
            fillLines(myBranch, null);
        }
    })();

    // Parent -> Major -> Sub, driven by the same table the rest of the app uses.
    (function () {
        const p = document.getElementById('in-parent'), m = document.getElementById('in-major'),
              s = document.getElementById('in-sub'), req = document.getElementById('req-loc-row'),
              reqIn = document.getElementById('in-reqloc');
        const nameFor = {};
        Object.keys(locTree).forEach(function (n) { nameFor[encodeLoc(n)] = n; });

        function fill(sel, names) {
            sel.innerHTML = '<option value="">—</option>';
            names.forEach(function (n) {
                sel.appendChild(Object.assign(document.createElement('option'),
                    { value: encodeLoc(n), textContent: n }));
            });
        }
        p.addEventListener('change', function () {
            const isNew = p.value === '__NEW__';
            req.style.display = isNew ? '' : 'none';
            reqIn.required = isNew;
            if (isNew) { reqIn.focus(); fill(m, []); fill(s, []); return; }
            reqIn.value = '';
            const pName = nameFor[p.value];
            fill(m, pName ? Object.keys(locTree[pName] || {}) : []);
            fill(s, []);
        });
        m.addEventListener('change', function () {
            const pName = nameFor[p.value];
            const majors = pName ? (locTree[pName] || {}) : {};
            const mName = Object.keys(majors).find(function (k) { return encodeLoc(k) === m.value; });
            fill(s, mName ? (majors[mName] || []) : []);
        });
    })();

    // Model autocomplete: suggest what already exists, and prefill the rest of the
    // row from it so adding stock to a known item doesn't mean retyping its brand.
    (function () {
        const dl = document.getElementById('known-items');
        knownItems.forEach(function (i) {
            dl.appendChild(Object.assign(document.createElement('option'), { value: i.name }));
        });
        const byName = {};
        knownItems.forEach(function (i) { byName[i.name.toLowerCase()] = i; });

        const body = document.getElementById('intake-rows');

        // Keep in lockstep with InventoryService.IsCompressorType/IsMotorType --
        // same exact-match / suffix rules the server enforces.
        function isCompressorTypeLocal(t) { return !!t && String(t).trim().toLowerCase() === 'compressor'; }
        function isMotorTypeLocal(t) { return !!t && String(t).trim().toLowerCase().endsWith('motor'); }

        // Rebuild a row's Serial(s)/TC cell based on its current Type. Neither
        // is required -- this only surfaces the opportunity. Every row keeps
        // EXACTLY ONE name="serial" input at all times, compressor or not --
        // the server binds serial[] positionally against itemName[], so a row
        // that skips rendering one would desync every row after it. Non-
        // compressor rows get it hidden and empty instead of removed. Extra
        // slots and the TC box get a per-row index stamped on just before
        // submit, once row order is final.
        function syncUnitCapture(tr) {
            const type = tr.querySelector('[name=type]').value;
            const qty = Math.max(1, parseInt(tr.querySelector('[name=qty]').value, 10) || 1);
            const cell = tr.querySelector('.unit-capture');
            cell.innerHTML = '';

            const first = document.createElement('input');
            first.name = 'serial'; first.className = 'form-control form-control-sm mb-1';

            if (isCompressorTypeLocal(type)) {
                first.placeholder = 'Unit 1 serial';
                cell.appendChild(first);
                for (let i = 1; i < qty; i++) {
                    const extra = document.createElement('input');
                    extra.className = 'form-control form-control-sm mb-1 intake-extra-serial';
                    extra.setAttribute('data-slot', String(i));
                    extra.placeholder = 'Unit ' + (i + 1) + ' serial';
                    cell.appendChild(extra);
                }
            } else if (isMotorTypeLocal(type)) {
                const wrap = document.createElement('div');
                wrap.className = 'form-check';
                wrap.innerHTML = '<input class="form-check-input tc-check" type="checkbox" id="tc-' + Math.random().toString(36).slice(2) + '">' +
                    '<label class="form-check-label small">Any TC?</label>';
                const qtyIn = document.createElement('input');
                qtyIn.type = 'number'; qtyIn.min = '0'; qtyIn.value = '0'; qtyIn.disabled = true;
                qtyIn.className = 'form-control form-control-sm mt-1 intake-tc-qty';
                qtyIn.style.display = 'none'; qtyIn.placeholder = 'How many?';
                const check = wrap.querySelector('.tc-check');
                check.addEventListener('change', function () {
                    qtyIn.disabled = !check.checked;
                    qtyIn.style.display = check.checked ? '' : 'none';
                    if (!check.checked) qtyIn.value = '0';
                });
                qtyIn.addEventListener('input', function () {
                    const cap = Math.max(0, parseInt(tr.querySelector('[name=qty]').value, 10) || 0);
                    if (parseInt(qtyIn.value, 10) > cap) qtyIn.value = String(cap);
                });
                first.type = 'hidden';
                cell.appendChild(first);
                cell.appendChild(wrap);
                cell.appendChild(qtyIn);
            } else {
                first.type = 'hidden';
                cell.appendChild(first);
            }
        }

        function addRow() {
            const tr = document.createElement('tr');
            tr.innerHTML =
                '<td><input name="itemName" list="known-items" class="form-control form-control-sm" autocomplete="off" /></td>' +
                '<td><input name="type" list="known-types" class="form-control form-control-sm" /></td>' +
                '<td><input name="brand" class="form-control form-control-sm" /></td>' +
                '<td><input name="rpn" value="N/A" class="form-control form-control-sm" /></td>' +
                '<td><input name="qty" type="number" min="1" value="1" class="form-control form-control-sm" /></td>' +
                '<td class="unit-capture"></td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger">&times;</button></td>';
            tr.querySelector('button').onclick = function () { tr.remove(); };
            const nameIn = tr.querySelector('[name=itemName]');
            nameIn.addEventListener('change', function () {
                const hit = byName[nameIn.value.trim().toLowerCase()];
                if (!hit) return;
                tr.querySelector('[name=type]').value  = hit.type  || '';
                tr.querySelector('[name=brand]').value = hit.brand || '';
                tr.querySelector('[name=rpn]').value   = hit.rpn   || 'N/A';
                syncUnitCapture(tr);
            });
            tr.querySelector('[name=type]').addEventListener('input', function () { syncUnitCapture(tr); });
            tr.querySelector('[name=qty]').addEventListener('input', function () { syncUnitCapture(tr); });
            body.appendChild(tr);
            syncUnitCapture(tr);
        }
        document.getElementById('add-row').addEventListener('click', addRow);
        for (let i = 0; i < 5; i++) addRow();

        // Extra serial slots and TC-qty boxes have no name until now -- row
        // order can change (rows added/removed) right up to submit, so the
        // index has to be computed from final DOM order, not creation order,
        // matching how itemName[]/type[]/etc. already bind by document order.
        const form = document.querySelector('form[action*="SubmitIntake"]');
        if (form) form.addEventListener('submit', function () {
            Array.from(body.children).forEach(function (tr, rowIdx) {
                tr.querySelectorAll('.intake-extra-serial').forEach(function (el) {
                    el.name = 'extraSerial_' + rowIdx + '_' + el.getAttribute('data-slot');
                });
                const tcQtyEl = tr.querySelector('.intake-tc-qty');
                if (tcQtyEl) tcQtyEl.name = 'thermocoupledQty_' + rowIdx;
            });
        });
    })();
</script>
