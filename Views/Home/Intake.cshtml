@{
    ViewData["Title"] = "Bulk Intake";
    var teams = (List<Visual_Inventory_System.Models.Team>)(ViewBag.ActiveTeams ?? new List<Visual_Inventory_System.Models.Team>());
    var parents = (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string, string)>());
    var knownTypes = (List<string>)(ViewBag.KnownTypes ?? new List<string>());
    var myPending = (List<Visual_Inventory_System.Models.IntakeBatch>)(ViewBag.MyPending ?? new List<Visual_Inventory_System.Models.IntakeBatch>());
    var preview = TempData["IntakePreview"] as string;
}

<style>
    .intake-card { background: var(--vis-card); border: 1px solid var(--vis-card-border); border-radius: 10px; }
    .intake-card table { color: var(--vis-text); }
    .intake-card input, .intake-card select { background: var(--vis-card-border); color: var(--vis-text); border: 1px solid #3D4351; }
</style>

<div class="container-fluid py-4">
    <h2 class="fw-bold text-white mb-1">Bulk Intake</h2>
    <p class="text-light-gray small mb-4">
        Enter a list of stock for <strong>one place</strong>. Models you already have will
        match as you type &mdash; that row moves down to <strong>Already registered</strong>
        instead of importing, so its stock change goes through a quick review instead of
        silently landing. If your location isn&rsquo;t listed, pick <em>Not listed</em> and the
        batch is held for approval; nothing you typed is lost.
    </p>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div> }

    @if (!string.IsNullOrEmpty(preview))
    {
        <div class="intake-card p-3 mb-4" id="preview-box">
            <h6 class="text-white fw-bold">Preview &mdash; nothing has been written</h6>
            <pre class="text-light-gray small mb-0" style="white-space:pre-wrap;">@preview</pre>
        </div>
    }

    @if (myPending.Any())
    {
        <div class="intake-card p-3 mb-4">
            <h6 class="text-white fw-bold mb-2">Your batches waiting on a location</h6>
            @foreach (var b in myPending)
            {
                <div class="text-light-gray small">
                    <strong>#@b.Id</strong> &mdash; @b.Rows.Count row(s), asked for
                    &ldquo;<span class="text-warning">@b.RequestedLocation</span>&rdquo;,
                    sent @b.SubmittedAt.ToLocalTime().ToString("MMM d h:mm tt")
                </div>
            }
        </div>
    }

    <form asp-controller="Home" asp-action="SubmitIntake" method="post" class="intake-card p-3">
        @Html.AntiForgeryToken()

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Branch</label>
                <select id="in-branch" class="form-select"><option value="">-- Branch --</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Line <span class="text-danger">*</span></label>
                <select name="line" id="in-line" class="form-select" required><option value="">-- Select a Line --</option></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Team / Project</label>
                <select name="team" id="in-team" class="form-select">
                    <option value="">N/A &mdash; no team</option>
                    @foreach (var t in teams) { <option value="@t.Name">@t.Name</option> }
                </select>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-light-gray">Parent</label>
                <select name="parentCode" id="in-parent" class="form-select">
                    <option value="">-- Where --</option>
                    @foreach (var p in parents) { <option value="@p.Code">@p.Name</option> }
                    <option value="__NEW__">Not listed&hellip;</option>
                </select>
            </div>
            <div class="col-md-2"><label class="form-label small fw-bold text-light-gray">Major</label>
                <select name="majorCode" id="in-major" class="form-select"><option value="">&mdash;</option></select></div>
            <div class="col-md-2"><label class="form-label small fw-bold text-light-gray">Sub</label>
                <select name="subCode" id="in-sub" class="form-select"><option value="">&mdash;</option></select></div>
            <div class="col-md-2 position-relative"><label class="form-label small fw-bold text-light-gray">Rack</label>
                <input type="text" name="rack" id="in-rack" class="form-control" autocomplete="off" />
                <div id="in-rack-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div></div>
            <div class="col-md-2 position-relative"><label class="form-label small fw-bold text-light-gray">Row</label>
                <input type="text" name="row" id="in-row" class="form-control" autocomplete="off" />
                <div id="in-row-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div></div>
        </div>

        <div class="mb-3" id="req-loc-row" style="display:none;">
            <label class="form-label small fw-bold text-warning">What do you call this place?</label>
            <input type="text" name="requestedLocation" id="in-reqloc" class="form-control" style="max-width:340px;"
                   placeholder="e.g. North Bay" />
            <div class="text-light-gray small mt-1">
                Held for approval. It may already exist under another name &mdash; that gets sorted on approval.
            </div>
        </div>

        <table class="table table-sm align-middle">
            <thead><tr>
                <th style="width:24%;">Model</th><th style="width:13%;">Type</th><th style="width:14%;">Brand</th>
                <th style="width:14%;">Rheem PN</th><th style="width:7%;">Qty</th>
                <th style="width:20%;">Serial(s) / TC <span class="text-light-gray">(by type, optional)</span></th><th></th>
            </tr></thead>
            <tbody id="intake-rows"></tbody>
        </table>

        <datalist id="known-items"></datalist>

        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary" id="add-row">+ Add row</button>
            <button type="submit" name="preview" value="true" class="btn btn-outline-info fw-bold">Preview</button>
            <button type="submit" class="btn btn-success fw-bold">Import</button>
        </div>
    </form>

    @* Pass 21/22: a row whose typed name exact-matches an existing item is
       pulled out of the grid above and lands here instead, as its own live
       Modify Stock section -- not a separate summary list behind a button.
       A second row for the SAME item grows that section (bumps quantity,
       extends serial/TC inputs) rather than opening a second one, so
       whatever's already been typed into it survives. Excluded from Import;
       applied through Apply All below via a separate form/endpoint (a form
       can't nest inside the Import form above). *@
    <div id="already-registered-wrap" class="intake-card p-3 mt-3" style="display:none;">
        <h6 class="text-white fw-bold mb-1">Already registered</h6>
        <p class="text-light-gray small mb-2">
            These match existing items by name, so they&rsquo;re excluded from Import above.
            Review/adjust each one below, then Apply All.
        </p>
        <form asp-controller="Home" asp-action="SubmitIntakeStockUpdates" method="post" id="stock-review-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="parentCode" id="sr-parentCode" />
            <input type="hidden" name="majorCode" id="sr-majorCode" />
            <input type="hidden" name="subCode" id="sr-subCode" />
            <input type="hidden" name="rack" id="sr-rack" />
            <input type="hidden" name="row" id="sr-row" />
            <div id="stock-review-sections" style="max-height: 480px; overflow-y: auto;"></div>
            <button type="submit" class="btn btn-success fw-bold mt-2" id="stock-review-apply" disabled>Apply All</button>
        </form>
    </div>
</div>

<script>
    const orgStructure = @Html.Raw(ViewBag.OrgStructureJson ?? "{}");
    const locTree      = @Html.Raw(ViewBag.LocationTreeJson ?? "{}");
    const knownItems   = @Html.Raw(ViewBag.KnownItemsJson ?? "[]");
    // Team -> home Line (metadata, suggestion only -- same map Registration
    // already uses) and the signed-in user's own assignment, for autofilling
    // Branch/Line on page load and on Team change.
    const teamLines    = @Html.Raw(ViewBag.TeamLinesJson ?? "{}");
    const myLine       = @Html.Raw(ViewBag.MyLineJson ?? "\"\"");
    const myBranch     = @Html.Raw(ViewBag.MyBranchJson ?? "\"\"");
    // Rack/Row suggestions (Pass 23), keyed "ParentCode|MajorCode|SubCode" --
    // data-derived from real stock, not a managed vocabulary. Never a gate;
    // typing a brand new value always works.
    const rackRowMap   = @Html.Raw(ViewBag.RackRowJson ?? "{}");
    function racksRowsFor(pCode, mCode, sCode) {
        const key = (pCode || '') + '|' + (mCode || '') + '|' + (sCode || '');
        return rackRowMap[key] || { racks: [], rows: [] };
    }

    // Same 1/3/5/last rule as Services/LocationCodec.Encode(). Duplicated from
    // Index.cshtml -- see the note there for why it isn't in site.js.
    function encodeLoc(name) {
        if (!name) return "";
        const clean = String(name).toUpperCase().replace(/[^A-Z0-9]/g, "");
        if (!clean.length) return "";
        const n = clean.length;
        const pos = [...new Set([1, 3, 5, n].filter(p => p >= 1 && p <= n))].sort((a, b) => a - b);
        return pos.map(p => clean[p - 1]).join("");
    }

    // Branch -> Line cascade, plus autofill: seeded from the signed-in user on
    // page load, and overwritten whenever a Team with a home Line is picked
    // (a deliberate act, so it wins over whatever was there -- still editable
    // after). Neither ever touches server-side validation; Line stays
    // required and checked exactly as before on submit.
    (function () {
        const bSel = document.getElementById('in-branch'), lSel = document.getElementById('in-line');
        const tSel = document.getElementById('in-team');

        Object.keys(orgStructure).forEach(function (b) {
            bSel.appendChild(Object.assign(document.createElement('option'), { value: b, textContent: b }));
        });

        function fillLines(branch, selected) {
            lSel.innerHTML = '<option value="">-- Select a Line --</option>';
            (orgStructure[branch] || []).forEach(function (l) {
                const opt = Object.assign(document.createElement('option'), { value: l, textContent: l });
                if (selected && l === selected) opt.selected = true;
                lSel.appendChild(opt);
            });
        }

        function branchForLine(line) {
            for (const b in orgStructure) {
                if ((orgStructure[b] || []).includes(line)) return b;
            }
            return null;
        }

        bSel.addEventListener('change', function () { fillLines(bSel.value, null); });

        // Team change: a team with a recognized home Line overwrites Branch/Line
        // to match. A team with no home Line (or clearing back to N/A) touches
        // nothing -- there's no suggestion to make.
        tSel.addEventListener('change', function () {
            const line = teamLines[tSel.value];
            if (!line) return;
            const branch = branchForLine(line);
            if (!branch) return;
            bSel.value = branch;
            fillLines(branch, line);
        });

        // Page-load seed from the signed-in user's own assignment: a specific
        // Line wins (Branch derived from it); else a whole-Branch assignment
        // (Branch preset, Line left for them to pick); else neither.
        if (myLine) {
            const branch = branchForLine(myLine);
            if (branch) { bSel.value = branch; fillLines(branch, myLine); }
        } else if (myBranch) {
            bSel.value = myBranch;
            fillLines(myBranch, null);
        }
    })();

    // Parent -> Major -> Sub, driven by the same table the rest of the app uses.
    (function () {
        const p = document.getElementById('in-parent'), m = document.getElementById('in-major'),
              s = document.getElementById('in-sub'), req = document.getElementById('req-loc-row'),
              reqIn = document.getElementById('in-reqloc');
        const nameFor = {};
        Object.keys(locTree).forEach(function (n) { nameFor[encodeLoc(n)] = n; });

        function fill(sel, names) {
            sel.innerHTML = '<option value="">—</option>';
            names.forEach(function (n) {
                sel.appendChild(Object.assign(document.createElement('option'),
                    { value: encodeLoc(n), textContent: n }));
            });
        }
        p.addEventListener('change', function () {
            const isNew = p.value === '__NEW__';
            req.style.display = isNew ? '' : 'none';
            reqIn.required = isNew;
            if (isNew) { reqIn.focus(); fill(m, []); fill(s, []); return; }
            reqIn.value = '';
            const pName = nameFor[p.value];
            fill(m, pName ? Object.keys(locTree[pName] || {}) : []);
            fill(s, []);
        });
        m.addEventListener('change', function () {
            const pName = nameFor[p.value];
            const majors = pName ? (locTree[pName] || {}) : {};
            const mName = Object.keys(majors).find(function (k) { return encodeLoc(k) === m.value; });
            fill(s, mName ? (majors[mName] || []) : []);
        });

        // Rack/Row suggestions -- p/m/s values are already codes here (unlike
        // Registry/Export's name-valued selects), so no encodeLoc() needed.
        const rackIn = document.getElementById('in-rack'), rowIn = document.getElementById('in-row');
        if (typeof bindValueAutocomplete === 'function') {
            bindValueAutocomplete(rackIn, document.getElementById('in-rack-list'), function () {
                return racksRowsFor(p.value, m.value, s.value).racks;
            });
            bindValueAutocomplete(rowIn, document.getElementById('in-row-list'), function () {
                return racksRowsFor(p.value, m.value, s.value).rows;
            });
        }
    })();

    // Generic single-value autocomplete (Type fields): a plain list of
    // strings, no id/qty metadata like the model matches below carry. Same
    // visual pattern as bindAutocomplete's list-group panel (Registry/Modify
    // Stock search), so every dropdown in the app looks the same. Picking a
    // suggestion sets the input's value and fires a real 'input' event so
    // whatever's already listening (unit-capture rebuild, etc.) still runs --
    // suppressed once so that synthetic event doesn't reopen this same list.
    // valuesOrGetter: a plain array (static, e.g. known Types) OR a function
    // returning the current array (dynamic, e.g. Rack/Row suggestions that
    // depend on whatever Parent/Major/Sub is picked right now) -- evaluated
    // fresh on every keystroke either way, so a dynamic source never goes stale.
    function bindValueAutocomplete(inputEl, listEl, valuesOrGetter) {
        let suppress = false;
        inputEl.addEventListener('input', function () {
            if (suppress) { suppress = false; return; }
            const val = inputEl.value.trim().toLowerCase();
            listEl.innerHTML = '';
            if (!val) { listEl.style.display = 'none'; return; }
            const values = (typeof valuesOrGetter === 'function') ? (valuesOrGetter() || []) : valuesOrGetter;
            const matches = values.filter(function (v) { return v.toLowerCase().includes(val); }).slice(0, 10);
            if (matches.length === 0) { listEl.style.display = 'none'; return; }
            listEl.style.display = 'block';
            matches.forEach(function (v) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'list-group-item list-group-item-action py-2 px-3 small border-bottom border-dark text-white';
                btn.style.backgroundColor = '#1C1E24';
                btn.textContent = v;
                btn.onmouseover = function () { btn.style.backgroundColor = '#2A2D35'; };
                btn.onmouseout = function () { btn.style.backgroundColor = '#1C1E24'; };
                btn.onclick = function () {
                    listEl.style.display = 'none';
                    suppress = true;
                    inputEl.value = v;
                    inputEl.dispatchEvent(new Event('input', { bubbles: true }));
                };
                listEl.appendChild(btn);
            });
        });
        document.addEventListener('click', function (e) {
            if (e.target !== inputEl) listEl.style.display = 'none';
        });
    }

    // Model autocomplete: suggest what already exists, and prefill the rest of the
    // row from it so adding stock to a known item doesn't mean retyping its brand.
    (function () {
        const dl = document.getElementById('known-items');
        knownItems.forEach(function (i) {
            dl.appendChild(Object.assign(document.createElement('option'), { value: i.name }));
        });
        const byName = {};
        knownItems.forEach(function (i) { byName[i.name.toLowerCase()] = i; });
        const knownTypesArr = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(knownTypes));

        const body = document.getElementById('intake-rows');

        // Keep in lockstep with InventoryService.IsCompressorType/IsMotorType --
        // same exact-match / suffix rules the server enforces.
        function isCompressorTypeLocal(t) { return !!t && String(t).trim().toLowerCase() === 'compressor'; }
        function isMotorTypeLocal(t) { return !!t && String(t).trim().toLowerCase().endsWith('motor'); }

        // Rebuild a row's Serial(s)/TC cell based on its current Type. Neither
        // is required -- this only surfaces the opportunity. Every row keeps
        // EXACTLY ONE name="serial" input at all times, compressor or not --
        // the server binds serial[] positionally against itemName[], so a row
        // that skips rendering one would desync every row after it. Non-
        // compressor rows get it hidden and empty instead of removed. Extra
        // slots and the TC box get a per-row index stamped on just before
        // submit, once row order is final.
        function syncUnitCapture(tr) {
            const type = tr.querySelector('[name=type]').value;
            const qty = Math.max(1, parseInt(tr.querySelector('[name=qty]').value, 10) || 1);
            const cell = tr.querySelector('.unit-capture');
            cell.innerHTML = '';

            const first = document.createElement('input');
            first.name = 'serial'; first.className = 'form-control form-control-sm mb-1';

            if (isCompressorTypeLocal(type)) {
                first.placeholder = 'Unit 1 serial';
                cell.appendChild(first);
                for (let i = 1; i < qty; i++) {
                    const extra = document.createElement('input');
                    extra.className = 'form-control form-control-sm mb-1 intake-extra-serial';
                    extra.setAttribute('data-slot', String(i));
                    extra.placeholder = 'Unit ' + (i + 1) + ' serial';
                    cell.appendChild(extra);
                }
            } else if (isMotorTypeLocal(type)) {
                const wrap = document.createElement('div');
                wrap.className = 'form-check';
                wrap.innerHTML = '<input class="form-check-input tc-check" type="checkbox" id="tc-' + Math.random().toString(36).slice(2) + '">' +
                    '<label class="form-check-label small">Any TC?</label>';
                const qtyIn = document.createElement('input');
                qtyIn.type = 'number'; qtyIn.min = '0'; qtyIn.value = '0'; qtyIn.disabled = true;
                qtyIn.className = 'form-control form-control-sm mt-1 intake-tc-qty';
                qtyIn.style.display = 'none'; qtyIn.placeholder = 'How many?';
                const check = wrap.querySelector('.tc-check');
                check.addEventListener('change', function () {
                    qtyIn.disabled = !check.checked;
                    qtyIn.style.display = check.checked ? '' : 'none';
                    if (!check.checked) qtyIn.value = '0';
                });
                qtyIn.addEventListener('input', function () {
                    const cap = Math.max(0, parseInt(tr.querySelector('[name=qty]').value, 10) || 0);
                    if (parseInt(qtyIn.value, 10) > cap) qtyIn.value = String(cap);
                });
                first.type = 'hidden';
                cell.appendChild(first);
                cell.appendChild(wrap);
                cell.appendChild(qtyIn);
            } else {
                first.type = 'hidden';
                cell.appendChild(first);
            }
        }

        // ---- Already registered (Pass 21/22) -----------------------------
        // A name match creates a LIVE inline Modify Stock section immediately
        // -- no separate list, no button to open a modal. A second row for
        // the SAME item grows that section in place (bumps quantity, extends
        // serial/TC inputs) instead of opening a duplicate, so anything
        // already typed into it survives. sections: itemId -> live state.
        const sections = {};

        function refreshApplyEnabled() {
            document.getElementById('stock-review-apply').disabled = Object.keys(sections).length === 0;
        }

        // Compressor serial boxes track quantity 1:1 -- grow/shrink the box
        // count to match, preserving whatever's already typed. New boxes
        // opened up by a merge (not just a manual qty edit) drain from
        // entry.pendingSerials so the newly-typed serials land in them.
        function resizeSerialBoxes(entry) {
            const qty = Math.max(0, parseInt(entry.qtyIn.value, 10) || 0);
            const extra = entry.el.querySelector('.sr-extra');
            const existing = Array.from(extra.querySelectorAll('.sr-serial'));
            for (let i = existing.length; i < qty; i++) {
                const inp = document.createElement('input');
                inp.className = 'form-control form-control-sm mb-1 sr-serial';
                inp.placeholder = 'Unit ' + (i + 1) + ' serial (optional)';
                inp.value = entry.pendingSerials.shift() || '';
                extra.appendChild(inp);
            }
            for (let i = existing.length - 1; i >= qty; i--) existing[i].remove();
        }

        function reclampTc(entry) {
            const tcIn = entry.el.querySelector('.sr-tc');
            if (!tcIn) return;
            const qty = Math.max(0, parseInt(entry.qtyIn.value, 10) || 0);
            tcIn.max = String(qty);
            if ((parseInt(tcIn.value, 10) || 0) > qty) tcIn.value = String(qty);
        }

        function createSection(hit, qty, serials, tcQty) {
            const known = byName[hit.name.toLowerCase()] || {};
            const current = (known.quantity != null) ? known.quantity : '?';
            const isComp = isCompressorTypeLocal(hit.type);
            const isMotor = isMotorTypeLocal(hit.type);

            const sec = document.createElement('div');
            sec.className = 'stock-review-section mb-3 p-3';
            sec.style.cssText = 'border:1px solid var(--vis-card-border); border-radius:8px;';
            sec.dataset.itemId = hit.id;
            sec.innerHTML =
                '<div class="d-flex justify-content-between align-items-start mb-2">' +
                  '<div><strong class="text-white">' + hit.name + '</strong> ' +
                  '<span class="text-light-gray small">(' + hit.id + ' &middot; currently ' + current + ' on hand)</span></div>' +
                  '<button type="button" class="btn btn-sm btn-outline-secondary sr-remove">&times;</button>' +
                '</div>' +
                '<div class="row g-2 mb-2">' +
                  '<div class="col-md-4"><label class="form-label small text-light-gray">Action</label>' +
                    '<select class="form-select form-select-sm sr-action"><option value="Add" selected>Add</option><option value="Adjustment">Adjustment</option></select></div>' +
                  '<div class="col-md-4"><label class="form-label small text-light-gray">Quantity</label>' +
                    '<input type="number" class="form-control form-control-sm sr-qty" min="0" value="' + qty + '" /></div>' +
                '</div>' +
                '<div class="sr-extra"></div>';
            document.getElementById('stock-review-sections').appendChild(sec);

            const entry = {
                id: hit.id, type: hit.type, isComp: isComp, isMotor: isMotor,
                el: sec, qtyIn: sec.querySelector('.sr-qty'), pendingSerials: serials.slice()
            };

            if (isComp) {
                resizeSerialBoxes(entry);
                entry.qtyIn.addEventListener('input', function () { resizeSerialBoxes(entry); });
            } else if (isMotor) {
                const wrap = document.createElement('div');
                wrap.className = 'mt-1';
                wrap.innerHTML = '<label class="form-label small text-light-gray">How many thermocoupled?</label>' +
                    '<input type="number" class="form-control form-control-sm sr-tc" min="0" max="' + qty + '" value="' + Math.min(tcQty, qty) + '" />';
                sec.querySelector('.sr-extra').appendChild(wrap);
                entry.qtyIn.addEventListener('input', function () { reclampTc(entry); });
            }

            sec.querySelector('.sr-remove').addEventListener('click', function () {
                delete sections[hit.id];
                sec.remove();
                refreshApplyEnabled();
                if (Object.keys(sections).length === 0) document.getElementById('already-registered-wrap').style.display = 'none';
            });

            return entry;
        }

        function growSection(entry, addQty, addSerials, addTc) {
            const newQty = Math.max(0, parseInt(entry.qtyIn.value, 10) || 0) + addQty;
            entry.qtyIn.value = String(newQty);
            if (entry.isComp) {
                entry.pendingSerials.push.apply(entry.pendingSerials, addSerials);
                resizeSerialBoxes(entry);
            } else if (entry.isMotor) {
                const tcIn = entry.el.querySelector('.sr-tc');
                tcIn.max = String(newQty);
                tcIn.value = String(Math.min((parseInt(tcIn.value, 10) || 0) + addTc, newQty));
            }
        }

        function moveToAlreadyRegistered(tr, hit) {
            const qty = Math.max(1, parseInt(tr.querySelector('[name=qty]').value, 10) || 1);
            const serialIn = tr.querySelector('[name=serial]');
            const serials = [serialIn ? serialIn.value : '']
                .concat(Array.from(tr.querySelectorAll('.intake-extra-serial')).map(function (el) { return el.value; }))
                .map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
            const tcQtyEl = tr.querySelector('.intake-tc-qty');
            const tcQty = tcQtyEl ? (parseInt(tcQtyEl.value, 10) || 0) : 0;

            tr.remove();
            if (sections[hit.id]) {
                growSection(sections[hit.id], qty, serials, tcQty);
            } else {
                sections[hit.id] = createSection(hit, qty, serials, tcQty);
            }
            document.getElementById('already-registered-wrap').style.display = '';
            refreshApplyEnabled();
        }

        document.getElementById('stock-review-form').addEventListener('submit', function () {
            // Fresh copy of the CURRENT main-form location, in case it changed
            // after rows were moved into "Already registered."
            document.getElementById('sr-parentCode').value = document.getElementById('in-parent').value;
            document.getElementById('sr-majorCode').value = document.getElementById('in-major').value;
            document.getElementById('sr-subCode').value = document.getElementById('in-sub').value;
            document.getElementById('sr-rack').value = document.querySelector('[name=rack]').value;
            document.getElementById('sr-row').value = document.querySelector('[name=row]').value;

            document.querySelectorAll('.stock-review-section').forEach(function (sec, idx) {
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'stockItemId_' + idx;
                idInput.value = sec.dataset.itemId;
                sec.appendChild(idInput);

                sec.querySelector('.sr-action').name = 'stockAction_' + idx;
                sec.querySelector('.sr-qty').name = 'stockQty_' + idx;
                const tcEl = sec.querySelector('.sr-tc');
                if (tcEl) tcEl.name = 'stockTc_' + idx;
                sec.querySelectorAll('.sr-serial').forEach(function (s, slot) {
                    s.name = 'stockSerial_' + idx + '_' + slot;
                });
            });
        });

        function addRow() {
            const tr = document.createElement('tr');
            tr.innerHTML =
                '<td><input name="itemName" list="known-items" class="form-control form-control-sm" autocomplete="off" /></td>' +
                '<td class="position-relative"><input name="type" class="form-control form-control-sm intake-type-input" autocomplete="off" />' +
                  '<div class="list-group position-absolute shadow intake-type-list" style="z-index:2000; display:none; max-height:180px; overflow-y:auto; width:220px;"></div></td>' +
                '<td><input name="brand" class="form-control form-control-sm" /></td>' +
                '<td><input name="rpn" value="N/A" class="form-control form-control-sm" /></td>' +
                '<td><input name="qty" type="number" min="1" value="1" class="form-control form-control-sm" /></td>' +
                '<td class="unit-capture"></td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger">&times;</button></td>';
            tr.querySelector('button').onclick = function () { tr.remove(); };
            const nameIn = tr.querySelector('[name=itemName]');
            // An EXACT name match means this already exists -- pull the whole
            // row out of Import and into its own live "Already registered"
            // section instead of just prefilling it, carrying over whatever
            // was typed (qty/serials/TC) so none of it has to be retyped.
            nameIn.addEventListener('change', function () {
                const hit = byName[nameIn.value.trim().toLowerCase()];
                if (!hit) return;
                moveToAlreadyRegistered(tr, hit);
            });
            bindValueAutocomplete(tr.querySelector('.intake-type-input'), tr.querySelector('.intake-type-list'), knownTypesArr);
            tr.querySelector('[name=type]').addEventListener('input', function () { syncUnitCapture(tr); });
            tr.querySelector('[name=qty]').addEventListener('input', function () { syncUnitCapture(tr); });
            body.appendChild(tr);
            syncUnitCapture(tr);
        }
        document.getElementById('add-row').addEventListener('click', addRow);
        for (let i = 0; i < 5; i++) addRow();

        // Extra serial slots and TC-qty boxes have no name until now -- row
        // order can change (rows added/removed) right up to submit, so the
        // index has to be computed from final DOM order, not creation order,
        // matching how itemName[]/type[]/etc. already bind by document order.
        const form = document.querySelector('form[action*="SubmitIntake"]');
        if (form) form.addEventListener('submit', function () {
            Array.from(body.children).forEach(function (tr, rowIdx) {
                tr.querySelectorAll('.intake-extra-serial').forEach(function (el) {
                    el.name = 'extraSerial_' + rowIdx + '_' + el.getAttribute('data-slot');
                });
                const tcQtyEl = tr.querySelector('.intake-tc-qty');
                if (tcQtyEl) tcQtyEl.name = 'thermocoupledQty_' + rowIdx;
            });
        });
    })();
</script>
