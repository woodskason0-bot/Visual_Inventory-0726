@model Visual_Inventory_System.Models.ViewModels.TasksAvailableViewModel
@inject Visual_Inventory_System.Services.CurrentUserService CurrentUser
@{
    ViewData["Title"] = "Tasks Available";
    var orders = Model?.Orders ?? new List<Visual_Inventory_System.Models.ViewModels.PendingOrderViewModel>();
    var ready = orders.Where(o => o.CanFulfill).ToList();
    var blocked = orders.Where(o => !o.CanFulfill).ToList();
    var storeTasks = Model?.StoreTasks ?? new List<Visual_Inventory_System.Models.VisTask>();

    bool canCreate = CurrentUser.Level >= Visual_Inventory_System.Services.AccessLevels.Engineer;
    bool canClaim = CurrentUser.Level >= Visual_Inventory_System.Services.AccessLevels.Standard;
    string me = CurrentUser.Name;

    string Requester(string? r) => string.IsNullOrEmpty(r) ? "\u2014" : r.Replace('.', ' ');
    string Ago(DateTime utc)
    {
        var a = DateTime.UtcNow - utc;
        return a.TotalMinutes < 1 ? "just now"
            : a.TotalHours < 1 ? $"{(int)a.TotalMinutes}m ago"
            : a.TotalDays < 1 ? $"{(int)a.TotalHours}h ago"
            : $"{(int)a.TotalDays}d ago";
    }
}

<style>
    .queue-wrap { max-width: 1200px; margin: 1.5rem auto; }
    .queue-card {
        background-color: var(--vis-card);
        border: 1px solid var(--vis-card-border);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.45);
    }
    .queue-card table { color: var(--vis-text); margin-bottom: 0; }
    .queue-card thead th {
        background-color: #14151A; color: #CBD5E1;
        border-color: var(--vis-card-border) !important;
        text-transform: uppercase; font-size: 12px; letter-spacing: 0.4px;
    }
    .queue-card tbody td { border-color: var(--vis-card-border) !important; vertical-align: middle; }
    .queue-card tbody tr:hover { background-color: rgba(216,43,51,0.05); }
    .queue-card .item-list { font-size: 12px; color: #94A3B8; margin: 6px 0 0; padding-left: 18px; }
    .text-dim { color: #94A3B8 !important; }

    /* "Go Store These" corkboard -- sticky notes as theme-aware cards with an
       amber edge (avoids a full-yellow card that would fail dark-mode contrast). */
    .board { display: flex; flex-wrap: wrap; gap: 1rem; }
    .sticky {
        flex: 0 1 260px;
        background-color: var(--vis-card);
        border: 1px solid var(--vis-card-border);
        border-left: 4px solid #F59E0B;
        border-radius: 8px;
        padding: 0.9rem 1rem;
        box-shadow: 0 6px 18px rgba(0,0,0,0.35);
    }
    .sticky.claimed { border-left-color: #64748B; opacity: 0.92; }
    .sticky h6 { color: var(--vis-text); font-weight: 700; margin-bottom: 0.35rem; }
    .sticky .note { color: var(--vis-text-muted); font-size: 12px; white-space: pre-wrap; }
    .sticky .meta { color: var(--vis-text-muted); font-size: 10px; margin-top: 0.5rem; }
    .create-note {
        background-color: var(--vis-card);
        border: 1px dashed var(--vis-card-border);
        border-radius: 8px; padding: 1rem;
    }
    .cn-input {
        background: var(--vis-bg); color: var(--vis-text);
        border: 1px solid var(--vis-card-border); border-radius: 6px; padding: 6px 10px;
    }
    .cn-input:focus { outline: none; border-color: var(--vis-blue); }
    .section-h { color: var(--vis-text); font-weight: 700; }
</style>

<div class="queue-wrap px-3">
    <h2 class="fw-bold mb-1"><i class="bi bi-clipboard-check me-2" style="color: var(--vis-red);"></i>Tasks Available</h2>
    <div class="text-dim mb-3">Things to grab and things to put away.</div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success py-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["Error"]</div>
    }

    @{
        var shortOrderId = TempData["ShortPullOrderId"] as int?;
        var shortJson = TempData["ShortPullJson"] as string;
        var shortLines = string.IsNullOrEmpty(shortJson)
            ? new List<Visual_Inventory_System.Services.ShortPullLine>()
            : (System.Text.Json.JsonSerializer.Deserialize<List<Visual_Inventory_System.Services.ShortPullLine>>(shortJson)
               ?? new List<Visual_Inventory_System.Services.ShortPullLine>());
    }
    @if (shortOrderId.HasValue && shortLines.Any())
    {
        <!-- Short-pull correction: not enough on the shelf to honor the line as
             ordered. Stock was left untouched -- report what's actually there,
             per location, and a corrected order gets issued and picked up in the
             same action. See OrderService.ReportShortPull. -->
        <div class="queue-card p-3 mb-4" style="border-left: 4px solid var(--vis-red);">
            <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-1" style="color: var(--vis-red);"></i>Short on Order #@shortOrderId</h6>
            <p class="text-dim small mb-3">
                What's requested doesn't match what's on the shelf. Report the real count at
                each location below -- leave a box as-is if that location's count is correct.
            </p>
            @foreach (var line in shortLines)
            {
                <form asp-controller="Home" asp-action="ReportShortPull" method="post" class="mb-3 pb-3" style="border-bottom: 1px solid var(--vis-card-border);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="orderId" value="@shortOrderId" />
                    <input type="hidden" name="orderItemId" value="@line.OrderItemId" />
                    <div class="mb-2">
                        <span class="fw-bold">@line.ItemId</span> &mdash; @line.ItemName
                        <span class="text-dim ms-2">requested @line.Requested</span>
                    </div>
                    <div class="row g-2 align-items-end">
                        @foreach (var loc in line.Locations)
                        {
                            <div class="col-auto">
                                <label class="form-label small text-dim mb-1">@loc.Fda</label>
                                <input type="number" min="0" name="corrected_@loc.VariantId" class="form-control form-control-sm" style="width:110px;" value="@loc.RecordedQty" />
                            </div>
                        }
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Correct &amp; Pick Up</button>
                        </div>
                    </div>
                </form>
            }
        </div>
    }

    <!-- Deliberate partial pickup (see OrderService.PickUpPartialAndSplit) -- hidden
         until "Take these, short-pull the rest" is clicked on a shortfall banner
         below. JS fills in the hidden fields, item description, and serial rows,
         then reveals this card. Same shape as the Short-pull correction card
         above: one shared form, populated per-click rather than one per line. -->
    <div class="queue-card p-3 mb-4 d-none" id="partial-pickup-card" style="border-left: 4px solid var(--vis-red);">
        <h6 class="fw-bold mb-2"><i class="bi bi-box-seam me-1" style="color: var(--vis-red);"></i>Take Partial Pickup</h6>
        <p class="text-dim small mb-2" id="partial-pickup-desc"></p>
        <form asp-controller="Home" asp-action="PickUpPartialAndSplit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderId" id="partial-orderId" />
            <input type="hidden" name="orderItemId" id="partial-orderItemId" />
            <input type="hidden" name="variantId" id="partial-variantId" />
            <input type="hidden" name="pickupQty" id="partial-pickupQty" />
            <div id="partial-serial-rows" class="mb-2"></div>
            <button type="submit" class="btn btn-sm btn-danger fw-bold">Confirm Partial Pickup</button>
            <button type="button" class="btn btn-sm btn-outline-secondary ms-1" id="partial-pickup-cancel">Cancel</button>
        </form>
    </div>

    <!-- ============ GO GET THESE (pending-order pickup queue) ============ -->
    <h4 class="section-h mb-2"><i class="bi bi-box-seam me-2 text-success"></i>Go Get These</h4>
    <div class="mb-2 d-flex gap-3">
        <span class="badge bg-success fs-6">Ready: @ready.Count</span>
        <span class="badge bg-warning text-dark fs-6">Blocked: @blocked.Count</span>
    </div>

    <h6 class="fw-bold mb-2"><i class="bi bi-check2-circle me-1 text-success"></i>Ready to Pick</h6>
    <div class="queue-card p-3 mb-4">
        <div class="table-responsive">
        <table class="table table-hover align-middle" style="min-width:640px;">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Requested By</th>
                    <th>Created</th>
                    <th>Items</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!ready.Any())
                {
                    <tr><td colspan="5" class="text-center text-dim py-3">Nothing ready to pick.</td></tr>
                }
                @foreach (var order in ready)
                {
                    <tr>
                        <td class="fw-bold">
                            #@order.OrderId
                            @if (order.SplitFromOrderId.HasValue)
                            {
                                <span class="d-block text-dim" style="font-size:11px; font-weight:normal;">split from #@order.SplitFromOrderId</span>
                            }
                        </td>
                        <td>@Requester(order.RequestedBy)</td>
                        <td class="text-dim small">@order.CreatedAt.ToLocalTime()</td>
                        <td>@(order.Items?.Count ?? 0)</td>
                        <td>
                            <form asp-controller="Home" asp-action="PickUpOrderConfirmed" method="post" class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <a asp-controller="Home" asp-action="OrderDetails" asp-route-id="@order.OrderId" class="btn btn-sm btn-info text-white me-1">View</a>
                                <button type="submit" class="btn btn-sm btn-success fw-bold">Pick Up</button>
                                <ul class="item-list">
                                    @foreach (var it in order.Items)
                                    {
                                        <li>
                                            @it.ItemId@(string.IsNullOrWhiteSpace(it.RheemPartNumber) ? "" : $" [{it.RheemPartNumber}]") &mdash; @it.ItemName &mdash; Qty: @it.Quantity (avail: @it.AvailableForThisOrder)
                                            @if (it.RequestedVariantId.HasValue)
                                            {
                                                <span class="d-block text-info" style="font-size:11px;">
                                                    <i class="bi bi-geo-alt-fill me-1"></i>Pull from: @(it.RequestedLabel ?? "requested location no longer active — will auto-pull")
                                                </span>
                                            }
                                            else if (it.LocationChoices.Count > 1)
                                            {
                                                <span class="d-block mt-1" style="font-size:11px;">
                                                    <i class="bi bi-geo-alt me-1 text-warning"></i>Pull from:
                                                    <select name="variantChoice_@it.OrderItemId" class="form-select form-select-sm d-inline-block ms-1 variant-choice-select"
                                                            data-oi="@it.OrderItemId" data-order-id="@order.OrderId" data-ordered-qty="@it.Quantity"
                                                            style="width:auto; max-width:300px; background-color: var(--vis-card); color: var(--vis-text); border-color: var(--vis-card-border); font-size:11px;">
                                                        <option value="">Any location (auto)</option>
                                                        @foreach (var c in it.LocationChoices)
                                                        {
                                                            <option value="@c.VariantId" data-qty="@c.Quantity">@c.Label</option>
                                                        }
                                                    </select>
                                                </span>
                                                @if (Visual_Inventory_System.Services.InventoryService.IsCompressorType(it.Type))
                                                {
                                                    <div class="mt-1 p-2 shortfall-banner d-none" data-oi="@it.OrderItemId"
                                                         style="background:#2A1515; border:1px solid #6B2B2B; border-radius:6px;">
                                                        <span class="d-block mb-1 text-warning shortfall-text" style="font-size:11px;"></span>
                                                        <button type="button" class="btn btn-sm btn-outline-warning shortfall-continue" style="font-size:11px;">Continue from another location</button>
                                                        <button type="button" class="btn btn-sm btn-outline-danger shortfall-split ms-1" style="font-size:11px;">Take these, short-pull the rest</button>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary shortfall-skip ms-1" style="font-size:11px;">Skip for now</button>
                                                    </div>
                                                }
                                            }
                                            @if (Visual_Inventory_System.Services.InventoryService.IsCompressorType(it.Type))
                                            {
                                                int? initialVariantId = it.RequestedVariantId
                                                    ?? (it.LocationChoices.Count == 1 ? it.LocationChoices[0].VariantId : (int?)null);
                                                var onHandJson = System.Text.Json.JsonSerializer.Serialize(
                                                    it.LocationChoices.ToDictionary(
                                                        c => c.VariantId.ToString(),
                                                        c => c.OnHandUnits.Select(u => new { serial = u.SerialNumber, lab = u.LabNumber }).ToList()));
                                                <div class="mt-2 p-2 comp-block" data-oi="@it.OrderItemId" data-order-id="@order.OrderId" data-item-id="@it.ItemId"
                                                     data-item-name="@it.ItemName" data-initial-variant="@(initialVariantId?.ToString() ?? "")"
                                                     style="background:#14151A; border:1px solid #3D4351; border-radius:6px;">
                                                    <span class="d-block mb-1" style="font-size:11px; color:#94A3B8;">
                                                        <i class="bi bi-upc-scan me-1"></i>Serial # -- pick from what's on hand at the pull location, or add one
                                                    </span>
                                                    @for (int u = 0; u < it.Quantity; u++)
                                                    {
                                                        <div class="d-flex gap-1 mb-1">
                                                            <input type="text" name="compLab_@(it.OrderItemId)_@(u)" class="form-control form-control-sm"
                                                                   placeholder="Lab # (unit @(u + 1))"
                                                                   style="max-width:100px; background-color: var(--vis-card); color: var(--vis-text); border-color: var(--vis-card-border); font-size:11px;" />
                                                            <select name="compSerial_@(it.OrderItemId)_@(u)" class="form-select form-select-sm comp-serial-select" data-oi="@it.OrderItemId"
                                                                    style="max-width:170px; background-color: var(--vis-card); color: var(--vis-text); border-color: var(--vis-card-border); font-size:11px;">
                                                                <option value="">Choose a location above</option>
                                                            </select>
                                                            <input type="text" name="compSerialManual_@(it.OrderItemId)_@(u)" class="form-control form-control-sm comp-serial-manual d-none"
                                                                   placeholder="Type serial (unit @(u + 1))"
                                                                   style="max-width:140px; background-color: var(--vis-card); color: var(--vis-text); border-color: var(--vis-card-border); font-size:11px;" />
                                                        </div>
                                                    }
                                                    <script type="application/json" class="comp-onhand-data" data-oi="@it.OrderItemId">@Html.Raw(onHandJson)</script>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </form>
                            <form asp-controller="Home" asp-action="CancelPersisted" method="post" class="d-inline ms-1 align-top">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <h6 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>Blocked Orders</h6>
    <div class="queue-card p-3 mb-5">
        <div class="table-responsive">
        <table class="table table-hover align-middle" style="min-width:640px;">
            <thead>
                <tr>
                    <th>Order</th>
                    <th>Requested By</th>
                    <th>Created</th>
                    <th>Items</th>
                    <th>Why Blocked</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!blocked.Any())
                {
                    <tr><td colspan="6" class="text-center text-dim py-3">No blocked orders.</td></tr>
                }
                @foreach (var order in blocked)
                {
                    <tr>
                        <td class="fw-bold">#@order.OrderId</td>
                        <td>@Requester(order.RequestedBy)</td>
                        <td class="text-dim small">@order.CreatedAt.ToLocalTime()</td>
                        <td>@(order.Items?.Count ?? 0)</td>
                        <td>
                            @if (order.IsBlockedByPriority)
                            {
                                <span class="text-warning">Blocked by earlier orders</span>
                            }
                            else
                            {
                                <span class="text-danger">Insufficient inventory</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Home" asp-action="OrderDetails" asp-route-id="@order.OrderId" class="btn btn-sm btn-info text-white">View</a>
                            <form asp-controller="Home" asp-action="CancelPersisted" method="post" class="d-inline ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                            <ul class="item-list">
                                @foreach (var it in order.Items)
                                {
                                    <li>@it.ItemId@(string.IsNullOrWhiteSpace(it.RheemPartNumber) ? "" : $" [{it.RheemPartNumber}]") &mdash; @it.ItemName &mdash; Qty: @it.Quantity (avail: @it.AvailableForThisOrder)</li>
                                }
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <!-- ============ GO STORE THESE (new claimable sticky-note tasks) ============ -->
    <h4 class="section-h mb-2"><i class="bi bi-sticky me-2" style="color:#F59E0B;"></i>Go Store These</h4>
    <div class="text-dim mb-3">Hand-posted put-away tasks. Claim one to lock your name to it; finish it and it drops off the board.</div>

    @if (canCreate)
    {
        <form asp-controller="Home" asp-action="CreateStoreTask" method="post" class="create-note mb-4">
            @Html.AntiForgeryToken()
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="text-dim d-block mb-1" style="font-size:11px;">Task title</label>
                    <input type="text" name="title" class="cn-input w-100" placeholder="e.g. Put away pallet by Connex 6" required />
                </div>
                <div class="col-md-6">
                    <label class="text-dim d-block mb-1" style="font-size:11px;">Note (optional) — point at the New Item Registry if needed</label>
                    <input type="text" name="details" class="cn-input w-100" placeholder="Anything the runner should know" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-warning fw-bold w-100"><i class="bi bi-pin-angle me-1"></i>Pin</button>
                </div>
            </div>
        </form>
    }

    @if (!storeTasks.Any())
    {
        <div class="queue-card p-4 text-center text-dim">Nothing to store right now.</div>
    }
    else
    {
        <div class="board">
            @foreach (var t in storeTasks)
            {
                var claimed = t.Status == "Claimed";
                var mine = claimed && string.Equals(t.ClaimedBy, me, StringComparison.OrdinalIgnoreCase);
                <div class="sticky @(claimed ? "claimed" : "")">
                    <h6>@t.Title</h6>
                    @if (!string.IsNullOrWhiteSpace(t.Details))
                    {
                        <div class="note">@t.Details</div>
                    }
                    <div class="meta">
                        <i class="bi bi-person me-1"></i>@Requester(t.CreatedBy) · @Ago(t.CreatedAt)
                    </div>

                    <div class="mt-2">
                        @if (!claimed)
                        {
                            if (canClaim)
                            {
                                <form asp-controller="Home" asp-action="ClaimTask" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold w-100"><i class="bi bi-hand-index me-1"></i>Claim</button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Open</span>
                            }
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge" style="background:#64748B;"><i class="bi bi-person-check me-1"></i>@Requester(t.ClaimedBy)</span>
                                @if (mine)
                                {
                                    <form asp-controller="Home" asp-action="CompleteTask" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success fw-bold"><i class="bi bi-check2 me-1"></i>Done</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <p class="mt-4"><a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-secondary">&larr; Back to Dashboard</a></p>
</div>

<script>
(function () {
    "use strict";

    // Only units with a REAL serial can be offered as named options. A
    // serial-less On Hand row (lab-only, or Pass 29's FIFO fallback) rendered
    // as an option becomes `value="null"` via String(null) -- selectable, and
    // the stagger below would even default to it -- so a picker who touches
    // nothing posts the literal serial "null". The server filters these out of
    // the payload too; this keeps the client honest if that ever changes.
    function namedUnits(units) {
        return (units || []).filter(function (u) { return u.serial; });
    }

    function optionsFor(units) {
        var html = "";
        namedUnits(units).forEach(function (u) {
            var label = "SN: " + u.serial + (u.lab ? " (Lab: " + u.lab + ")" : "");
            var val = String(u.serial).replace(/"/g, "&quot;");
            html += '<option value="' + val + '">' + label + "</option>";
        });
        html += '<option value="__NONE__">No serial</option>';
        html += '<option value="__ADD__">Serial not in list -- add serial</option>';
        return html;
    }

    // A picker choosing the same on-hand serial for two different units on the
    // same line is caught server-side now (see AssignOneCompressorUnit), but
    // catching it before Confirm is friendlier -- disable a known serial in
    // every sibling select on the same line once another select has claimed
    // it, and free it back up the moment that select moves off it.
    function enforceSerialExclusivity(container) {
        if (!container) return;
        var selects = Array.prototype.slice.call(container.querySelectorAll(".comp-serial-select"));
        selects.forEach(function (sel) {
            Array.prototype.forEach.call(sel.options, function (opt) {
                if (!opt.value || opt.value === "__NONE__" || opt.value === "__ADD__") return;
                opt.disabled = selects.some(function (other) {
                    return other !== sel && other.value === opt.value;
                });
            });
        });
    }

    function serialContainerFor(sel) {
        return sel.closest(".comp-block") || sel.closest("#partial-pickup-card");
    }

    function populate(oi, variantId) {
        var dataEl = document.querySelector('.comp-onhand-data[data-oi="' + oi + '"]');
        if (!dataEl) return;
        var data = {};
        try { data = JSON.parse(dataEl.textContent || "{}"); } catch (e) { data = {}; }
        var units = namedUnits(variantId ? data[variantId] : null);

        document.querySelectorAll('.comp-serial-select[data-oi="' + oi + '"]').forEach(function (sel, idx) {
            var manual = sel.parentElement.querySelector(".comp-serial-manual");
            if (!variantId) {
                sel.innerHTML = '<option value="">Choose a location above</option>';
                sel.disabled = true;
                if (manual) manual.classList.add("d-none");
                return;
            }
            sel.disabled = false;
            sel.innerHTML = optionsFor(units);
            // Stagger the default across units so a multi-unit line doesn't
            // open with every dropdown already aimed at the same physical
            // serial -- one real serial per unit while they last, "No serial"
            // once they run out, rather than everyone defaulting to option 0.
            var named = namedUnits(units);
            sel.value = (idx < named.length) ? named[idx].serial : "__NONE__";
            if (manual) manual.classList.add("d-none");
        });
        enforceSerialExclusivity(document.querySelector('.comp-block[data-oi="' + oi + '"]'));
    }

    document.querySelectorAll(".comp-block").forEach(function (block) {
        var oi = block.getAttribute("data-oi");
        var initial = block.getAttribute("data-initial-variant") || "";
        populate(oi, initial || null);
    });

    function checkShortfall(locSel) {
        var oi = locSel.getAttribute("data-oi");
        var banner = document.querySelector('.shortfall-banner[data-oi="' + oi + '"]');
        if (!banner) return;

        var ordered = parseInt(locSel.getAttribute("data-ordered-qty") || "0", 10);
        var opt = locSel.options[locSel.selectedIndex];
        var here = opt ? parseInt(opt.getAttribute("data-qty") || "0", 10) : 0;

        if (!locSel.value || here >= ordered) {
            banner.classList.add("d-none");
            return;
        }

        banner.dataset.variantId = locSel.value;
        banner.dataset.pickupQty = here;
        banner.querySelector(".shortfall-text").textContent =
            "Only " + here + " of " + ordered + " on hand here.";
        banner.classList.remove("d-none");
    }

    document.querySelectorAll('select[name^="variantChoice_"]').forEach(function (locSel) {
        locSel.addEventListener("change", function () {
            var parts = locSel.getAttribute("name").split("_");
            populate(parts[1], locSel.value || null);
            checkShortfall(locSel);
        });
    });

    document.addEventListener("change", function (e) {
        var t = e.target;
        if (t && t.classList && t.classList.contains("comp-serial-select")) {
            var manual = t.parentElement.querySelector(".comp-serial-manual");
            if (manual) manual.classList.toggle("d-none", t.value !== "__ADD__");
            enforceSerialExclusivity(serialContainerFor(t));
        }
    });

    document.addEventListener("click", function (e) {
        var t = e.target;
        if (!t || !t.classList) return;

        if (t.classList.contains("shortfall-continue") || t.classList.contains("shortfall-skip")) {
            var banner = t.closest(".shortfall-banner");
            if (!banner) return;
            if (t.classList.contains("shortfall-continue")) {
                var oi = banner.getAttribute("data-oi");
                var locSel = document.querySelector('.variant-choice-select[data-oi="' + oi + '"]');
                if (locSel) { locSel.value = ""; populate(oi, null); }
            }
            banner.classList.add("d-none");
            return;
        }

        if (t.classList.contains("shortfall-split")) {
            var sBanner = t.closest(".shortfall-banner");
            if (!sBanner) return;
            var sOi = sBanner.getAttribute("data-oi");
            var variantId = sBanner.dataset.variantId;
            var pickupQty = parseInt(sBanner.dataset.pickupQty || "0", 10);
            var block = document.querySelector('.comp-block[data-oi="' + sOi + '"]');
            if (!block || pickupQty <= 0) return;

            var dataEl = block.querySelector(".comp-onhand-data");
            var data = {};
            try { data = JSON.parse(dataEl.textContent || "{}"); } catch (err) { data = {}; }
            var units = data[variantId] || [];

            document.getElementById("partial-orderId").value = block.getAttribute("data-order-id");
            document.getElementById("partial-orderItemId").value = sOi;
            document.getElementById("partial-variantId").value = variantId;
            document.getElementById("partial-pickupQty").value = pickupQty;
            document.getElementById("partial-pickup-desc").textContent =
                block.getAttribute("data-item-id") + " (" + block.getAttribute("data-item-name") + ") -- picking up " +
                pickupQty + " now; the rest splits into a new order for later.";

            var rows = document.getElementById("partial-serial-rows");
            var html = "";
            for (var u = 0; u < pickupQty; u++) {
                html += '<div class="d-flex gap-1 mb-1">' +
                    '<input type="text" name="compLab_' + u + '" class="form-control form-control-sm" placeholder="Lab # (unit ' + (u + 1) + ')" style="max-width:100px;" />' +
                    '<select name="compSerial_' + u + '" class="form-select form-select-sm comp-serial-select" data-u="' + u + '" style="max-width:170px;">' +
                    optionsFor(units) +
                    '</select>' +
                    '<input type="text" name="compSerialManual_' + u + '" class="form-control form-control-sm comp-serial-manual d-none" placeholder="Type serial (unit ' + (u + 1) + ')" style="max-width:140px;" />' +
                    '</div>';
            }
            rows.innerHTML = html;
            // Same stagger as populate() -- one real serial per unit while
            // they last, instead of every row opening on the same default.
            var namedHere = namedUnits(units);
            rows.querySelectorAll(".comp-serial-select").forEach(function (sel, idx) {
                sel.value = (idx < namedHere.length) ? namedHere[idx].serial : "__NONE__";
            });
            enforceSerialExclusivity(document.getElementById("partial-pickup-card"));

            sBanner.classList.add("d-none");
            document.getElementById("partial-pickup-card").classList.remove("d-none");
            document.getElementById("partial-pickup-card").scrollIntoView({ behavior: "smooth", block: "center" });
            return;
        }

        if (t.id === "partial-pickup-cancel") {
            document.getElementById("partial-pickup-card").classList.add("d-none");
        }
    });
})();
</script>
