        function motorApplyFilter() {
            const unclaimedOnly = document.getElementById('motorFilterUnclaimed')?.checked;
            const branch = document.getElementById('motorFilterBranch')?.value || '';
            const line = document.getElementById('motorFilterLine')?.value || '';
            const team = document.getElementById('motorFilterTeam')?.value || '';
            const brand = document.getElementById('motorFilterBrand')?.value || '';
            const rows = document.querySelectorAll('#motorRegistryModal .motor-row');
            let shown = 0;
