<!-- COMPRESSOR REGISTRY (sidebar Compressors quick filter) -->
<div class="modal fade" id="compressorRegistryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background-color: var(--vis-card); border: 1px solid var(--vis-card-border);">
            <div class="modal-header" style="border-bottom: 1px solid var(--vis-card-border);">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-cpu-fill me-2 text-primary"></i>Compressors (@compressorItems.Count model@(compressorItems.Count == 1 ? "" : "s"))</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-white" style="max-height: 65vh; overflow-y: auto;">
                <p class="text-light-gray small mb-3">
                    Lab #/Serial # are logged as units are picked up -- this is a running log,
                    not a full map of current stock. A model showing Qty 12 may only have a
                    few units listed below for a while; that gap closes as more get logged.
                </p>

                <!-- Filter bar: Unclaimed = missing Team OR missing Line (either one
                     outstanding counts). All filters AND together. Purely client-side
                     (the modal is fully rendered
                     already), so filtering never closes the modal or round-trips the
                     page. Listeners are wired in JS (not inline onchange) since this
                     modal's script lives inside a scoping IIFE further down the file. -->
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3 p-2" style="background:#14151A; border:1px solid #3D4351; border-radius:6px;">
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="compFilterUnclaimed">
                        <label class="form-check-label small" for="compFilterUnclaimed">Unclaimed only</label>
                    </div>
                    <!-- Options populated by the shared wireLineCascade() helper, same as
                         the registration form and Ownership pane -- one source of truth
                         (orgStructure) instead of a fourth hand-typed copy of the list. -->
                    <select id="compFilterBranch" class="form-select form-select-sm" style="width:auto;"></select>
                    <select id="compFilterLine" class="form-select form-select-sm" style="width:auto;"></select>
                    <select id="compFilterTeam" class="form-select form-select-sm" style="width:auto;">
                        <option value="">All Teams</option>
                        @foreach (var t in (List<Visual_Inventory_System.Models.Team>)(ViewBag.ActiveTeams ?? new List<Visual_Inventory_System.Models.Team>()))
                        {
                            <option value="@t.Name">@t.Name</option>
                        }
                    </select>
                    <select id="compFilterBrand" class="form-select form-select-sm" style="width:auto;">
                        <option value="">All Brands</option>
                        @foreach (var b in compressorBrands)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                    <span id="compFilterCount" class="text-light-gray small ms-auto"></span>
                </div>

                @if (!compressorItems.Any())
                {
                    <p class="text-light-gray mb-0">No compressor models visible to you yet.</p>
                }
                else
                {
                    @foreach (var it in compressorItems)
                    {
                        var units = compressorUnitsByItem.TryGetValue(it.ItemId, out var u) ? u : new List<Visual_Inventory_System.Models.CompressorUnit>();
                        var onHandUnits = units.Where(x => x.Status == Visual_Inventory_System.Models.UnitStatus.OnHand).ToList();
                        var historyUnits = units.Where(x => x.Status != Visual_Inventory_System.Models.UnitStatus.OnHand).ToList();
                        var collapseId = "compUnits-" + it.ItemId.Replace(" ", "");
                        var isUnclaimed = string.IsNullOrWhiteSpace(it.Team) || string.IsNullOrWhiteSpace(it.Line);
                        var itBranch = Visual_Inventory_System.Services.OrgStructure.BranchFor(it.Line) ?? "";

                        @* The roster: one row per physical unit on the shelf, padded with
                           blank rows up to each location's Quantity so a passerby can log a
                           serial that was never picked up -- the other entrance to
                           CompressorUnits besides PickUpOrder's match-or-create. Grouped by
                           variant because 18 models split across two locations; a flat list
                           of 16 blanks couldn't say which shelf a given blank belongs to. *@
                        var roster = new List<(int UnitId, int VariantId, string? Serial, string? Lab, string VariantLabel)>();
                        foreach (var v in it.ActiveVariants.OrderBy(v => v.VariantNumber))
                        {
                            var label = $"V{v.VariantNumber} — {v.FdaString}";
                            var atThisVariant = onHandUnits.Where(x => x.ItemVariantId == v.Id).ToList();
                            foreach (var cu in atThisVariant)
                                roster.Add((cu.Id, v.Id, cu.SerialNumber, cu.LabNumber, label));
                            int blanksNeeded = System.Math.Max(0, v.Quantity - atThisVariant.Count);
                            for (int b = 0; b < blanksNeeded; b++)
                                roster.Add((0, v.Id, null, null, label));
                        }

                        <div class="comp-row mb-2 p-2" data-branch="@itBranch" data-line="@(it.Line ?? "")" data-team="@(it.Team ?? "")" data-brand="@(it.Brand ?? "")" data-unclaimed="@(isUnclaimed ? "1" : "0")" style="background:#14151A; border:1px solid #3D4351; border-radius:6px;">
                            <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;"
                                 data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                <div>
                                    <span class="fw-bold">@it.ItemId</span> &mdash; @it.ItemName
                                    <span class="text-light-gray ms-2" style="font-size:11px;">@(string.IsNullOrEmpty(it.Line) ? "" : $"[{it.Line}]")</span>
                                </div>
                                <div>
                                    <span class="badge bg-primary me-2">Qty @it.Quantity</span>
                                    <span class="badge bg-secondary" title="Units with a serial on record, out of the quantity on hand">
                                        @onHandUnits.Count / @it.Quantity tracked
                                    </span>
                                    <i class="bi bi-chevron-down ms-1"></i>
                                </div>
                            </div>
                            <div class="collapse mt-2" id="@collapseId">
                                @if (!roster.Any())
                                {
                                    <p class="text-light-gray small mb-0">Nothing on hand right now.</p>
                                }
                                else
                                {
                                    <form asp-controller="Home" asp-action="LogCompressorUnits" method="post" class="mb-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="itemId" value="@it.ItemId" />
                                        <table class="table table-sm align-middle mb-2">
                                            <thead><tr><th>Location</th><th>Serial #</th><th>Lab #</th></tr></thead>
                                            <tbody>
                                                @{ string? lastLabel = null; int rowIdx = 0; }
                                                @foreach (var row in roster)
                                                {
                                                    <tr>
                                                        <td class="text-light-gray small">@(row.VariantLabel == lastLabel ? "" : row.VariantLabel)</td>
                                                        <td>
                                                            <input type="hidden" name="unitId_@rowIdx" value="@row.UnitId" />
                                                            <input type="hidden" name="variantId_@rowIdx" value="@row.VariantId" />
                                                            <input type="text" name="serial_@rowIdx" value="@row.Serial"
                                                                   placeholder="@(row.UnitId == 0 ? "(unrecorded)" : "")"
                                                                   class="form-control form-control-sm" />
                                                        </td>
                                                        <td>
                                                            <input type="text" name="lab_@rowIdx" value="@row.Lab"
                                                                   class="form-control form-control-sm" />
                                                        </td>
                                                    </tr>
                                                    lastLabel = row.VariantLabel;
                                                    rowIdx++;
                                                }
                                            </tbody>
                                        </table>
                                        <button type="submit" class="btn btn-sm btn-outline-success">Save Serials / Lab #s</button>
                                    </form>
                                }
                                @if (historyUnits.Any())
                                {
                                    @* Pass 6A: units that have left the shelf (or been scrapped).
                                       Read-only -- their identity is fixed once they're off the
                                       roster; corrections belong on whatever's actually On Hand. *@
                                    <p class="text-light-gray small mb-1">History</p>
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead><tr><th>Serial #</th><th>Lab #</th><th>Status</th><th>When</th><th>By</th></tr></thead>
                                        <tbody>
                                            @foreach (var cu in historyUnits)
                                            {
                                                var scrapped = cu.Status == Visual_Inventory_System.Models.UnitStatus.Scrapped;
                                                var stamp = cu.PickedUpAt ?? cu.RecordedAt;
                                                var who = string.IsNullOrWhiteSpace(cu.PickedUpBy) ? cu.RecordedBy : cu.PickedUpBy;
                                                <tr>
                                                    <td class="@(string.IsNullOrWhiteSpace(cu.SerialNumber) ? "text-warning" : "")">
                                                        @(string.IsNullOrWhiteSpace(cu.SerialNumber) ? "(missing)" : cu.SerialNumber)
                                                    </td>
                                                    <td class="text-light-gray">@(string.IsNullOrWhiteSpace(cu.LabNumber) ? "—" : cu.LabNumber)</td>
                                                    <td>
                                                        <span class="badge @(scrapped ? "bg-danger" : "bg-warning text-dark")">
                                                            @cu.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-light-gray small">@stamp.ToLocalTime()</td>
                                                    <td class="text-light-gray small">@((who ?? "").Replace('.', ' '))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- MOTORS (TC only) -- CompressorUnit's sibling roster, no serial. A model
     only appears here while it has TC stock to track: on hand, out on loan,
     or both. Scrapped units drop off entirely -- nothing left to correct. -->
<div class="modal fade" id="motorRegistryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background-color: var(--vis-card); border: 1px solid var(--vis-card-border);">
            <div class="modal-header" style="border-bottom: 1px solid var(--vis-card-border);">
                <h5 class="modal-title fw-bold text-white"><i class="bi bi-fan me-2 text-primary"></i>TC Motors (@motorItems.Count model@(motorItems.Count == 1 ? "" : "s"))</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-white" style="max-height: 65vh; overflow-y: auto;">
                <p class="text-light-gray small mb-3">
                    TC (thermocoupled) comes from the manufacturer -- VIS never adds it, so only
                    the TC subset of a motor model's stock is tracked here. No serial numbers;
                    lab #s are recorded, not assigned, and often blank until a numbering process
                    exists. Units still out on loan stay editable, not just what's on the shelf.
                </p>

                <!-- Filter bar: same shape as the Compressors modal (Unclaimed = missing
                     Team OR missing Line, Branch/Line/Team/Brand AND together), same
                     shared cascade helper. Visibility is inherited for free -- this
                     only narrows within motorItems, which is already Line-filtered
                     with the Level 5 bypass upstream via allItems. -->
                <div class="d-flex flex-wrap gap-2 align-items-center mb-3 p-2" style="background:#14151A; border:1px solid #3D4351; border-radius:6px;">
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="motorFilterUnclaimed">
                        <label class="form-check-label small" for="motorFilterUnclaimed">Unclaimed only</label>
                    </div>
                    <select id="motorFilterBranch" class="form-select form-select-sm" style="width:auto;"></select>
                    <select id="motorFilterLine" class="form-select form-select-sm" style="width:auto;"></select>
                    <select id="motorFilterTeam" class="form-select form-select-sm" style="width:auto;">
                        <option value="">All Teams</option>
                        @foreach (var t in (List<Visual_Inventory_System.Models.Team>)(ViewBag.ActiveTeams ?? new List<Visual_Inventory_System.Models.Team>()))
                        {
                            <option value="@t.Name">@t.Name</option>
                        }
                    </select>
                    <select id="motorFilterBrand" class="form-select form-select-sm" style="width:auto;">
                        <option value="">All Brands</option>
                        @foreach (var b in motorBrands)
                        {
                            <option value="@b">@b</option>
                        }
                    </select>
                    <span id="motorFilterCount" class="text-light-gray small ms-auto"></span>
                </div>

                @if (!motorItems.Any())
                {
                    <p class="text-light-gray mb-0">No TC motor stock to track right now.</p>
                }
                else
                {
                    @foreach (var it in motorItems)
                    {
                        var muAll = motorUnitsByItem.TryGetValue(it.ItemId, out var muList)
                            ? muList : new List<Visual_Inventory_System.Models.MotorUnit>();
                        var onHandMotors = muAll.Where(x => x.Status == Visual_Inventory_System.Models.UnitStatus.OnHand).ToList();
                        var outOnLoanMotors = muAll.Where(x => x.Status == Visual_Inventory_System.Models.UnitStatus.PickedUp).ToList();
                        var collapseId = "motorUnits-" + it.ItemId.Replace(" ", "");
                        var isUnclaimedMotor = string.IsNullOrWhiteSpace(it.Team) || string.IsNullOrWhiteSpace(it.Line);
                        var motorBranch = Visual_Inventory_System.Services.OrgStructure.BranchFor(it.Line) ?? "";

                        var roster = new List<(int UnitId, int VariantId, string? Lab, string GroupLabel)>();
                        foreach (var v in it.ActiveVariants.OrderBy(v => v.VariantNumber))
                        {
                            if (v.ThermocoupledQty <= 0) continue;
                            var label = $"On Hand — V{v.VariantNumber} — {v.FdaString}";
                            var atThisVariant = onHandMotors.Where(x => x.ItemVariantId == v.Id).ToList();
                            foreach (var mu in atThisVariant)
                                roster.Add((mu.Id, v.Id, mu.LabNumber, label));
                            int blanksNeeded = System.Math.Max(0, v.ThermocoupledQty - atThisVariant.Count);
                            for (int b = 0; b < blanksNeeded; b++)
                                roster.Add((0, v.Id, null, label));
                        }
                        foreach (var mu in outOnLoanMotors)
                            roster.Add((mu.Id, 0, mu.LabNumber, "Out on Loan"));

                        <div class="motor-row mb-2 p-2" data-branch="@motorBranch" data-line="@(it.Line ?? "")" data-team="@(it.Team ?? "")" data-brand="@(it.Brand ?? "")" data-unclaimed="@(isUnclaimedMotor ? "1" : "0")" style="background:#14151A; border:1px solid #3D4351; border-radius:6px;">
                            <div class="d-flex justify-content-between align-items-center" style="cursor:pointer;"
                                 data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                <div>
                                    <span class="fw-bold">@it.ItemId</span> &mdash; @it.ItemName
                                    <span class="text-light-gray ms-2" style="font-size:11px;">@(string.IsNullOrEmpty(it.Line) ? "" : $"[{it.Line}]")</span>
                                </div>
                                <div>
                                    <span class="badge bg-primary me-2">TC @it.TotalThermocoupled on hand</span>
                                    @if (outOnLoanMotors.Count > 0)
                                    {
                                        <span class="badge bg-warning text-dark me-2">@outOnLoanMotors.Count out on loan</span>
                                    }
                                    <i class="bi bi-chevron-down ms-1"></i>
                                </div>
                            </div>
                            <div class="collapse mt-2" id="@collapseId">
                                @if (!roster.Any())
                                {
                                    <p class="text-light-gray small mb-0">Nothing to track right now.</p>
                                }
                                else
                                {
                                    <form asp-controller="Home" asp-action="LogMotorUnits" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="itemId" value="@it.ItemId" />
                                        <table class="table table-sm align-middle mb-2">
                                            <thead><tr><th>Location</th><th>Lab #</th></tr></thead>
                                            <tbody>
                                                @{ string? lastGroup = null; int rowIdx = 0; }
                                                @foreach (var row in roster)
                                                {
                                                    <tr>
                                                        <td class="text-light-gray small">@(row.GroupLabel == lastGroup ? "" : row.GroupLabel)</td>
                                                        <td>
                                                            <input type="hidden" name="unitId_@rowIdx" value="@row.UnitId" />
                                                            <input type="hidden" name="variantId_@rowIdx" value="@row.VariantId" />
                                                            <input type="text" name="lab_@rowIdx" value="@row.Lab"
                                                                   placeholder="@(row.UnitId == 0 ? "(unrecorded)" : "")"
                                                                   class="form-control form-control-sm" />
                                                        </td>
                                                    </tr>
                                                    lastGroup = row.GroupLabel;
                                                    rowIdx++;
                                                }
                                            </tbody>
                                        </table>
                                        <button type="submit" class="btn btn-sm btn-outline-success">Save Lab #s</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

