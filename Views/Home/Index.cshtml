@using Visual_Inventory_System.Services
@inject Visual_Inventory_System.Services.CurrentUserService CurrentUser
@functions {
    string GetHoloTitle(Visual_Inventory_System.Models.SearchResult result)
    {
        if (result.Mode == "Omni") return $"Omni Search: \"{ViewBag.OmniSearch}\"";
        if (result.Mode == "Filter") return "Filter Search";
        return result.Mode == "Ledger" ? "Order Cart" : "Holo Viewer";
    }

    // Friendly one-line location for a variant: decode coded P/M/S, drop 0/blank
    // levels, append Rack/Row when real. Falls back to the raw FDA string.
    string FriendlyVarLoc(Visual_Inventory_System.Models.ItemVariant v)
    {
        bool Real(string? s) => !string.IsNullOrWhiteSpace(s) && s.Trim() != "0";
        var crumbs = new System.Collections.Generic.List<string>();
        if (Real(v.Parent)) crumbs.Add(Visual_Inventory_System.Services.LocationCodec.Decode(v.Parent));
        if (Real(v.Major)) crumbs.Add(Visual_Inventory_System.Services.LocationCodec.Decode(v.Major));
        if (Real(v.Sub)) crumbs.Add(Visual_Inventory_System.Services.LocationCodec.Decode(v.Sub));
        string path = string.Join(" › ", crumbs);
        string rr = "";
        if (Real(v.Rack) || Real(v.Row))
            rr = $"R{(Real(v.Rack) ? v.Rack.Trim() : "-")}/{(Real(v.Row) ? v.Row.Trim() : "-")}";
        if (path == "" && rr == "") return string.IsNullOrWhiteSpace(v.FdaString) ? "-" : v.FdaString;
        return rr == "" ? path : (path == "" ? rr : $"{path} · {rr}");
    }

    // Truncate an item name to a max number of NON-space characters, then add an ellipsis.
    string TruncName(string name, int maxNonSpace)
    {
        if (string.IsNullOrEmpty(name)) return "";
        int nonSpace = 0;
        var sb = new System.Text.StringBuilder();
        foreach (char c in name)
        {
            if (!char.IsWhiteSpace(c))
            {
                if (nonSpace == maxNonSpace) return sb.ToString().TrimEnd() + "...";
                nonSpace++;
            }
            sb.Append(c);
        }
        return sb.ToString();
    }
}

@{
    ViewData["Title"] = "Command Center";
    var result = ViewBag.SearchResult as Visual_Inventory_System.Models.SearchResult;
    bool showHolo = result != null && result.Mode != "None";
    var headerDraftIds = ViewBag.DraftItemIds as System.Collections.Generic.HashSet<string>;
    var hasDraft = headerDraftIds != null && headerDraftIds.Any();

    var invSvc = ViewBag.InventoryService as Visual_Inventory_System.Services.InventoryService;
    var allItems = invSvc?.GetAll() ?? new List<Visual_Inventory_System.Models.InventoryItem>();

    var lowStockItems = allItems.Where(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold).OrderBy(i => i.Quantity).ToList();
    var outOfStockItems = allItems.Where(i => i.Quantity == 0).OrderBy(i => i.ItemName).ToList();

    // "N/A" and blank are the same state (legacy blanks were folded into "N/A" by
    // migration) -- one check used everywhere an item's PN status matters.
    Func<string, bool> needsRheemPn = pn => string.IsNullOrWhiteSpace(pn) || pn.Trim().Equals("N/A", StringComparison.OrdinalIgnoreCase);
    var pnBacklogItems = allItems.Where(i => needsRheemPn(i.RheemPartNumber)).OrderBy(i => i.ItemName).ToList();

    // Compressor mini-variant tracking: models you can see (Line-filtered,
    // same as allItems above), each with whatever lab/serial units have been
    // logged at pickup so far. Forward-only log -- starts empty per model.
    var compressorItems = allItems.Where(i => Visual_Inventory_System.Services.InventoryService.IsCompressorType(i.Type))
        .OrderBy(i => i.ItemName).ToList();
    var compressorBrands = compressorItems.Select(i => i.Brand).Where(b => !string.IsNullOrWhiteSpace(b))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(b => b).ToList();
    var compressorUnitsByItem = invSvc?.GetCompressorUnitsGrouped()
        ?? new Dictionary<string, List<Visual_Inventory_System.Models.CompressorUnit>>();

    // TC motor tracking: CompressorUnit's sibling, but only TC comes from the
    // manufacturer (VIS never does it), so a motor model only shows up here if
    // it currently has TC stock on hand OR TC units out on loan -- a model
    // that's fully out (0 on-hand TC, some picked up) must still show, which
    // is why this isn't just "TotalThermocoupled > 0".
    var motorUnitsByItem = invSvc?.GetMotorUnitsGrouped()
        ?? new Dictionary<string, List<Visual_Inventory_System.Models.MotorUnit>>();
    var motorItems = allItems.Where(i => Visual_Inventory_System.Services.InventoryService.IsMotorType(i.Type)
            && (i.TotalThermocoupled > 0 || (motorUnitsByItem.TryGetValue(i.ItemId, out var muCheck)
                && muCheck.Any(x => x.Status != Visual_Inventory_System.Models.UnitStatus.Scrapped))))
        .OrderBy(i => i.ItemName).ToList();
    var totalTcOnHand = motorItems.Sum(i => i.TotalThermocoupled);
    var totalTcOnLoan = motorUnitsByItem.Values.SelectMany(v => v)
        .Count(x => x.Status == Visual_Inventory_System.Models.UnitStatus.PickedUp);
    var motorBrands = motorItems.Select(i => i.Brand).Where(b => !string.IsNullOrWhiteSpace(b))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(b => b).ToList();

    var recentActivity = ViewBag.RecentActivity as List<Visual_Inventory_System.Models.TransactionLog> ?? new List<Visual_Inventory_System.Models.TransactionLog>();

    // A location segment only "counts" if it's present and not the 0 placeholder.
    // Used for the map drill-down so 0-filled levels (e.g. PATS.0.0.0.0) never show.
    Func<string, bool> realSeg = s => !string.IsNullOrWhiteSpace(s) && s.Trim() != "0";

    // One rule per zone, keyed by code. Parent stores the code and the
    // FdaString always begins with it, so a single matcher covers both.
    Func<string, object> zone = code =>
    {
        var items = allItems.Where(i => i.Parent == code
            || (i.FdaString != null && i.FdaString.StartsWith(code))).ToList();
        return new
        {
            TotalRows = items.Count,
            HasAlert = items.Any(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold),
            // Majors exclude 0/blank. Each Major carries its real (non-0) Subs so the
            // menu can drill one level deeper: Parent -> Major -> Sub (hard stop; Row/Rack
            // are never their own click level).
            Majors = items.Where(i => realSeg(i.Major))
                          .GroupBy(i => i.Major)
                          .ToDictionary(g => g.Key, g => new {
                              Rows = g.Count(),
                              HasAlert = g.Any(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold),
                              Subs = g.Where(i => realSeg(i.Sub))
                                      .GroupBy(i => i.Sub)
                                      .ToDictionary(sg => sg.Key, sg => new {
                                          Rows = sg.Count(),
                                          HasAlert = sg.Any(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold)
                                      })
                          })
        };
    };

    // Pass 9 fix: built from the Locations table, not a hardcoded four. This is the
    // stats feed the map zones look themselves up in (zoneDataMap[title]). While it
    // was hardcoded, a Parent added in Settings got a rectangle from Pass 8 but no
    // entry here -- so it fell into the "empty" branch and read 0 Rows forever,
    // however much stock was actually registered into it.
    var mapData = new Dictionary<string, object>();
    foreach (var lp in (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string Code, string Name)>()))
    {
        mapData[lp.Name] = zone(lp.Code);
    }
    var mapDataJson = System.Text.Json.JsonSerializer.Serialize(mapData);

    // Coded location hierarchy (Parent -> Major -> [Subs]) built from the REAL stored
    // values, so the Location Transfer cascade always matches what's in the DB (codes,
    // e.g. ETRD -> CNEA -> CNE6) and can seed an item's current location cleanly.
    var locHierarchy = allItems
        .Where(i => realSeg(i.Parent))
        .GroupBy(i => i.Parent)
        .ToDictionary(pg => pg.Key, pg => pg
            .Where(i => realSeg(i.Major))
            .GroupBy(i => i.Major)
            .ToDictionary(mg => mg.Key, mg => mg
                .Where(i => realSeg(i.Sub))
                .Select(i => i.Sub).Distinct().OrderBy(s => s).ToList()));
    var locHierarchyJson = System.Text.Json.JsonSerializer.Serialize(locHierarchy);
    // Code -> friendly map so the client map drill can show names, not codes.
    var locDecodeJson = System.Text.Json.JsonSerializer.Serialize(Visual_Inventory_System.Services.LocationCodec.DecodeMap);
}

<style>
    /* 1. GRID COLUMN ADJUSTMENT (Sidebars expanded to 380px) */
    .overlay-grid, .selection-grid {
        position: fixed;
        top: var(--vis-header-bottom, 110px);
        bottom: 12px;
        left: 12px;
        right: 12px;
        display: grid;
        /* Widened outer tracks to 380px */
        grid-template-columns: 380px repeat(4, 1fr) 380px;
        grid-template-rows: min-content 1fr 1fr 1fr;
        gap: 16px;
        z-index: 100;
    }

