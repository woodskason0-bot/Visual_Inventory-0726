<div class="modal fade" id="modifyStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Home" asp-action="ModifyStock" method="post" id="modify-stock-frm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-tools me-2"></i>Modify Stock</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-white">
                    <div class="mb-3 position-relative">
                        <label class="form-label small fw-bold text-light-gray">Search Item</label>
                        <input type="text" id="stock-search" class="form-control" placeholder="Type ID, Rheem PN, or Name..." autocomplete="off" />
                        <div id="stock-autocomplete-list" class="list-group position-absolute w-100 shadow" style="z-index: 2000; display: none; max-height: 200px; overflow-y: auto;"></div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-light-gray">Selected Item ID</label>
                            <input type="text" name="itemId" id="stock-item-id" class="form-control text-white fw-bold" style="background-color: var(--vis-card-border);" readonly required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-light-gray">Action</label>
                            <select name="actionType" id="stock-action-type" class="form-select fw-bold text-primary" onchange="toggleStockUI()">
                                <option value="Add">Add Stock (+)</option>
                                <option value="Adjustment">Adjustment (+/-)</option>
                                <option value="Location Transfer">Location Transfer</option>
                                @if (CurrentUser.Level >= AccessLevels.Engineer)
                                {
                                    <option value="Scrap">Scrap (-)</option>
                                    <option value="Ownership">Internal - Transfer</option>
                                    <option value="Edit Details">Edit Details (PN / Desc / Brand)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- LOCATION / VARIANT picker: which physical stack this action hits.
                         Hidden for single-location items on non-Add actions (posts nothing ->
                         primary variant, old behavior). Add always shows it for the
                         "New location..." option. -->
                    <div id="stock-variant-div" class="mb-3" style="display:none;">
                        <label class="form-label small fw-bold text-light-gray">Location / Variant</label>
                        <select id="stock-variant-sel" name="targetVariant" class="form-select fw-bold text-info"></select>
                        <small class="text-light-gray d-block mt-1" style="font-size:10px;" id="stock-variant-help">Which physical stack this action applies to.</small>
                    </div>

                    <div id="stock-qty-div" class="mb-3">
                        <label class="form-label small fw-bold text-light-gray">Quantity</label>
                        <input type="number" name="quantity" id="stock-qty-input" class="form-control" value="1" required />
                        <small class="text-light-gray" id="stock-qty-help">Amount to ADD to current inventory.</small>
                    </div>

                    <!-- THERMOCOUPLED subset (motors only). One field for Add/Scrap; a
                         twin lives in the transfer move-qty row. Whichever is hidden is
                         DISABLED so exactly one "thermocoupledQty" ever posts. -->
                    <div id="stock-tc-div" class="mb-3" style="display:none;">
                        <label class="form-label small fw-bold" style="color: var(--vis-amber, #F59E0B);">
                            <i class="bi bi-thermometer-half me-1"></i>Thermocoupled
                        </label>
                        <input type="number" name="thermocoupledQty" id="stock-tc-input" class="form-control fw-bold"
                               value="0" min="0" disabled
                               style="border-color:#F59E0B;" />
                        <small class="text-light-gray d-block mt-1" style="font-size:10px;" id="stock-tc-help">How many of these are thermocoupled?</small>
                    </div>

                    <div id="stock-own-div" class="row g-2 mb-3" style="display:none;">
                        @* Pass 7B: "New Group" is gone. Its options mixed two BRANCHES
                           (Commercial, Residential) with one LINE (International, which
                           sits under Commercial Air) as if they were peers -- a flattened,
                           wrong copy of OrgStructure. Group is also derived from the
                           registering user's Line and frozen at creation, so letting a
                           transfer change it would put an item's Group at odds with its
                           own ItemId prefix.
                           Ownership now moves the thing that actually governs visibility:
                           Branch/Line. Same element ids as the old Edit Details cascade,
                           so populateEditLinePickers() drives this unchanged. *@
                        <div class="col-6">
                            <label class="form-label small fw-bold text-light-gray">Branch</label>
                            <select id="edit-line-branch" class="form-select" disabled>
                                <option value="">-- Branch --</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-light-gray">Line</label>
                            <select name="newLine" id="edit-line" class="form-select" disabled>
                                <option value="">Unassigned</option>
                            </select>
                            <small class="text-light-gray d-block mt-1" style="font-size:10px;">
                                Takes effect immediately &mdash; no transfer window. Blank = visible to everyone.
                            </small>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-light-gray">New Team</label>
                            @* Pass 7A: data-driven from the Teams table, and blank is
                               allowed -- team is optional now. The project code follows
                               whichever team is chosen, resolved server-side. *@
                            <select name="newTeam" id="edit-team" class="form-select" disabled>
                                <option value="">N/A — no team</option>
                                @foreach (var t in (List<Visual_Inventory_System.Models.Team>)(ViewBag.ActiveTeams ?? new List<Visual_Inventory_System.Models.Team>()))
                                {
                                    <option value="@t.Name">@t.Name@(string.IsNullOrWhiteSpace(t.ProjectCode) ? "" : $" ({t.ProjectCode})")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- EDIT DETAILS (Engineer+): family-level identity fields. Inputs are
                         DISABLED unless this pane is active so they never post alongside a
                         stock action. Rheem PN is unique across items (server rejects a
                         taken PN); Brand is fill-if-blank only -- an existing brand locks
                         the field. Prefilled from itemsList when the pane opens. -->
                    <div id="stock-edit-div" class="mb-3" style="display:none;">
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-light-gray">Rheem Part Number</label>
                            <div class="btn-group btn-group-sm mb-2 d-flex" role="group" aria-label="Rheem PN mode">
                                <input type="radio" class="btn-check" name="editRpnMode" id="edit-rpn-mode-real" autocomplete="off" disabled>
                                <label class="btn btn-outline-light" for="edit-rpn-mode-real">Has a Part #</label>
                                <input type="radio" class="btn-check" name="editRpnMode" id="edit-rpn-mode-na" autocomplete="off" disabled>
                                <label class="btn btn-outline-secondary" for="edit-rpn-mode-na">N/A</label>
                            </div>
                            <input type="text" name="newRheemPart" id="edit-rpn" class="form-control fw-bold" disabled placeholder="From the physical Rheem label" />
                            <small class="text-warning mt-1" style="font-size:10px; display:none;" id="edit-rpn-warn"></small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-light-gray">Description</label>
                            <input type="text" name="newDescription" id="edit-desc" class="form-control" disabled />
                        </div>
                        <div class="mb-1">
                            <label class="form-label small fw-bold text-light-gray">Brand</label>
                            <input type="text" name="newBrand" id="edit-brand" class="form-control" disabled />
                            <small class="text-light-gray d-block mt-1" style="font-size:10px;" id="edit-brand-help">Brand can only be ADDED when the item has none.</small>
                        </div>
                        @* Pass 7B: Branch/Line moved OUT of here and into Internal -
                           Transfer, where reassigning ownership belongs. Pass 3 put it
                           here because Edit Details was the only Engineer+ pane that
                           existed at the time; that made Internal - Transfer vestigial.
                           Edit Details is identity only again: PN, Description, Brand. *@
                    </div>

                    <!-- LOCATION TRANSFER: item-first. Fields start disabled, then seed from the
                         selected item's current location. 0 = unspecified at every level but Parent. -->
                    <div id="stock-loc-div" class="mb-1" style="display:none;">
                        <div class="py-2 px-3 mb-3 small rounded" style="background:#14151A; border:1px solid #3D4351; color:#94A3B8;">
                            <i class="bi bi-geo-alt me-1"></i> Current location: <span class="fw-bold text-info" id="loc-current">--</span>
                        </div>
                        <div id="loc-needs-item" class="small text-warning mb-2">
                            <i class="bi bi-info-circle me-1"></i> Select an item above to edit its location.
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-light-gray">Parent</label>
                                <select name="newParent" id="loc-parent" class="form-select" disabled>
                                    <option value="">Select Parent...</option>
                                    @* Pass 7C: from the Locations table, codes derived. *@
                                    @foreach (var lp in (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string Code, string Name)>()))
                                    {
                                        <option value="@lp.Code">@lp.Name (@lp.Code)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-light-gray">Major</label>
                                <select name="newMajor" id="loc-major" class="form-select" disabled></select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-bold text-light-gray">Sub</label>
                                <select name="newSub" id="loc-sub" class="form-select" disabled></select>
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-light-gray">Rack</label>
                                <input type="text" name="newRack" id="loc-rack" class="form-control" placeholder="0" disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-light-gray">Row</label>
                                <input type="text" name="newRow" id="loc-row" class="form-control" placeholder="0" disabled />
                            </div>
                        </div>
                        <div class="row g-2 mb-2" id="loc-moveqty-div" style="display:none;">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-light-gray">Quantity to move</label>
                                <input type="number" name="transferQty" id="loc-moveqty" class="form-control" min="1" />
                                <small class="text-light-gray d-block mt-1" style="font-size:10px;">Defaults to the whole stack. Less = split off a new variant.</small>
                            </div>
                            <!-- Transfer-context TC twin (motors only). Disabled unless a
                                 motor is being transferred, so it never double-posts with
                                 the Add/Scrap TC field above. -->
                            <div class="col-md-4" id="loc-tc-div" style="display:none;">
                                <label class="form-label small fw-bold" style="color:#F59E0B;">
                                    <i class="bi bi-thermometer-half me-1"></i>Of these, TC
                                </label>
                                <input type="number" name="thermocoupledQty" id="loc-tc-input" class="form-control fw-bold"
                                       value="0" min="0" disabled style="border-color:#F59E0B;" />
                                <small class="text-light-gray d-block mt-1" style="font-size:10px;" id="loc-tc-help">How many moved are TC?</small>
                            </div>
                            <div class="col-md-3 d-flex align-items-center">
                                <small id="loc-merge-note" class="text-warning fw-bold" style="display:none; font-size:11px;"></small>
                            </div>
                        </div>
                        <div class="p-2 mt-2 border rounded" style="background-color:#14151A; border-color:#3D4351 !important;">
                            <label class="form-label small fw-bold text-info mb-1">New FDA String</label>
                            <input type="text" id="loc-fda" class="form-control fw-bold border-0 text-white" style="background:transparent; font-size:15px;" readonly placeholder="--" />
                        </div>
                        <small class="text-light-gray d-block mt-2" style="font-size:10px;">
                            Set any level to <strong>0</strong> for "unspecified". Parent is required.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary fw-bold" onclick="executeSubmit('modify-stock-frm', this)">Execute</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD TO CART subprocess modal. One shared instance; openAddToCart(itemId)
     fills it from itemsList. Plain Bootstrap .modal -> inherits the z-index
     registry (2200 over holo overlay 2000). Posts to the same AddToCart action
     Feature 1 already used; no controller/model/migration change. -->
<div class="modal fade" id="addToCartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Home" asp-action="AddToCart" method="post" id="add-to-cart-frm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cart-plus me-2"></i>Add to Cart</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-white">
                    <input type="hidden" name="itemId" id="atc-item-id" />

                    <div class="mb-3">
                        <div class="fw-bold fs-5 text-white" id="atc-item-name">--</div>
                        <small class="text-light-gray" id="atc-item-sub">ID: --</small>
                    </div>

                    <!-- Which physical stack to pull from. Shown only when the item
                         is split across locations; single-location items post null
                         (= Either), matching the old inline behavior. -->
                    <div class="mb-3" id="atc-loc-div" style="display:none;">
                        <label class="form-label small fw-bold text-light-gray">Pull location</label>
                        <select name="requestedVariantId" id="atc-loc-sel" class="form-select fw-bold text-info"
                                style="background-color:#14151A; border-color:#3D4351;"></select>
                        <small class="text-light-gray d-block mt-1" style="font-size:10px;">Which location the runner pulls from — or Either.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-light-gray">Add Quantity</label>
                        <input type="number" name="quantity" id="atc-qty" class="form-control fw-bold" value="1" min="1" required
                               oninput="atcRecomputeTcCap();" />
                    </div>

                    <!-- Thermocoupled request (motors only). Capped at qty, live. -->
                    <div class="mb-3" id="atc-tc-div" style="display:none;">
                        <label class="form-label small fw-bold" style="color:#F59E0B;">
                            <i class="bi bi-thermometer-half me-1"></i>Thermocoupled count
                        </label>
                        <input type="number" name="thermocoupledCount" id="atc-tc" class="form-control fw-bold" value="0" min="0"
                               style="border-color:#F59E0B;" disabled
                               oninput="var m=parseInt(this.max)||0; var v=parseInt(this.value); if(isNaN(v)||v<0)v=0; if(v>m)v=m; this.value=v;" />
                        <small class="text-light-gray d-block mt-1" style="font-size:10px;">How many of these should be thermocoupled? (capped by the chosen location's TC stock)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-cart-plus me-1"></i>Add to Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modifyAlertsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Home" asp-action="UpdateAlertThreshold" method="post" id="alert-frm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-bell-fill me-2"></i>Modify Stock Alert</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-white">
                    <div class="mb-3 position-relative">
                        <label class="form-label small fw-bold text-light-gray">Search Item</label>
                        <input type="text" id="alert-search" class="form-control" placeholder="Type ID or Name..." autocomplete="off" />
                        <div id="alert-autocomplete-list" class="list-group position-absolute w-100 shadow" style="z-index: 2000; display: none; max-height: 200px; overflow-y: auto;"></div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label class="form-label small fw-bold text-light-gray">Selected Item ID</label>
                            <input type="text" name="itemId" id="alert-item-id" class="form-control text-white fw-bold" style="background-color: var(--vis-card-border);" readonly required />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-bold text-warning">Alert Threshold</label>
                            <input type="number" name="threshold" id="alert-threshold" class="form-control fw-bold text-warning" min="0" required />
                            <small class="text-light-gray d-block mt-1" style="font-size:10px;">Set to 0 to disable.</small>
                        </div>
                    </div>
                    @if (CurrentUser.Level >= AccessLevels.Management)
                    {
                        <hr class="border-secondary my-3" />
                        <div>
                            <label class="form-label small fw-bold text-warning">
                                <i class="bi bi-sliders me-1"></i>Default value for all items
                            </label>
                            <div class="d-flex gap-2 align-items-start">
                                <input type="number" id="bulk-threshold-input" class="form-control fw-bold text-warning" min="0" placeholder="e.g. 5" style="max-width: 140px;" />
                                <button type="button" class="btn btn-outline-warning fw-bold" onclick="applyBulkThreshold()">Apply to all</button>
                            </div>
                            <small class="text-light-gray d-block mt-1" style="font-size:10px;">Sets the alert threshold for every item you oversee at once.</small>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-warning fw-bold text-dark" onclick="executeSubmit('alert-frm', this)">Save Alert Rule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<form asp-controller="Home" asp-action="SetDefaultThreshold" method="post" id="bulk-threshold-frm" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="threshold" id="bulk-threshold-value" />
</form>

<div class="modal fade" id="confirmBulkThresholdModal" tabindex="-1">
