@using Visual_Inventory_System.Services
@inject Visual_Inventory_System.Services.CurrentUserService CurrentUser
@functions {
    string GetHoloTitle(Visual_Inventory_System.Models.SearchResult result)
    {
        if (result.Mode == "Omni") return $"Omni Search: \"{ViewBag.OmniSearch}\"";
        if (result.Mode == "Filter") return "Filter Search";
        return result.Mode == "Ledger" ? "Order Cart" : "Holo Viewer";
    }

    // Friendly one-line location for a variant: decode coded P/M/S, drop 0/blank
    // levels, append Rack/Row when real. Falls back to the raw FDA string.
    string FriendlyVarLoc(Visual_Inventory_System.Models.ItemVariant v)
    {
        bool Real(string? s) => !string.IsNullOrWhiteSpace(s) && s.Trim() != "0";
        var crumbs = new System.Collections.Generic.List<string>();
        if (Real(v.Parent)) crumbs.Add(Visual_Inventory_System.Services.LocationCodec.Decode(v.Parent));
        if (Real(v.Major)) crumbs.Add(Visual_Inventory_System.Services.LocationCodec.Decode(v.Major));
        if (Real(v.Sub)) crumbs.Add(Visual_Inventory_System.Services.LocationCodec.Decode(v.Sub));
        string path = string.Join(" › ", crumbs);
        string rr = "";
        if (Real(v.Rack) || Real(v.Row))
            rr = $"R{(Real(v.Rack) ? v.Rack.Trim() : "-")}/{(Real(v.Row) ? v.Row.Trim() : "-")}";
        if (path == "" && rr == "") return string.IsNullOrWhiteSpace(v.FdaString) ? "-" : v.FdaString;
        return rr == "" ? path : (path == "" ? rr : $"{path} · {rr}");
    }

    // Truncate an item name to a max number of NON-space characters, then add an ellipsis.
    string TruncName(string name, int maxNonSpace)
    {
        if (string.IsNullOrEmpty(name)) return "";
        int nonSpace = 0;
        var sb = new System.Text.StringBuilder();
        foreach (char c in name)
        {
            if (!char.IsWhiteSpace(c))
            {
                if (nonSpace == maxNonSpace) return sb.ToString().TrimEnd() + "...";
                nonSpace++;
            }
            sb.Append(c);
        }
        return sb.ToString();
    }
}

@{
    ViewData["Title"] = "Command Center";
    var result = ViewBag.SearchResult as Visual_Inventory_System.Models.SearchResult;
    bool showHolo = result != null && result.Mode != "None";
    var headerDraftIds = ViewBag.DraftItemIds as System.Collections.Generic.HashSet<string>;
    var hasDraft = headerDraftIds != null && headerDraftIds.Any();

    var invSvc = ViewBag.InventoryService as Visual_Inventory_System.Services.InventoryService;
    var allItems = invSvc?.GetAll() ?? new List<Visual_Inventory_System.Models.InventoryItem>();

    var lowStockItems = allItems.Where(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold).OrderBy(i => i.Quantity).ToList();
    var outOfStockItems = allItems.Where(i => i.Quantity == 0).OrderBy(i => i.ItemName).ToList();

    // "N/A" and blank are the same state (legacy blanks were folded into "N/A" by
    // migration) -- one check used everywhere an item's PN status matters.
    Func<string, bool> needsRheemPn = pn => string.IsNullOrWhiteSpace(pn) || pn.Trim().Equals("N/A", StringComparison.OrdinalIgnoreCase);
    var pnBacklogItems = allItems.Where(i => needsRheemPn(i.RheemPartNumber)).OrderBy(i => i.ItemName).ToList();

    // Compressor mini-variant tracking: models you can see (Line-filtered,
    // same as allItems above), each with whatever lab/serial units have been
    // logged at pickup so far. Forward-only log -- starts empty per model.
    var compressorItems = allItems.Where(i => Visual_Inventory_System.Services.InventoryService.IsCompressorType(i.Type))
        .OrderBy(i => i.ItemName).ToList();
    var compressorBrands = compressorItems.Select(i => i.Brand).Where(b => !string.IsNullOrWhiteSpace(b))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(b => b).ToList();
    var compressorUnitsByItem = invSvc?.GetCompressorUnitsGrouped()
        ?? new Dictionary<string, List<Visual_Inventory_System.Models.CompressorUnit>>();

    // TC motor tracking: CompressorUnit's sibling, but only TC comes from the
    // manufacturer (VIS never does it), so a motor model only shows up here if
    // it currently has TC stock on hand OR TC units out on loan -- a model
    // that's fully out (0 on-hand TC, some picked up) must still show, which
    // is why this isn't just "TotalThermocoupled > 0".
    var motorUnitsByItem = invSvc?.GetMotorUnitsGrouped()
        ?? new Dictionary<string, List<Visual_Inventory_System.Models.MotorUnit>>();
    var motorItems = allItems.Where(i => Visual_Inventory_System.Services.InventoryService.IsMotorType(i.Type)
            && (i.TotalThermocoupled > 0 || (motorUnitsByItem.TryGetValue(i.ItemId, out var muCheck)
                && muCheck.Any(x => x.Status != Visual_Inventory_System.Models.UnitStatus.Scrapped))))
        .OrderBy(i => i.ItemName).ToList();
    var totalTcOnHand = motorItems.Sum(i => i.TotalThermocoupled);
    var totalTcOnLoan = motorUnitsByItem.Values.SelectMany(v => v)
        .Count(x => x.Status == Visual_Inventory_System.Models.UnitStatus.PickedUp);
    var motorBrands = motorItems.Select(i => i.Brand).Where(b => !string.IsNullOrWhiteSpace(b))
        .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(b => b).ToList();

    var recentActivity = ViewBag.RecentActivity as List<Visual_Inventory_System.Models.TransactionLog> ?? new List<Visual_Inventory_System.Models.TransactionLog>();

    // A location segment only "counts" if it's present and not the 0 placeholder.
    // Used for the map drill-down so 0-filled levels (e.g. PATS.0.0.0.0) never show.
    Func<string, bool> realSeg = s => !string.IsNullOrWhiteSpace(s) && s.Trim() != "0";

    // One rule per zone, keyed by code. Parent stores the code and the
    // FdaString always begins with it, so a single matcher covers both.
    Func<string, object> zone = code =>
    {
        var items = allItems.Where(i => i.Parent == code
            || (i.FdaString != null && i.FdaString.StartsWith(code))).ToList();
        return new
        {
            TotalRows = items.Count,
            HasAlert = items.Any(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold),
            // Majors exclude 0/blank. Each Major carries its real (non-0) Subs so the
            // menu can drill one level deeper: Parent -> Major -> Sub (hard stop; Row/Rack
            // are never their own click level).
            Majors = items.Where(i => realSeg(i.Major))
                          .GroupBy(i => i.Major)
                          .ToDictionary(g => g.Key, g => new {
                              Rows = g.Count(),
                              HasAlert = g.Any(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold),
                              Subs = g.Where(i => realSeg(i.Sub))
                                      .GroupBy(i => i.Sub)
                                      .ToDictionary(sg => sg.Key, sg => new {
                                          Rows = sg.Count(),
                                          HasAlert = sg.Any(i => i.AlertThreshold > 0 && i.Quantity <= i.AlertThreshold)
                                      })
                          })
        };
    };

    // Pass 9 fix: built from the Locations table, not a hardcoded four. This is the
    // stats feed the map zones look themselves up in (zoneDataMap[title]). While it
    // was hardcoded, a Parent added in Settings got a rectangle from Pass 8 but no
    // entry here -- so it fell into the "empty" branch and read 0 Rows forever,
    // however much stock was actually registered into it.
    var mapData = new Dictionary<string, object>();
    foreach (var lp in (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string Code, string Name)>()))
    {
        mapData[lp.Name] = zone(lp.Code);
    }
    var mapDataJson = System.Text.Json.JsonSerializer.Serialize(mapData);

    // Coded location hierarchy (Parent -> Major -> [Subs]), straight from the
    // Locations table (same source as BuildLocationTree()/locMap below) so the
    // Location Transfer cascade shows every real location immediately, not
    // just ones that already have stock in them. Used to be built by walking
    // allItems' already-stored codes instead -- which meant a Sub added in
    // Settings couldn't be picked as a transfer destination until something
    // was already stored there.
    var locHierarchyJson = ViewBag.LocationHierarchyCodedJson as string ?? "{}";
    // Code -> friendly map so the client map drill can show names, not codes.
    var locDecodeJson = System.Text.Json.JsonSerializer.Serialize(Visual_Inventory_System.Services.LocationCodec.DecodeMap);
}

<style>
    /* 1. GRID COLUMN ADJUSTMENT (Sidebars expanded to 380px) */
    .overlay-grid, .selection-grid {
        position: fixed;
        top: var(--vis-header-bottom, 110px);
        bottom: 12px;
        left: 12px;
        right: 12px;
        display: grid;
        /* Widened outer tracks to 380px */
        grid-template-columns: 380px repeat(4, 1fr) 380px;
        grid-template-rows: min-content 1fr 1fr 1fr;
        gap: 16px;
        z-index: 100;
    }

    /* Being position:fixed, these never noticed the app shell's own sidebar
       (Pass 27) -- left:12px measured from the viewport edge regardless of
       whether the 240px rail, the 68px collapsed rail, or nothing (mobile
       off-canvas) sat there, so the grid's left edge sat under the sidebar
       instead of beside it, unchanged by collapse/expand. Only real above
       the 992px breakpoint where the sidebar is the persistent rail, not an
       off-canvas drawer; --vis-sidebar-width is kept current by
       site.js (applySidebarWidthVar), same pattern --vis-header-bottom
       already uses for syncHeaderOffset(). */
    @@media (min-width: 992px) {
        .overlay-grid, .selection-grid {
            left: calc(var(--vis-sidebar-width, 240px) + 12px);
            transition: left 0.2s ease;
        }
    }

        /* Force specific cell coordinates to persist even if external styles compete */
        .overlay-grid .r1 {
            grid-row-start: 1 !important;
        }

        .overlay-grid .r2 {
            grid-row-start: 2 !important;
        }

        .overlay-grid .r3 {
            grid-row-start: 3 !important;
        }

        .overlay-grid .r4 {
            grid-row-start: 4 !important;
        }

        .overlay-grid .c1 {
            grid-column-start: 1 !important;
        }

        .overlay-grid .c2 {
            grid-column-start: 2 !important;
        }

        .overlay-grid .c3 {
            grid-column-start: 3 !important;
        }

        .overlay-grid .c4 {
            grid-column-start: 4 !important;
        }

        .overlay-grid .c5 {
            grid-column-start: 5 !important;
        }

        .overlay-grid .c6 {
            grid-column-start: 6 !important;
        }

    /* Completely hide the background diagnostic guide grid */
    .selection-grid {
        display: none !important;
    }

    .selection-cell {
        border: 1px dashed rgba(245, 166, 35, 0.15) !important;
        background: rgba(245, 166, 35, 0.01);
        color: rgba(255, 255, 255, 0.15);
        font-size: 13px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* 2. HOLO VIEW MODAL & BACKDROP CORRECTIONS */
    .holo-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(10, 11, 14, 0.85);
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
    }

    /* Bootstrap modals must sit ABOVE the holo overlay (z-index 2000),
       otherwise modals opened from inside the cart view are hidden behind it. */
    .modal {
        z-index: 2200 !important;
    }

    .modal-backdrop {
        z-index: 2150 !important;
    }

    .holo-viewer {
        display: grid;
        grid-template-columns: 1fr 280px !important;
        grid-template-rows: auto 1fr;
        width: 80vw !important;
        max-width: 1200px;
        height: 80vh !important;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
    }

    .holo-header {
        grid-column: 1 / span 2 !important;
        grid-row: 1 !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        background: var(--vis-card);
        border-bottom: 2px solid var(--vis-card-border);
    }

    .holo-body {
        grid-column: 1 !important;
        grid-row: 2 !important;
        overflow-y: auto !important; /* Enable list scrolling inside modal container */
        padding: 24px;
        background: var(--vis-bg);
    }

    .holo-actions {
        grid-column: 2 !important;
        grid-row: 2 !important;
        padding: 24px;
        background: var(--vis-card);
        border-left: 1px solid var(--vis-card-border);
        display: flex;
        flex-direction: column;
    }

    /* 3. MAP OVERLAYS (PORTED TO CORRESPOND TO MAP CONTAINER HEIGHT) */
    .map-stats-bar {
        position: absolute;
        bottom: 45px;
        left: 15px;
        right: 15px;
        background: rgba(28, 30, 36, 0.95);
        backdrop-filter: blur(5px);
        border: 1px solid var(--vis-card-border);
        border-radius: 8px;
        padding: 12px 20px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
        align-items: center;
        gap: 8px 16px;
        z-index: 110;
        box-shadow: 0 10px 20px rgba(0,0,0,0.6);
    }

        /* .map-container has overflow:visible on purpose (so the zone
           click-menus can pop out past its edge) -- which means this bar's
           4 stat-blocks, unable to shrink below their natural content width,
           silently bled past the container and widened the WHOLE PAGE on
           narrow screens instead of just looking cramped. flex-wrap above
           is the real fix (has zero effect wherever 4 already fit on one
           line); this just keeps the wrapped pairs from touching. */
        .map-stats-bar .stat-block {
            flex: 0 1 auto;
        }

    .map-live-bar {
        position: absolute;
        bottom: 12px;
        left: 20px;
        right: 20px;
        font-size: 13px;
        color: #E2E8F0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        z-index: 110;
    }

    /* 4. MODAL HIGH CONTRAST DARK OVERRIDES */
    .modal-content label {
        color: #E2E8F0 !important; /* Highly visible silver-white */
        font-weight: 600 !important;
    }

    /* Ensures both Bootstrap modal subtexts and the Export Wizard card description are visible */
    .modal-content .text-light-gray,
    .modal-content .text-muted,
    .grid-card .text-muted {
        color: #94A3B8 !important; /* Brightened visible slate-gray */
    }

    .modal-content input,
    .modal-content select,
    .modal-content select option {
        background-color: #14151A !important;
        color: #FFFFFF !important;
        border-color: #3D4351 !important;
    }

    /* Utility text overrides */
    .text-light-gray {
        color: #CBD5E1 !important;
    }

    .text-bright-white {
        color: #FFFFFF !important;
    }
    /* =========================================================
                   MAP INTERACTIVE ZONE & CASCADING MENU STYLES
                   ========================================================= */

    /* 1. The main absolute wrapper for each map coordinate zone */
    .map-zone {
        position: absolute;
        z-index: 120;
        pointer-events: auto; /* Re-enables clicks over the transparent overlay */
        box-sizing: border-box;
        border: 2px solid var(--vis-yellow);
        border-radius: 4px;
        background: rgba(245, 166, 35, 0.10);
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.35), 0 0 12px rgba(245,166,35,0.15);
        transition: background 0.18s ease, box-shadow 0.18s ease;
    }

        .map-zone:hover {
            background: rgba(245, 166, 35, 0.22);
            box-shadow: inset 0 0 0 1px rgba(0,0,0,0.35), 0 0 18px rgba(245,166,35,0.35);
        }

        /* Zones holding a low-stock item glow red instead of yellow */
        .map-zone.alert-zone {
            border-color: var(--vis-red);
            background: rgba(216, 43, 51, 0.12);
            box-shadow: inset 0 0 0 1px rgba(0,0,0,0.35), 0 0 14px rgba(216,43,51,0.30);
        }

            .map-zone.alert-zone:hover {
                background: rgba(216, 43, 51, 0.22);
            }

        /* Elevates the active popup container to float above adjacent map tags */
        .map-zone.active-zone {
            z-index: 1500 !important;
        }

    /* 2. The interactive pulsing map pin */
    .zone-marker {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--vis-yellow);
        background: rgba(17, 18, 22, 0.85);
        backdrop-filter: blur(3px);
        border: 1px solid var(--vis-yellow);
        padding: 4px 8px;
        border-radius: 6px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }

        .zone-marker:hover {
            transform: scale(1.1);
            box-shadow: 0 0 15px rgba(245, 166, 35, 0.6);
            z-index: 130;
        }

    .marker-icon {
        font-size: 18px;
        line-height: 1;
    }

    .marker-count {
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
        margin-top: 2px;
        /* Hidden at rest -- the pin alone marks the zone; the row count only
           appears while the zone is hovered, keeping the map uncluttered. */
        display: none;
    }

    .map-zone:hover .marker-count {
        display: block;
    }

    /* Pulsing animation for zones with active alerts */
    .alert-pulse {
        border-color: var(--vis-red) !important;
        color: var(--vis-red) !important;
        animation: pulse-border 2s infinite;
    }

    @@keyframes pulse-border {
        0% {
            box-shadow: 0 0 0 0 rgba(216, 43, 51, 0.4);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(216, 43, 51, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(216, 43, 51, 0);
        }
    }

    /* 3. The Cascading Location Dropdown Menu (Hidden by default) */
    .zone-menu {
        display: none; /* Keep hidden until clicked */
        position: absolute;
        min-width: 220px;
        background: rgba(28, 30, 36, 0.98);
        backdrop-filter: blur(10px);
        border: 1px solid var(--vis-card-border);
        border-radius: 8px;
        padding: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.7);
        z-index: 1000;
        flex-direction: column;
        gap: 6px;
    }

        /* Display flex when toggled active via JS */
        .zone-menu.show {
            display: flex !important;
        }

    .zone-menu-header {
        font-size: 11px;
        font-weight: 800;
        color: var(--vis-yellow);
        text-transform: uppercase;
        padding: 6px 12px;
        border-bottom: 1px solid var(--vis-card-border);
        margin-bottom: 4px;
        letter-spacing: 0.5px;
    }

    /* Buttons inside the dropdown menus */
    .zone-menu-btn {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 8px 12px;
        background: #14151A;
        border: 1px solid #2D3139;
        color: #E2E8F0;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-align: left;
        transition: all 0.2s ease;
    }

        .zone-menu-btn:hover {
            background: #2A2D35;
            border-color: #3D4351;
            color: #FFFFFF;
        }

        .zone-menu-btn .badge {
            font-size: 10px;
            background-color: #3A3F4B !important;
            color: #CBD5E1 !important;
        }

    /* Cascading menu placement offsets calculated by JS positioning classes */
    .zone-menu.menu-down {
        top: 100%;
        margin-top: 8px;
    }

    .zone-menu.menu-up {
        bottom: 100%;
        margin-bottom: 8px;
    }

    .zone-menu.menu-left {
        right: 0;
    }

    .zone-menu.menu-right {
        left: 0;
    }

    .zone-menu.menu-center {
        left: 50%;
        transform: translateX(-50%);
    }

    /* Map drill: a Major that has real (non-0) Subs becomes an expandable group.
       The nested list lives inside .zone-menu (z-index 1000, under holo overlay 2000),
       so no new stacking context is introduced. */
    .zone-major-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .zone-submenu {
        display: none;
        flex-direction: column;
        gap: 6px;
        margin: 0 0 2px 8px;
        padding-left: 10px;
        border-left: 2px solid var(--vis-yellow);
    }

        .zone-major-group.open > .zone-submenu {
            display: flex;
        }

    .zone-subbtn {
        background: #0F1014;
        font-weight: 500;
    }

    .zone-chev {
        font-size: 10px;
        transition: transform 0.18s ease;
        margin-left: 6px;
    }

        .zone-major-group.open .zone-chev {
            transform: rotate(180deg);
        }

    /* Activity Feed Vertical Timeline Structure */
    .activity-feed {
        border-left: 2px solid var(--vis-card-border);
        margin-left: 10px;
        padding-left: 15px;
        position: relative;
    }

    .activity-item {
        position: relative;
        margin-bottom: 12px;
    }

    .activity-dot {
        position: absolute;
        left: -21px; /* Center dot over the timeline line perfectly */
        top: 4px;
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    /* =========================================================
       RESPONSIVE (Pass 24)
       The dashboard above is a fixed 6-column CSS grid (two 380px
       sidebars) inside a position:fixed shell with no breakpoints
       anywhere in the app -- below ~1400px combined width it
       overflows horizontally with no way to scroll to reach the
       clipped columns. These queries reflow the SAME markup (no
       DOM changes, no reordering) into a single scrollable column
       at tablet/phone widths, by neutralizing the !important
       r*/c*/row-span-*/col-span-* placement utilities above (the
       override needs !important too, and has to come after them
       in the cascade to win) and letting flexbox stack the grid
       items in document order instead.
       ========================================================= */
    @@media (max-width: 1400px) {
        .overlay-grid {
            grid-template-columns: 300px repeat(4, 1fr) 300px;
        }
    }

    @@media (max-width: 1100px) {
        .overlay-grid {
            position: static !important;
            display: flex !important;
            flex-direction: column;
            height: auto;
            margin: 12px;
            padding-bottom: 24px;
            gap: 12px;
        }

            .overlay-grid .r1, .overlay-grid .r2, .overlay-grid .r3, .overlay-grid .r4 {
                grid-row-start: unset !important;
            }

            .overlay-grid .c1, .overlay-grid .c2, .overlay-grid .c3,
            .overlay-grid .c4, .overlay-grid .c5, .overlay-grid .c6 {
                grid-column-start: unset !important;
            }

            .overlay-grid .row-span-2, .overlay-grid .row-span-3 {
                grid-row-end: unset !important;
            }

            .overlay-grid .col-span-2, .overlay-grid .col-span-4 {
                grid-column-end: unset !important;
            }

        .map-container {
            min-height: 380px;
        }
    }

    @@media (max-width: 900px) {
        .holo-viewer {
            width: 95vw !important;
            height: 90vh !important;
            grid-template-columns: 1fr !important;
            grid-template-rows: auto 1fr auto !important;
        }

            .holo-viewer .holo-header {
                grid-column: 1 !important;
            }

            .holo-viewer .holo-body {
                grid-column: 1 !important;
                grid-row: 2 !important;
            }

            .holo-viewer .holo-actions {
                grid-column: 1 !important;
                grid-row: 3 !important;
                border-left: none;
                border-top: 1px solid var(--vis-card-border);
            }
    }

    @@media (max-width: 576px) {
        .overlay-grid {
            margin: 8px;
        }

        .map-container {
            min-height: 300px;
        }
    }
</style>


