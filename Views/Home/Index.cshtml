        function compApplyFilter() {
            const unclaimedOnly = document.getElementById('compFilterUnclaimed')?.checked;
            const branch = document.getElementById('compFilterBranch')?.value || '';
            const line = document.getElementById('compFilterLine')?.value || '';
            const team = document.getElementById('compFilterTeam')?.value || '';
            const brand = document.getElementById('compFilterBrand')?.value || '';
            const rows = document.querySelectorAll('#compressorRegistryModal .comp-row');
            let shown = 0;
            rows.forEach(function (row) {
                let visible = true;
                if (unclaimedOnly && row.dataset.unclaimed !== '1') visible = false;
                if (branch && row.dataset.branch !== branch) visible = false;
                if (line && row.dataset.line !== line) visible = false;
                if (team && row.dataset.team !== team) visible = false;
                if (brand && row.dataset.brand !== brand) visible = false;
                row.style.display = visible ? '' : 'none';
