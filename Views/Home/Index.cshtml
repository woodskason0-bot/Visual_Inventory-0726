        const motorFilterBranchEl = document.getElementById('motorFilterBranch');
        const motorFilterLineEl = document.getElementById('motorFilterLine');
        wireLineCascade(motorFilterBranchEl, motorFilterLineEl, motorApplyFilter, 'All Branches', 'All Lines');
        const motorFilterTeamEl = document.getElementById('motorFilterTeam');
        if (motorFilterTeamEl) {
            motorFilterTeamEl.addEventListener('change', function () {
