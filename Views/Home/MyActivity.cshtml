@model Visual_Inventory_System.Models.ViewModels.MyActivityViewModel
@{
    ViewData["Title"] = "My Activity";
}

<style>
    /* Theme-aware (uses --vis-* so it flips with the toggle -- no hardcoded white). */
    .mo-wrap { max-width: 1100px; margin: 1.5rem auto; }
    .mo-card {
        background-color: var(--vis-card);
        border: 1px solid var(--vis-card-border);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
    }
    .mo-h { color: var(--vis-text); font-weight: 700; }
    /* Was inline color:#F59E0B (--vis-yellow). Fine on dark, ~2.15:1 on the
       light theme's white card (found live testing 2d.1) -- --vis-yellow is
       a brand accent, deliberately unchanged between themes (see site.css),
       so this needs its own light-mode override rather than just reaching
       for the variable. */
    .mo-outstanding { color: var(--vis-yellow); }

    :root[data-theme="light"] .mo-outstanding { color: #8A6100; }
    .mo-sub { color: var(--vis-text-muted); }
    .mo-table { width: 100%; color: var(--vis-text); }
    .mo-table th { color: var(--vis-text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--vis-card-border); padding: 8px 10px; text-align: left; }
    .mo-table td { border-bottom: 1px solid var(--vis-card-border); padding: 10px; vertical-align: middle; }
    .mo-input {
        background: var(--vis-bg); color: var(--vis-text);
        border: 1px solid var(--vis-card-border); border-radius: 6px;
        padding: 4px 8px;
    }
    .mo-input:focus { outline: none; border-color: var(--vis-blue); }
    .loan-line { border: 1px solid var(--vis-card-border); border-radius: 8px; padding: 1rem 1.15rem; margin-bottom: 1rem; }
    .loan-ctx { color: var(--vis-text-muted); font-size: 12px; }
    .tc-tag { color: #F59E0B; font-weight: 700; }
    .mo-empty { color: var(--vis-text-muted); text-align: center; padding: 1.5rem; }
    .new-loc-row { display: none; }
</style>

<div class="mo-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <h2 class="mo-h mb-1"><i class="bi bi-activity me-2 text-primary"></i>My Activity</h2>
    <div class="mo-sub mb-4">Signed in as <strong>@Model.UserName</strong> — this page shows only your own orders, loans, and internal transfers.</div>

    <!-- SECTION 2 first: action lives here (things you owe back). -->
    <div class="mo-card">
        <h4 class="mo-h mb-1"><i class="bi bi-arrow-return-left me-2" style="color:#F59E0B;"></i>Items Out on Loan</h4>
        <div class="mo-sub mb-3">Loanable stock you've picked up and still owe back — Controls, and the thermocoupled motors. Return puts stock back; Scrap writes it off.</div>

        @if (!Model.Loans.Any())
        {
            <div class="mo-empty">Nothing out on loan. You're all square.</div>
        }
        else
        {
            @foreach (var loan in Model.Loans)
            {
                <div class="loan-line">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <span class="mo-h">@loan.ItemName</span>
                            <span class="mo-sub">(@loan.ItemId@(string.IsNullOrWhiteSpace(loan.RheemPartNumber) ? "" : $" · PN {loan.RheemPartNumber}"))</span>
                            @if (loan.ReturnsAsTc)
                            {
                                <span class="tc-tag ms-2"><i class="bi bi-thermometer-half"></i> TC</span>
                            }
                            <div class="loan-ctx mt-1">
                                <i class="bi bi-hash"></i>Order #@loan.OrderId
                                · ordered @loan.OrderedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                @if (!string.IsNullOrWhiteSpace(loan.Description))
                                {
                                    <text> · @loan.Description</text>
                                }
                            </div>
                        </div>
                        <div class="text-end">
                            @* A compressor is normally CONSUMED, so "still out" would
                               misdescribe it -- the counter means "not yet dispositioned". *@
                            <div class="mo-sub" style="font-size:11px;">@(loan.IsCompressor ? "In use" : "Still out")</div>
                            <div class="mo-h mo-outstanding" style="font-size:1.5rem;">@loan.Outstanding</div>
                        </div>
                    </div>

                    @* ---- Pass 6B: compressors hide Return/Scrap behind Done Using.
                         Nobody one-clicks a scrap by accident, and a line nobody has
                         finished with stays visually quiet. ---- *@
                    @if (loan.IsCompressor)
                    {
                        <div class="mt-3" id="gate-@loan.OrderItemId">
                            <button type="button" class="btn btn-outline-warning fw-bold"
                                    onclick="doneUsing(@loan.OrderItemId)">
                                <i class="bi bi-check2-circle me-1"></i>Done Using
                            </button>
                            <span class="loan-ctx ms-2">Then choose Return or Scrap.</span>
                        </div>

                        @if (loan.Units.Any() || loan.UnidentifiedCount > 0)
                        {
                            <div class="mt-3 disp-@loan.OrderItemId" style="display:none;">
                                <div class="mo-sub" style="font-size:11px;">Which units?</div>
                                @* Deliberately NOT inside either form. Both Return and Scrap
                                   read these on submit (see syncUnits) so one tick list drives
                                   whichever action is taken -- otherwise scrap would silently
                                   write off every unit regardless of what was ticked. *@
                                @foreach (var cu in loan.Units)
                                {
                                    <label class="d-block loan-ctx" style="color:var(--vis-text);">
                                        <input type="checkbox" class="unitbox-@loan.OrderItemId"
                                               value="@cu.Id" checked />
                                        <span class="ms-1">@(string.IsNullOrWhiteSpace(cu.SerialNumber) ? "(no serial)" : cu.SerialNumber)</span>
                                        @if (!string.IsNullOrWhiteSpace(cu.LabNumber))
                                        {
                                            <span class="mo-sub ms-2">Lab @cu.LabNumber</span>
                                        }
                                    </label>
                                }
                                @if (loan.UnidentifiedCount > 0)
                                {
                                    <div class="loan-ctx mt-1">
                                        <i class="bi bi-question-circle me-1"></i>@loan.UnidentifiedCount with no serial on record —
                                        counted by quantity only.
                                    </div>
                                }
                            </div>
                        }
                    }

                    <!-- RETURN: adds stock back at a chosen active location, or a new one. -->
                    <form asp-controller="Home" asp-action="ReturnLoan" method="post"
                          class="mt-3 @(loan.IsCompressor ? "disp-" + loan.OrderItemId : "")"
                          style="@(loan.IsCompressor ? "display:none;" : "")"
                          onsubmit="return syncUnits(this, @loan.OrderItemId);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderItemId" value="@loan.OrderItemId" />
                        <div class="d-flex align-items-end flex-wrap gap-2">
                            <div>
                                <label class="mo-sub d-block" style="font-size:11px;">Return qty</label>
                                <input type="number" name="qty" value="@loan.Outstanding" min="1" max="@loan.Outstanding" class="mo-input" style="width:80px;" />
                            </div>
                            <div>
                                <label class="mo-sub d-block" style="font-size:11px;">Back to location</label>
                                <select name="targetVariantId" class="mo-input" style="min-width:230px;"
                                        data-oiid="@loan.OrderItemId"
                                        onchange="toggleReturnLoc(this, @loan.OrderItemId)">
                                    @foreach (var c in loan.LocationChoices)
                                    {
                                        <option value="@c.VariantId">@c.Label</option>
                                    }
                                    <option value="">＋ New location…</option>
                                </select>
                            </div>
                            <div class="flex-grow-1" style="min-width:180px;">
                                <label class="mo-sub d-block" style="font-size:11px;">Reason (optional)</label>
                                <input type="text" name="reason" maxlength="200" class="mo-input w-100"
                                       placeholder="e.g. wrong compressor, unused" />
                            </div>
                            <button type="submit" class="btn btn-success fw-bold">Return · Execute</button>
                        </div>

                        <!-- New-location fields (lightweight): Parent dropdown + coded text.
                             Blank levels store as "0". Shown only when "New location" chosen. -->
                        <div class="new-loc-row mt-2" id="newloc-@loan.OrderItemId">
                            <div class="d-flex flex-wrap gap-2">
                                @* Pass 7C: from the Locations table -- this list and the one in
                                   Index.cshtml used to be maintained by hand, in two places, with
                                   the codes typed out. *@
                                <select name="newParent" class="mo-input">
                                    <option value="">Parent…</option>
                                    @foreach (var lp in (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string Code, string Name)>()))
                                    {
                                        <option value="@lp.Code">@lp.Name (@lp.Code)</option>
                                    }
                                </select>
                                <input type="text" name="newMajor" placeholder="Major" class="mo-input" style="width:100px;" />
                                <input type="text" name="newSub" placeholder="Sub" class="mo-input" style="width:100px;" />
                                <input type="text" name="newRack" placeholder="Rack" class="mo-input" style="width:90px;" />
                                <input type="text" name="newRow" placeholder="Row" class="mo-input" style="width:90px;" />
                            </div>
                            <div class="loan-ctx mt-1">Leave a level blank for "unspecified" (stored as 0). Parent recommended.</div>
                        </div>
                    </form>

                    <!-- SCRAP: writes the loaned units off; no stock returns. -->
                    <form asp-controller="Home" asp-action="ScrapLoan" method="post"
                          class="mt-2 @(loan.IsCompressor ? "disp-" + loan.OrderItemId : "")"
                          style="@(loan.IsCompressor ? "display:none;" : "")"
                          onsubmit="return syncUnits(this, @loan.OrderItemId);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderItemId" value="@loan.OrderItemId" />
                        <div class="d-flex align-items-end gap-2 flex-wrap">
                            <div>
                                <label class="mo-sub d-block" style="font-size:11px;">Scrap qty</label>
                                <input type="number" name="qty" value="@(loan.IsCompressor ? loan.Outstanding : 1)"
                                       min="1" max="@loan.Outstanding" class="mo-input" style="width:80px;" />
                            </div>
                            <div class="flex-grow-1" style="min-width:180px;">
                                <label class="mo-sub d-block" style="font-size:11px;">Reason (optional)</label>
                                <input type="text" name="reason" maxlength="200" class="mo-input w-100"
                                       placeholder="e.g. failed in test, damaged" />
                            </div>
                            <button type="submit" class="btn btn-outline-danger fw-bold">Scrap · Execute</button>
                        </div>
                    </form>
                </div>
            }
        }
    </div>

    <!-- INTERNAL TRANSFERS (Pass 30, corrected same day after live testing --
         no due date, no return flow: a transferred unit doesn't come back in
         practice, same as how a picked-up compressor already stays "Picked Up"
         forever. One approval, then done.) MyRequests = requests I placed
         against another Line's item, full history; AwaitingApproval = requests
         against items my own Line/Team owns -- the approval queue lives right
         here, not on a separate page. -->
    <div class="mo-card">
        <h4 class="mo-h mb-1"><i class="bi bi-arrow-left-right me-2" style="color:#F59E0B;"></i>Internal Transfers</h4>
        <div class="mo-sub mb-3">Cross-Line stock moves -- one-way, one approval. Once approved, it's gone from the lending Line's shelf for good.</div>

        <h6 class="mo-h mb-2" style="font-size:14px;">My Requests</h6>
        @if (!Model.Transfer.MyRequests.Any())
        {
            <div class="mo-empty">You haven't requested a transfer.</div>
        }
        else
        {
            @foreach (var b in Model.Transfer.MyRequests)
            {
                <div class="loan-line">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <span class="mo-h">@b.ItemName</span>
                            <span class="mo-sub">(@b.ItemId@(string.IsNullOrWhiteSpace(b.RheemPartNumber) ? "" : $" · PN {b.RheemPartNumber}"))</span>
                            @if (b.ThermocoupledCount > 0)
                            {
                                <span class="tc-tag ms-2"><i class="bi bi-thermometer-half"></i> TC</span>
                            }
                            <div class="loan-ctx mt-1">
                                <i class="bi bi-hash"></i>Transfer #@b.Id · requested @b.RequestedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                @if (!string.IsNullOrWhiteSpace(b.ResolvedLocationLabel)) { <text> · @b.ResolvedLocationLabel</text> }
                                @if (!string.IsNullOrWhiteSpace(b.Note)) { <text> · "@b.Note"</text> }
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="mo-sub" style="font-size:11px;">Qty</div>
                            <div class="mo-h mo-outstanding" style="font-size:1.5rem;">@b.Quantity</div>
                        </div>
                    </div>

                    <div class="mt-2">
                        @if (b.Status == "Requested")
                        {
                            <span class="badge bg-warning text-dark">Awaiting approval</span>
                        }
                        else if (b.Status == "Approved")
                        {
                            <span class="badge bg-success">Approved</span>
                            <span class="loan-ctx ms-2">by @b.DecidedBy on @b.DecidedAt!.Value.ToLocalTime().ToString("MMM d, yyyy")</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Denied</span>
                            <span class="loan-ctx ms-2">by @b.DecidedBy on @b.DecidedAt!.Value.ToLocalTime().ToString("MMM d, yyyy")</span>
                        }
                    </div>
                </div>
            }
        }

        <h6 class="mo-h mb-2 mt-4" style="font-size:14px;">Awaiting My Approval</h6>
        @if (!Model.Transfer.AwaitingApproval.Any())
        {
            <div class="mo-empty">Nothing waiting on your Line right now.</div>
        }
        else
        {
            @foreach (var b in Model.Transfer.AwaitingApproval)
            {
                <div class="loan-line">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <span class="mo-h">@b.ItemName</span>
                            <span class="mo-sub">(@b.ItemId@(string.IsNullOrWhiteSpace(b.RheemPartNumber) ? "" : $" · PN {b.RheemPartNumber}"))</span>
                            @if (b.ThermocoupledCount > 0)
                            {
                                <span class="tc-tag ms-2"><i class="bi bi-thermometer-half"></i> TC</span>
                            }
                            <div class="loan-ctx mt-1">
                                <i class="bi bi-person me-1"></i>Requested by @b.RequesterUserName · Transfer #@b.Id · @b.RequestedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                @if (!string.IsNullOrWhiteSpace(b.Note)) { <text> · "@b.Note"</text> }
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="mo-sub" style="font-size:11px;">Qty</div>
                            <div class="mo-h mo-outstanding" style="font-size:1.5rem;">@b.Quantity</div>
                        </div>
                    </div>

                    <div class="loan-ctx mt-1">
                        @(string.IsNullOrWhiteSpace(b.ResolvedLocationLabel) ? "No location preference" : $"Prefers {b.ResolvedLocationLabel}")
                    </div>

                    <form asp-controller="Home" asp-action="ApproveTransfer" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transferRequestId" value="@b.Id" />

                        @if (b.IsCompressor)
                        {
                            var allOnHand = b.LocationChoices.SelectMany(c => c.OnHandUnits).ToList();
                            <div class="mb-2">
                                <span class="d-block mb-1 mo-sub" style="font-size:11px;">Serial # -- pick from what's on hand, or add one</span>
                                @for (int u = 0; u < b.Quantity; u++)
                                {
                                    <div class="d-flex gap-1 mb-1" style="max-width:420px;">
                                        <input type="text" name="compLab_@u" class="mo-input" placeholder="Lab # (unit @(u + 1))" style="max-width:110px;" />
                                        <select name="compSerial_@u" class="mo-input transfer-serial-select" style="max-width:170px;" onchange="toggleTransferManual(this)">
                                            <option value="">-- none / unrecorded --</option>
                                            @foreach (var oh in allOnHand)
                                            {
                                                <option value="@oh.SerialNumber">@oh.SerialNumber@(string.IsNullOrWhiteSpace(oh.LabNumber) ? "" : $" (Lab {oh.LabNumber})")</option>
                                            }
                                            <option value="__ADD__">+ Add a serial not listed</option>
                                        </select>
                                        <input type="text" name="compSerialManual_@u" class="mo-input comp-serial-manual d-none" placeholder="Type serial" style="max-width:140px;" />
                                    </div>
                                }
                            </div>
                        }

                        <button type="submit" class="btn btn-success fw-bold">Approve</button>
                    </form>
                    <form asp-controller="Home" asp-action="DenyTransfer" method="post" class="d-inline-block mt-2 ms-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="transferRequestId" value="@b.Id" />
                        <button type="submit" class="btn btn-outline-danger fw-bold">Deny</button>
                    </form>
                </div>
            }
        }
    </div>

    <!-- SECTION 1: my order history. -->
    <div class="mo-card">
        <h4 class="mo-h mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>My Order History</h4>
        @if (!Model.Orders.Any())
        {
            <div class="mo-empty">You haven't placed any orders yet.</div>
        }
        else
        {
            <table class="mo-table">
                <thead>
                    <tr>
                        <th>Order</th><th>Ordered</th><th>Status</th><th>Picked up by</th><th>Items</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="fw-bold">
                                #@o.Id
                                @if (o.SplitFromOrderId.HasValue)
                                {
                                    <span class="mo-sub d-block" style="font-size:11px;">split from #@o.SplitFromOrderId</span>
                                }
                            </td>
                            <td class="mo-sub">@o.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                            <td>
                                @if (o.Status == "Completed")
                                {
                                    <span class="badge bg-success">@o.Status</span>
                                }
                                else if (o.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">@o.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@o.Status</span>
                                }
                            </td>
                            <td class="mo-sub">@(string.IsNullOrEmpty(o.FulfilledBy) ? "—" : o.FulfilledBy)</td>
                            <td>@(o.Items?.Count ?? 0)</td>
                            <td><a asp-controller="Home" asp-action="OrderDetails" asp-route-id="@o.Id" class="btn btn-sm btn-info text-white fw-bold">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<script>
    // Show the new-location fields only when "＋ New location…" (empty value) is picked.
    function toggleReturnLoc(sel, oiId) {
        var row = document.getElementById('newloc-' + oiId);
        if (row) row.style.display = (sel.value === '') ? 'block' : 'none';
    }
    // Pass 6B: reveal Return/Scrap for a compressor line once the user has
    // confirmed they're finished with it. Pure UI -- no state is stored, so a
    // refresh puts the gate back and nothing is half-committed.
    // Copy the ticked unit ids into whichever form is being submitted. The tick
    // list lives outside both forms so Return and Scrap act on the SAME selection;
    // without this, one of them would always act on all units or none.
    function syncUnits(form, oiid) {
        form.querySelectorAll('input[name="unitIds"]').forEach(function (el) { el.remove(); });
        document.querySelectorAll('.unitbox-' + oiid + ':checked').forEach(function (cb) {
            var h = document.createElement('input');
            h.type = 'hidden'; h.name = 'unitIds'; h.value = cb.value;
            form.appendChild(h);
        });
        return true;
    }

    // Reveal the free-text serial input when the approver picks "+ Add a serial
    // not listed" instead of a known on-hand one.
    function toggleTransferManual(sel) {
        var manual = sel.parentElement.querySelector('.comp-serial-manual');
        if (manual) manual.classList.toggle('d-none', sel.value !== '__ADD__');
    }

    function doneUsing(oiid) {
        document.querySelectorAll('.disp-' + oiid).forEach(function (el) { el.style.display = ''; });
        var gate = document.getElementById('gate-' + oiid);
        if (gate) gate.style.display = 'none';
    }

    // On load, honor the initial selection (e.g. a loan whose only option is
    // "New location" because the item has no active variants left).
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('select[name="targetVariantId"]').forEach(function (sel) {
            toggleReturnLoc(sel, sel.getAttribute('data-oiid'));
        });
    });
</script>
