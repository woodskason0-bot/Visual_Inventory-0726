@using Visual_Inventory_System.Services
@inject Visual_Inventory_System.Services.CurrentUserService CurrentUser

<div class="modal fade" id="newItemModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-controller="Home" asp-action="CreateItem" method="post" id="create-frm">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="background: var(--vis-green);">
                    <h5 class="modal-title text-white fw-bold">New Item Registry</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-white">
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-light-gray">Item ID (Auto)</label>
                            <input type="text" name="ItemId" id="reg-itemid" class="form-control fw-bold text-white" style="background-color: var(--vis-card-border);" value="@ViewBag.NextItemId" placeholder="Auto-assigned" readonly />
                        </div>
                        <div class="col-md-7 position-relative">
                            <label class="form-label small fw-bold text-light-gray">Item Name</label>
                            <input type="text" name="ItemName" id="reg-name" class="form-control" required autocomplete="off" />
                            @* Live matches -- registering something new is the whole point of this
                               form, so typing never gets gated the way Modify Stock's search does;
                               free text always submits. But clicking a match means "this already
                               exists" -- it jumps straight into Modify Stock for that item instead
                               of continuing the registration (bindAutocomplete's jumpToStock). *@
                            <div id="reg-name-autocomplete-list" class="list-group position-absolute w-100 shadow" style="z-index: 2000; display: none; max-height: 200px; overflow-y: auto;"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold text-success">Initial Qty</label>
                            <input type="number" name="Quantity" id="reg-qty" class="form-control text-success fw-bold" value="1" min="0" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        @* Group removed in Pass 7A -- derived server-side from the
                           registering user's Line (OrgStructure.GroupFor). It only
                           feeds the ItemId prefix, and pinning it to the creator means
                           a later Line change can't make an existing id wrong. *@
@* Pass 7A: Team is OPTIONAL and data-driven from the Teams table.
                           N/A is the default -- a team is a reporting label, not a
                           permission; visibility belongs to Line. Group is no longer
                           asked for at all: it's derived server-side from the Line of
                           whoever is signed in, and only exists to mint the ItemId
                           prefix. *@
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Team / Project <span class="text-light-gray">(optional)</span></label>
                            <select name="Team" id="reg-team" class="form-select">
                                <option value="" data-code="" selected>N/A — no team</option>
                                @foreach (var t in (List<Visual_Inventory_System.Models.Team>)(ViewBag.ActiveTeams ?? new List<Visual_Inventory_System.Models.Team>()))
                                {
                                    <option value="@t.Name" data-code="@t.ProjectCode">
                                        @t.Name@(string.IsNullOrWhiteSpace(t.ProjectCode) ? "" : $" ({t.ProjectCode})")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Project Code</label>
                            <input type="text" name="ProjectCode" id="reg-projcode" class="form-control text-light-gray" style="background-color: var(--vis-card-border);" value="" placeholder="—" readonly />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Branch</label>
                            <select id="reg-line-branch" class="form-select">
                                <option value="">-- Branch --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Line <span class="text-danger">*</span></label>
                            <select name="Line" id="reg-line" class="form-select" required>
                                <option value="">-- Select a Line --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold" style="color: var(--vis-yellow, #F59E0B);">Rheem Part # <span class="text-danger">*</span></label>
                            @* REQUIRED (leadership): every new item carries the PN off the
                               physical Rheem label. Server rejects blanks and duplicates;
                               reg-rpn-warn gives the live "already exists" heads-up. *@
                            <div class="btn-group btn-group-sm mb-2 d-flex" role="group" aria-label="Rheem PN mode">
                                <input type="radio" class="btn-check" name="regRpnMode" id="reg-rpn-mode-real" autocomplete="off" checked>
                                <label class="btn btn-outline-light" for="reg-rpn-mode-real">Has a Part #</label>
                                <input type="radio" class="btn-check" name="regRpnMode" id="reg-rpn-mode-na" autocomplete="off">
                                <label class="btn btn-outline-secondary" for="reg-rpn-mode-na">N/A</label>
                            </div>
                            <input type="text" name="RheemPartNumber" id="reg-rpn" class="form-control fw-bold" required placeholder="From the label" />
                            <small class="text-warning" style="font-size:10px; display:none;" id="reg-rpn-warn"></small>
                        </div>
                        <div class="col-md-4 position-relative">
                            <label class="form-label small fw-bold text-light-gray">Type</label>
                            <input type="text" name="Type" id="reg-type" class="form-control" placeholder="e.g. Motor, Unit..." autocomplete="off" />
                            <div id="reg-type-autocomplete-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 180px; overflow-y: auto; width: calc(100% - 24px);"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Brand</label>
                            <input type="text" name="Brand" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-light-gray">Description</label>
                            <input type="text" name="Description" class="form-control" />
                        </div>
                    </div>

                    @* Serial (compressors) / thermocoupled count (motors) capture at
                       registration -- neither is required, both are optional
                       opportunities the form surfaces automatically based on Type.
                       See InventoryService.CreateItem for what these feed into. *@
                    <div id="reg-compressor-serials" class="mb-3" style="display:none;">
                        <label class="form-label small fw-bold text-light-gray">Serial # <span class="text-light-gray">(optional, one per unit)</span></label>
                        <div id="reg-serial-rows"></div>
                    </div>
                    <div id="reg-motor-tc" class="mb-3" style="display:none;">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="reg-tc-check">
                            <label class="form-check-label small fw-bold text-light-gray" for="reg-tc-check">Are any of these thermocoupled?</label>
                        </div>
                        <div id="reg-tc-qty-wrap" class="mt-2" style="display:none; max-width:160px;">
                            <label class="form-label small fw-bold text-light-gray">How many?</label>
                            <input type="number" name="thermocoupledQty" id="reg-tc-qty" class="form-control" min="0" value="0" disabled />
                        </div>
                    </div>

                    <hr class="border-secondary" />
                    <h6 class="text-info fw-bold mb-3">Location Mapping</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Parent</label>
                                @* Pass 9 fix: from the Locations table. NOTE the value is the
                                   NAME, not the code -- bindCascadingLocation() runs encodeLoc()
                                   on whatever is selected. That difference is why the 7C sweep
                                   missed this one and the export filter below: they were greppable
                                   as value="RD Lab", not value="RLB". *@
                            <select name="Parent" id="reg-parent" class="form-select">
                                <option value="">Select Parent...</option>
                                @foreach (var lp in (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string Code, string Name)>()))
                                {
                                    <option value="@lp.Name">@lp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Major</label>
                            <select name="Major" id="reg-major" class="form-select" disabled>
                                <option value="">Select Major...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-light-gray">Sub</label>
                            <select name="Sub" id="reg-sub" class="form-select" disabled>
                                <option value="">Select Sub...</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        @* Suggests from Rack/Row values already stored under whatever
                           Parent/Major/Sub is picked above -- never a gate, typing a
                           brand new value always works (Rack/Row stay free-form). *@
                        <div class="col-md-6 position-relative">
                            <label class="form-label small fw-bold text-light-gray">Rack</label>
                            <input type="text" name="Rack" id="reg-rack" class="form-control" placeholder="e.g. FLOOR, A" autocomplete="off" />
                            <div id="reg-rack-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div>
                        </div>
                        <div class="col-md-6 position-relative">
                            <label class="form-label small fw-bold text-light-gray">Row</label>
                            <input type="text" name="Row" id="reg-row" class="form-control" placeholder="e.g. 1, 2" autocomplete="off" />
                            <div id="reg-row-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div>
                        </div>
                    </div>

                    <div class="p-3 mt-4 border rounded" style="background-color: #14151A; border-color: #3D4351 !important;">
                        <label class="form-label small fw-bold text-info">Generated FDA String</label>
                        <input type="text" name="FdaString" id="reg-fda" class="form-control fw-bold border-0 text-white" style="background:transparent; font-size: 16px;" readonly placeholder="Waiting for location input..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success fw-bold" onclick="executeSubmit('create-frm', this)">Save to Registry</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    bindAutocomplete('reg-name', 'reg-name-autocomplete-list', null, false, false, true);
    // Registry's Type field: same distinct-Types source as everywhere else
    // that suggests one (derived from itemsList -- no server round trip
    // needed, this page already has the full item list loaded).
    bindValueAutocomplete(
        document.getElementById('reg-type'),
        document.getElementById('reg-type-autocomplete-list'),
        [...new Set(itemsList.map(function (i) { return i.type; }).filter(Boolean))].sort()
    );
    // Registration dup-check: warn live if the typed Rheem PN already belongs
    // to an existing item ("add stock to that item instead of a twin").
    // Server still enforces authoritatively on submit.
    (function () {
        const rpn = document.getElementById('reg-rpn');
        const warn = document.getElementById('reg-rpn-warn');
        if (!rpn || !warn) return;
        rpn.addEventListener('input', function () {
            const val = String(rpn.value || '').trim().toLowerCase();
            if (val === 'n/a') { warn.style.display = 'none'; return; }
            const hit = val && itemsList.find(function (i) {
                return i.rpn && i.rpn.trim().toLowerCase() === val;
            });
            if (hit) {
                warn.textContent = 'Already exists as ' + hit.id + ' (' + hit.name + ') — add stock there instead.';
                warn.style.display = 'block';
            } else {
                warn.style.display = 'none';
            }
        });
    })();
    // N/A <-> Has-a-Part# toggle for new registrations. Defaults to Has-a-Part#
    // since a PN is normally expected; N/A is the deliberate opt-out.
    (function bindRegRpnMode() {
        const real = document.getElementById('reg-rpn-mode-real');
        const na = document.getElementById('reg-rpn-mode-na');
        const rpn = document.getElementById('reg-rpn');
        const warn = document.getElementById('reg-rpn-warn');
        if (!real || !na || !rpn) return;

        function apply() {
            if (na.checked) {
                rpn.value = 'N/A';
                rpn.readOnly = true;
                rpn.required = false;
                if (warn) warn.style.display = 'none';
            } else {
                if (rpn.value.trim().toUpperCase() === 'N/A') rpn.value = '';
                rpn.readOnly = false;
                rpn.required = true;
                rpn.focus();
            }
        }
        real.addEventListener('change', apply);
        na.addEventListener('change', apply);
    })();
        const teamSel = document.getElementById('reg-team');
        const codeInput = document.getElementById('reg-projcode');
        if (teamSel && codeInput) {
            teamSel.addEventListener('change', function() {
                codeInput.value = this.options[this.selectedIndex].getAttribute('data-code');
            });
        }

        // ---- Registration: Branch/Line cascade -----------------------------
        const regLineBranch = document.getElementById('reg-line-branch');
        const regLine = document.getElementById('reg-line');
        // Line is required to register (Pass 15) -- placeholder reads as a
        // prompt to pick one, not a valid "leave it blank" choice.
        wireLineCascade(regLineBranch, regLine, null, undefined, '-- Select a Line --');

        // Auto-fill: picking a Team suggests its home Line, but doesn't lock
        // it -- a team with no assigned Line does nothing, and a manual
        // Branch/Line change after this stands until a DIFFERENT team is
        // picked (which re-suggests, on the read that re-picking a team on
        // purpose is more common than wanting to keep an unrelated override).
        if (teamSel) {
            teamSel.addEventListener('change', function () {
                const suggested = teamLines[teamSel.value];
                if (!suggested) return;
                setLineCascade(regLineBranch, regLine, suggested);
                regPreviewId();
            });
        }

        // ---- Live Item ID preview -----------------------------------------
        // Shows the predicted ID (<GroupInitial><Type first+last>-NNNN) as the
        // user picks Branch/Line / types Type. The number is read from the
        // items already on the page. This is ONLY a preview: HomeController.
        // CreateItem recomputes and assigns the real ID at save (from the
        // item's own posted Line, same source used here), so a stale number
        // or stale group here can never cause a clash. The success toast
        // shows the actual ID.
        const regType = document.getElementById('reg-type');
        const regIdOut = document.getElementById('reg-itemid');

        // Mirrors OrgStructure.BranchFor/GroupFor: find which Branch a Line
        // belongs to, then reduce "Residential Air" -> "Residential". Falls
        // back to the Branch dropdown alone if no specific Line is picked
        // yet, so the preview updates the moment a Branch is chosen instead
        // of waiting on a Line selection underneath it.
        function regGroupWord() {
            const lineVal = (regLine && regLine.value) ? regLine.value.trim() : '';
            let branch = lineVal ? branchForLine(lineVal) : '';
            if (!branch) branch = (regLineBranch && regLineBranch.value) ? regLineBranch.value.trim() : '';
            if (!branch) return 'Commercial';
            return /\sair$/i.test(branch) ? branch.slice(0, -4) : branch;
        }

        function regBuildPrefix() {
            let g = regGroupWord();
            let t = (regType && regType.value ? regType.value : '').trim();
            if (t === '') t = 'General';
            const gi = g.charAt(0).toUpperCase();
            const tc = (t.charAt(0) + t.charAt(t.length - 1)).toUpperCase();
            return gi + tc + '-';
        }
        function regPreviewId() {
            if (!regIdOut) return;
            const prefix = regBuildPrefix();
            let max = 0;
            const list = (typeof itemsList !== 'undefined' && itemsList) ? itemsList : [];
            list.forEach(function (it) {
                const id = (it && it.id) ? String(it.id) : '';
                if (id.indexOf(prefix) === 0) {
                    const numPart = id.substring(prefix.length);
                    if (/^\d+$/.test(numPart)) {
                        const n = parseInt(numPart, 10);
                        if (n > max) max = n;
                    }
                }
            });
            regIdOut.value = prefix + String(max + 1).padStart(4, '0');
        }
        if (regLineBranch) regLineBranch.addEventListener('change', regPreviewId);
        if (regLine) regLine.addEventListener('change', regPreviewId);
        if (regType) regType.addEventListener('input', regPreviewId);
        // Refresh the preview each time the registry modal opens.
        const newItemModal = document.getElementById('newItemModal');
        if (newItemModal) newItemModal.addEventListener('shown.bs.modal', regPreviewId);
        bindCascadingLocation('reg-parent', 'reg-major', 'reg-sub', 'reg-rack', 'reg-row', 'reg-fda', 'reg-rack-list', 'reg-row-list');
    // New Item Registry: serial capture for compressors, TC-count declaration
    // for motors. Neither is required -- both are opportunities the form
    // surfaces automatically based on Type, mirroring the roster's own Serial/
    // Lab shape for compressors. See InventoryService.CreateItem.
    (function bindRegUnitCapture() {
        const typeEl = document.getElementById('reg-type');
        const qtyEl = document.getElementById('reg-qty');
        const compWrap = document.getElementById('reg-compressor-serials');
        const serialRows = document.getElementById('reg-serial-rows');
        const motorWrap = document.getElementById('reg-motor-tc');
        const tcCheck = document.getElementById('reg-tc-check');
        const tcQtyWrap = document.getElementById('reg-tc-qty-wrap');
        const tcQty = document.getElementById('reg-tc-qty');
        if (!typeEl || !qtyEl || !compWrap || !motorWrap) return;

        // Keep in lockstep with InventoryService.IsCompressorType -- exact
        // match only, same rule the server enforces.
        function isCompressorTypeLocal(t) {
            return !!t && String(t).trim().toLowerCase() === 'compressor';
        }
        function isMotorTypeLocal(t) {
            return typeof isMotorType === 'function' ? isMotorType(t)
                : (!!t && String(t).trim().toLowerCase().endsWith('motor'));
        }

        function rebuildSerialRows() {
            const n = Math.max(0, parseInt(qtyEl.value, 10) || 0);
            serialRows.innerHTML = '';
            for (let i = 0; i < n; i++) {
                const input = document.createElement('input');
                input.type = 'text';
                input.name = 'serial_' + i;
                input.className = 'form-control form-control-sm mb-1';
                input.placeholder = 'Unit ' + (i + 1) + ' serial (optional)';
                serialRows.appendChild(input);
            }
        }

        function sync() {
            const t = typeEl.value;
            if (isCompressorTypeLocal(t)) {
                compWrap.style.display = '';
                motorWrap.style.display = 'none';
                rebuildSerialRows();
            } else if (isMotorTypeLocal(t)) {
                compWrap.style.display = 'none';
                serialRows.innerHTML = '';
                motorWrap.style.display = '';
            } else {
                compWrap.style.display = 'none';
                motorWrap.style.display = 'none';
                serialRows.innerHTML = '';
            }
        }

        tcCheck.addEventListener('change', function () {
            tcQtyWrap.style.display = tcCheck.checked ? '' : 'none';
            tcQty.disabled = !tcCheck.checked;
            if (!tcCheck.checked) tcQty.value = '0';
        });
        tcQty.addEventListener('input', function () {
            const cap = Math.max(0, parseInt(qtyEl.value, 10) || 0);
            if (parseInt(tcQty.value, 10) > cap) tcQty.value = String(cap);
        });

        typeEl.addEventListener('input', sync);
        qtyEl.addEventListener('input', function () {
            if (isCompressorTypeLocal(typeEl.value)) rebuildSerialRows();
            if (tcCheck.checked) {
                const cap = Math.max(0, parseInt(qtyEl.value, 10) || 0);
                if (parseInt(tcQty.value, 10) > cap) tcQty.value = String(cap);
            }
        });

        // Reset every time the modal opens, same as the ID preview does --
        // otherwise a prior registration's leftover rows/checked state lingers.
        const newItemModal = document.getElementById('newItemModal');
        if (newItemModal) newItemModal.addEventListener('shown.bs.modal', function () {
            tcCheck.checked = false;
            tcQtyWrap.style.display = 'none';
            tcQty.disabled = true;
            tcQty.value = '0';
            sync();
        });
    })();
</script>
