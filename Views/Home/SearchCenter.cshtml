@* Request Transfer: offered instead of Add to Cart for another Line's item. One-way. Serials are picked at approval. *@
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Home" asp-action="RequestTransfer" method="post" id="transfer-frm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="itemId" id="trf-item-id" />
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-arrow-left-right me-2"></i>Request Transfer - Internal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-white">
                    <div class="mb-3">
                        <div class="fw-bold fs-5 text-white" id="trf-item-name">--</div>
                        <small class="text-light-gray" id="trf-item-sub">ID: --</small>
                        @* Who owns it, so the requester is not guessing. *@
                        <small class="text-warning d-block mt-1 fw-bold" id="trf-owner-div">--</small>
                    </div>

                    <div class="mb-3" id="trf-loc-div" style="display:none;">
                        <label class="form-label small fw-bold text-light-gray">Pull location</label>
                        <select name="requestedVariantId" id="trf-loc-sel" class="form-select fw-bold text-info"
                                style="background-color:#14151A; border-color:#3D4351;"></select>
                        <small class="text-light-gray d-block mt-1" style="font-size:10px;">A preference -- the owning Line can still pull from elsewhere if this shelf runs short.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-light-gray">Quantity</label>
                        <input type="number" name="quantity" id="trf-qty" class="form-control fw-bold" value="1" min="1" required />
                    </div>

                    <div class="mb-3" id="trf-tc-div" style="display:none;">
                        <label class="form-label small fw-bold" style="color:#F59E0B;">
                            <i class="bi bi-thermometer-half me-1"></i>Thermocoupled count
                        </label>
                        <input type="number" name="thermocoupledCount" id="trf-tc" class="form-control fw-bold" value="0" min="0"
                               style="border-color:#F59E0B;" />
                    </div>

                    <div class="mb-1">
                        <label class="form-label small fw-bold text-light-gray">Note (optional)</label>
                        <input type="text" name="note" maxlength="100" class="form-control" placeholder="What it's for" />
                    </div>
                    <small class="text-light-gray d-block mt-2" style="font-size:10px;">This sends a request -- the owning Line approves it before anything leaves their shelf. Once approved, it's a permanent transfer, not a loan.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="bi bi-arrow-left-right me-1"></i>Send Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="exportWizardModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Home" asp-action="ExportInventory" method="get">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-arrow-down me-2"></i>Export List Wizard</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-white">
                    <p class="small text-light-gray mb-3">Leave fields blank to include everything, or select options to narrow your export.</p>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-light-gray">Group</label>
                            @* Groups come from real data, not a fixed list. *@
                            <select name="exportGroup" class="form-select form-select-sm">
                                <option value="">-- Any Group --</option>
                                @foreach (var g in allItems.Select(i => i.Group).Where(g => !string.IsNullOrWhiteSpace(g))
                                                           .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(g => g))
                                {
                                    <option value="@g">@g</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-light-gray">Team / Project</label>
                            <select name="exportTeam" class="form-select form-select-sm">
                                <option value="">-- Any Team --</option>
                                @foreach (var t in (List<Visual_Inventory_System.Models.Team>)(ViewBag.AllTeams ?? new List<Visual_Inventory_System.Models.Team>()))
                                {
                                    <option value="@t.Name">@t.Name@(t.IsActive ? "" : " (hidden)")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-light-gray">Type</label>
                            <input type="text" name="exportType" class="form-control form-control-sm" placeholder="e.g. Motor" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-light-gray">Brand</label>
                            <input type="text" name="exportBrand" class="form-control form-control-sm" placeholder="e.g. Broad Ocean" />
                        </div>
                    </div>

                    <hr class="border-secondary" />
                    <h6 class="text-info fw-bold small mb-2">Location Filter (Cascading)</h6>

                    @* Server-rendered with the stored codes as values, narrowed client-side, the same as Advanced Filters. *@
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <select name="exportLocParent" id="exp-parent" class="form-select form-select-sm">
                                <option value="">Any Parent...</option>
                                @foreach (var g in locRows.GroupBy(r => new { r.PCode, r.PName }).OrderBy(g => g.Key.PName))
                                {
                                    <option value="@g.Key.PCode">@g.Key.PName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select name="exportLocMajor" id="exp-major" class="form-select form-select-sm">
                                <option value="">Any Major...</option>
                                @foreach (var g in locRows.Where(r => r.MCode.Length > 0)
                                                          .GroupBy(r => new { r.PCode, r.MCode, r.MName }).OrderBy(g => g.Key.MName))
                                {
                                    <option value="@g.Key.MCode" data-parent="@g.Key.PCode">@g.Key.MName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select name="exportLocSub" id="exp-sub" class="form-select form-select-sm">
                                <option value="">Any Sub...</option>
                                @foreach (var r in locRows.Where(r => r.SCode.Length > 0)
                                                          .GroupBy(r => new { r.PCode, r.MCode, r.SCode, r.SName }).OrderBy(g => g.Key.SName))
                                {
                                    <option value="@r.Key.SCode" data-parent="@r.Key.PCode" data-major="@r.Key.MCode">@r.Key.SName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6 position-relative">
                            <input type="text" name="exportRack" id="exp-rack" class="form-control form-control-sm" placeholder="Any Rack..." autocomplete="off" />
                            <div id="exp-rack-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div>
                        </div>
                        <div class="col-md-6 position-relative">
                            <input type="text" name="exportRow" id="exp-row" class="form-control form-control-sm" placeholder="Any Row..." autocomplete="off" />
                            <div id="exp-row-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div>
                        </div>
                    </div>

                    <hr class="border-secondary" />
                    <h6 class="text-warning fw-bold small mb-2">Include Status (OR Logic)</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="expAvailable" id="expAvailable" value="true" checked>
                                <label class="form-check-label small fw-bold text-light-gray" for="expAvailable">Available (Qty > 0)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="expAlerts" id="expAlerts" value="true">
                                <label class="form-check-label small fw-bold text-warning" for="expAlerts">Stock Alerts</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input exp-history-chk" type="checkbox" name="expScrap" id="expScrap" value="true">
                                <label class="form-check-label small fw-bold text-danger" for="expScrap">Scrapped</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input exp-history-chk" type="checkbox" name="expOwnership" id="expOwnership" value="true">
                                <label class="form-check-label small fw-bold text-info" for="expOwnership">Ownership Change</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-1 mt-3" id="expTimeFrameDiv" style="display:none;">
                        <label class="form-label small fw-bold text-light-gray">History Time Frame</label>
                        <select name="expTimeFrame" class="form-select form-select-sm">
                            <option value="7">Last 7 Days</option>
                            <option value="30" selected>Last 30 Days</option>
                            <option value="90">Last 90 Days</option>
                            <option value="all">All Time</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold" onclick="setTimeout(()=>$('#exportWizardModal').modal('hide'), 500);">Download CSV</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    @* Item Card. Runs fn once `modalId` has finished hiding, or right away if it is not open, *@
    @* so two Bootstrap modals never stack. *@
    function afterModalHides(modalId, fn) {
        const el = modalId ? document.getElementById(modalId) : null;
        const inst = el ? bootstrap.Modal.getInstance(el) : null;
        if (inst && el.classList.contains('show')) {
            el.addEventListener('hidden.bs.modal', function () { fn(); }, { once: true });
            inst.hide();
        } else {
            fn();
        }
    }

    @* fromModalId: the modal the click came from, closed first. The card body is fetched fresh every time. *@
    function openItemCard(itemId, fromModalId) {
        afterModalHides(fromModalId, function () {
            const content = document.getElementById('itemCardContent');
            content.innerHTML = '<div class="modal-body text-center py-5 text-light-gray">'
                + '<span class="spinner-border spinner-border-sm me-2"></span>Loading ' + itemId + '…</div>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('itemCardModal')).show();
            fetch('/Home/ItemCard?itemId=' + encodeURIComponent(itemId), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
                .then(function (html) { content.innerHTML = html; })
                .catch(function () {
                    content.innerHTML = '<div class="modal-body text-center py-5 text-danger">Couldn\'t load ' + itemId + '.</div>'
                        + '<div class="modal-footer"><button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Close</button></div>';
                });
        });
    }

    @* Card buttons hand off to the existing modals -- the card never duplicates *@
    @* Add to Cart / Modify Stock / Transfer / Delete logic, it just routes. *@
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('#itemCardModal [data-card-action]');
        if (!btn || btn.disabled) return;
        const id = btn.dataset.itemId, name = btn.dataset.itemName;
        const resId = btn.dataset.reservationId;
        const next = {
            cart: function () { openAddToCart(id); },
            stock: function () { handleStock(id); },
            transfer: function () { openTransfer(id); },
            reserve: function () { openReserve(id, resId); },
            'delete': function () { openDeleteItem(id, name); }
        }[btn.dataset.cardAction];
        if (next) afterModalHides('itemCardModal', next);
    });

    @* Reserve dialog: the body comes fresh from /Reservations/Form each time. A refusal comes back as text. *@
    function openReserve(itemId, reservationId) {
        const content = document.getElementById('reserveContent');
        content.innerHTML = '<div class="modal-body text-center py-5 text-light-gray">'
            + '<span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('reserveModal')).show();
        let url = '/Reservations/Form?itemId=' + encodeURIComponent(itemId);
        if (reservationId) url += '&id=' + encodeURIComponent(reservationId);
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.text().then(function (t) { return { ok: r.ok, text: t }; }); })
            .then(function (res) {
                if (res.ok) { content.innerHTML = res.text; rvUpdate(); return; }
                content.innerHTML = '<div class="modal-body py-4 text-white"></div>'
                    + '<div class="modal-footer"><button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Close</button></div>';
                content.querySelector('.modal-body').textContent = res.text || 'Could not open Reserve.';
            })
            .catch(function () {
                content.innerHTML = '<div class="modal-body py-4 text-danger">Could not open Reserve.</div>'
                    + '<div class="modal-footer"><button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Close</button></div>';
            });
    }

    function rvFmt(iso) {
        const p = (iso || '').split('-');
        return p.length === 3 ? p[1] + '-' + p[2] + '-' + p[0] : '__-__-____';
    }

    @* Keeps the live preview, the counter, the date toggle and the button label *@
    @* in step with what's typed and ticked. *@
    function rvUpdate() {
        const form = document.getElementById('rv-form');
        if (!form) return;
        const reason = form.querySelector('#rv-reason');
        const notice = form.querySelector('#rv-u-notice');
        const end = form.querySelector('#rv-end');
        const start = form.querySelector('#rv-start');
        form.querySelector('#rv-count').textContent = reason.value.length + ' / 200';
        end.disabled = notice.checked;

        let total = 0;
        form.querySelectorAll('.rv-qty-input').forEach(function (q) { total += parseInt(q.value, 10) || 0; });

        const preview = form.querySelector('#rv-preview');
        preview.textContent = '';
        function strong(t) { const s = document.createElement('strong'); s.textContent = t; return s; }
        preview.append('Reserved for ', strong(reason.value.trim() || '(reason)'), ' by ', strong(form.dataset.by || ''),
            ' from ', strong(rvFmt(start.value)));
        if (notice.checked) preview.append(' until notice');
        else preview.append(' to ', strong(rvFmt(end.value)));
        preview.append(' · ' + total + ' held');

        form.querySelector('#rv-submit').disabled = !reason.value.trim() || total <= 0;
    }

    document.addEventListener('input', function (e) { if (e.target.closest('#rv-form')) rvUpdate(); });
    document.addEventListener('change', function (e) {
        const form = e.target.closest('#rv-form');
        if (!form) return;
        @* Naming a unit holds it: the stack's count can't sit below what's named. *@
        if (e.target.classList.contains('rv-pin') && e.target.checked) rvBumpQty(e.target.closest('.rv-stack'));
        rvUpdate();
    });

    function rvNamedCount(stack) {
        return stack.querySelectorAll('.rv-pin:checked').length + stack.querySelectorAll('.rv-new-list input[type=hidden]').length;
    }

    function rvBumpQty(stack) {
        if (!stack) return;
        const named = rvNamedCount(stack);
        const qty = stack.querySelector('.rv-qty-input');
        if (qty && (parseInt(qty.value, 10) || 0) < named) qty.value = named;
        @* Motors: a named unit is a TC unit. *@
        const tc = stack.querySelector('.rv-tc-input');
        if (tc && (parseInt(tc.value, 10) || 0) < named) tc.value = named;
    }

    document.addEventListener('click', function (e) {
        const reasonBtn = e.target.closest('#rv-form [data-reason]');
        if (reasonBtn) {
            const box = document.getElementById('rv-reason');
            box.value = reasonBtn.dataset.reason;
            rvUpdate();
            box.focus();
            return;
        }
        const add = e.target.closest('#rv-form .rv-new-add');
        if (add) {
            const stack = add.closest('.rv-stack');
            const input = stack.querySelector('.rv-new-input');
            const list = stack.querySelector('.rv-new-list');
            const err = document.getElementById('rv-error');
            const val = (input.value || '').trim();
            err.textContent = '';
            if (!val) { input.focus(); return; }
            const existing = Array.prototype.map.call(list.querySelectorAll('input[type=hidden]'), function (h) { return h.value.toLowerCase(); });
            if (existing.indexOf(val.toLowerCase()) >= 0) { err.textContent = val + ' is already in the list.'; return; }
            if (existing.length >= (parseInt(add.dataset.room, 10) || 0)) {
                err.textContent = 'Only ' + add.dataset.room + ' unrecorded on this stack.';
                return;
            }
            const chip = document.createElement('span');
            chip.className = 'res-chip';
            chip.append(val + ' ');
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = 'new_' + stack.dataset.vid;
            hidden.value = val;
            const x = document.createElement('button');
            x.type = 'button';
            x.className = 'btn btn-sm p-0 border-0 text-light-gray rv-new-remove';
            x.setAttribute('aria-label', 'Remove ' + val);
            x.textContent = '×';
            chip.append(hidden, x);
            list.appendChild(chip);
            input.value = '';
            rvBumpQty(stack);
            rvUpdate();
            return;
        }
        const rm = e.target.closest('#rv-form .rv-new-remove');
        if (rm) { rm.closest('.res-chip').remove(); rvUpdate(); }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && e.target.classList && e.target.classList.contains('rv-new-input')) {
            e.preventDefault();
            const add = e.target.closest('.rv-stack').querySelector('.rv-new-add');
            if (add) add.click();
        }
    });

    @* Reserved Items links here with ?openCard=ITEM (row click) or *@
    @* ?openCard=ITEM&reserve=ID (Edit); Save/Release come back with ?openCard=. *@
    document.addEventListener('DOMContentLoaded', function () {
        const qs = new URLSearchParams(window.location.search);
        const card = qs.get('openCard');
        const reserve = qs.get('reserve');
        if (card && reserve) openReserve(card, reserve);
        else if (card) openItemCard(card);
    });

    function openDeleteItem(itemId, itemName) {
        const idField = document.getElementById('delete-item-id');
        const nameEl = document.getElementById('delete-item-name');
        const idLabelEl = document.getElementById('delete-item-idlabel');
        if (idField) idField.value = itemId;
        if (nameEl) nameEl.textContent = itemName || itemId;
        if (idLabelEl) idLabelEl.textContent = '(' + itemId + ')';
        const el = document.getElementById('deleteItemModal');
        if (el) { new bootstrap.Modal(el).show(); }
    }

    @* Variants of the item currently shown in the Add to Cart modal (with tcqty), *@
    @* so the TC cap can react to the chosen pull-location. *@
    let atcCurrentVariants = [];

    function openAddToCart(itemId) {
        const item = itemsList.find(function (i) { return i.id === itemId; });
        if (!item) return;

        atcCurrentVariants = (item.variants || []);

        document.getElementById('atc-item-id').value = itemId;
        document.getElementById('atc-item-name').textContent = item.name || itemId;
        document.getElementById('atc-item-sub').textContent =
            'ID: ' + itemId + (item.type ? '  ·  ' + item.type : '');

        const xbtn = document.querySelector('#add-to-cart-frm .btn-close');
        if (xbtn) { xbtn.textContent = ''; xbtn.disabled = false; }

        const qty = document.getElementById('atc-qty');
        qty.value = 1;

        const locDiv = document.getElementById('atc-loc-div');
        const locSel = document.getElementById('atc-loc-sel');
        const vars = atcCurrentVariants;
        locSel.innerHTML = '';
        if (vars.length > 1) {
            const either = document.createElement('option');
            either.value = '';
            either.textContent = 'Either location (picker chooses)';
            locSel.appendChild(either);
            vars.forEach(function (v) {
                const o = document.createElement('option');
                o.value = String(v.vid);
                const teamTag = v.team ? ' [' + v.team + ']' : '';
                o.textContent = 'V' + v.num + ' — ' + (v.fda || '--') + teamTag + ' (Qty ' + v.qty + ')';
                locSel.appendChild(o);
            });
            locDiv.style.display = 'block';
        } else {
            locDiv.style.display = 'none';
        }
        locSel.onchange = atcRecomputeTcCap;

        @* Team is asked only when the item is split across more than one of this user's own teams. *@
        const teamDiv = document.getElementById('atc-team-div');
        const teamSel = document.getElementById('atc-team-sel');
        const itemTeams = Array.from(new Set(vars.map(function (v) { return v.team; }).filter(Boolean)));
        const applicableTeams = itemTeams.filter(function (t) { return myTeams.indexOf(t) !== -1; });
        teamSel.innerHTML = '';
        if (applicableTeams.length > 1) {
            applicableTeams.forEach(function (t) {
                const o = document.createElement('option');
                o.value = t;
                o.textContent = t;
                teamSel.appendChild(o);
            });
            teamDiv.style.display = 'block';
        } else {
            teamDiv.style.display = 'none';
        }

        const tcDiv = document.getElementById('atc-tc-div');
        const tc = document.getElementById('atc-tc');
        if (typeof isMotorType === 'function' && isMotorType(item.type)) {
            tc.value = 0;
            tc.disabled = false;
            tcDiv.style.display = 'block';
        } else {
            tc.value = 0;
            tc.disabled = true;
            tcDiv.style.display = 'none';
        }
        atcRecomputeTcCap();

        const el = document.getElementById('addToCartModal');
        if (el) { new bootstrap.Modal(el).show(); }
    }

    @* The same shape as openAddToCart, for another Line's item. Reads transferItemsList, posts to RequestTransfer. *@
    function openTransfer(itemId) {
        const item = transferItemsList.find(function (i) { return i.id === itemId; });
        if (!item) return;

        const vars = (item.variants || []);

        document.getElementById('trf-item-id').value = itemId;
        document.getElementById('trf-item-name').textContent = item.name || itemId;
        document.getElementById('trf-item-sub').textContent =
            'ID: ' + itemId + (item.type ? '  ·  ' + item.type : '');

        document.getElementById('trf-qty').value = 1;

        const locDiv = document.getElementById('trf-loc-div');
        const locSel = document.getElementById('trf-loc-sel');
        locSel.innerHTML = '';
        if (vars.length > 1) {
            vars.forEach(function (v) {
                const o = document.createElement('option');
                o.value = String(v.vid);
                @* There is no "Either" here, so this pick also says which team's slice is requested. *@
                const teamTag = v.team ? ' [' + v.team + ']' : '';
                o.textContent = 'V' + v.num + ' — ' + (v.fda || '--') + teamTag + ' (Qty ' + v.qty + ')';
                locSel.appendChild(o);
            });
            locDiv.style.display = 'block';
        } else {
            locDiv.style.display = 'none';
        }

        const ownerDiv = document.getElementById('trf-owner-div');
        if (ownerDiv) {
            const lineText = item.line ? item.line : 'Unassigned';
            const teams = Array.from(new Set(vars.map(function (v) { return v.team; }).filter(Boolean)));
            const teamText = teams.length ? teams.join(', ') : 'No team';
            ownerDiv.textContent = 'Line: ' + lineText + '  ·  Team: ' + teamText;
        }

        const tcDiv = document.getElementById('trf-tc-div');
        const tc = document.getElementById('trf-tc');
        tc.value = 0;
        tcDiv.style.display = (typeof isMotorType === 'function' && isMotorType(item.type)) ? 'block' : 'none';

        const el = document.getElementById('transferModal');
        if (el) { new bootstrap.Modal(el).show(); }
    }

    function atcRecomputeTcCap() {
        const tc = document.getElementById('atc-tc');
        if (!tc || tc.disabled) return;
        const qty = parseInt(document.getElementById('atc-qty').value, 10) || 0;
        const sel = document.getElementById('atc-loc-sel');
        const locDiv = document.getElementById('atc-loc-div');
        const vars = atcCurrentVariants || [];

        let availTc = 0;
        if (locDiv && locDiv.style.display !== 'none' && sel) {
            if (sel.value === '') {
                availTc = vars.reduce(function (s, v) { return s + (v.tcqty || 0); }, 0);
            } else {
                const vid = parseInt(sel.value, 10);
                const hit = vars.find(function (v) { return v.vid === vid; });
                availTc = hit ? (hit.tcqty || 0) : 0;
            }
        } else {
            availTc = vars.length ? (vars[0].tcqty || 0) : 0;
        }

        const ceil = Math.max(0, Math.min(qty, availTc));
        tc.max = ceil;
        let v = parseInt(tc.value, 10); if (isNaN(v) || v < 0) v = 0;
        if (v > ceil) v = ceil;
        tc.value = v;
    }

    @* Order Mode is "active" once the cart holds at least one item. *@
    let orderActive = @(hasDraft ? "true" : "false");
    let pendingAddForm = null;

    function performAdd(form) {
        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                orderActive = true;
                document.querySelector('.top-bar')?.classList.add('order-mode');
                if (typeof data.cartCount === 'number' && window.visSetCartCount) visSetCartCount(data.cartCount);
                if (window.showToast) showToast(data.message, "success");
                const b = form.querySelector('button');
                if (b) { b.classList.replace('btn-primary', 'btn-success'); b.innerText = "Added!"; b.disabled = true; }
            }
        }).catch(err => console.error(err));
    }

    document.addEventListener('submit', function (e) {
        if (e.target && typeof e.target.action === 'string' && e.target.action.includes('AddToCart')) {
            e.preventDefault();
            const form = e.target;

            const proceed = function () {
                if (!orderActive) {
                    pendingAddForm = form;
                    const el = document.getElementById('startOrderModal');
                    if (el) { new bootstrap.Modal(el).show(); }
                    else { performAdd(form); }
                } else {
                    performAdd(form);
                }
            };

            const atc = document.getElementById('addToCartModal');
            const inst = atc ? bootstrap.Modal.getInstance(atc) : null;
            if (inst) {
                atc.addEventListener('hidden.bs.modal', proceed, { once: true });
                inst.hide();
            } else {
                proceed();
            }
        }
    });

    (function () {
        const btn = document.getElementById('startOrderConfirmBtn');
        if (btn) {
            btn.addEventListener('click', function () {
                const el = document.getElementById('startOrderModal');
                const m = el ? bootstrap.Modal.getInstance(el) : null;
                if (m) m.hide();
                if (pendingAddForm) { performAdd(pendingAddForm); pendingAddForm = null; }
            });
        }
    })();

    document.addEventListener('click', function (e) {
        const row = e.target.closest('.holo-row');
        if (!row) return;
        document.querySelectorAll('.holo-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        const b = document.getElementById('holo-add-submit');
        const i = document.getElementById('holo-add-itemId');
        if (b && i) { b.disabled = false; i.value = row.dataset.itemId; }
        @* A result row opens its Item Card on click. Not in the cart view, and not when a control in the row was clicked. *@
        const viewer = row.closest('.holo-viewer');
        if (viewer && viewer.dataset.mode !== 'Ledger' && !e.target.closest('button, a, form, input, select'))
            openItemCard(row.dataset.itemId);
    });
    @* Rows are already tabindex="0" -- Enter opens the card from the keyboard too. *@
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Enter' || !e.target.classList || !e.target.classList.contains('holo-row')) return;
        const viewer = e.target.closest('.holo-viewer');
        if (viewer && viewer.dataset.mode !== 'Ledger') openItemCard(e.target.dataset.itemId);
    });

    (function() {
        const historyChks = document.querySelectorAll('.exp-history-chk');
        const timeFrameDiv = document.getElementById('expTimeFrameDiv');
        if (historyChks && timeFrameDiv) {
            historyChks.forEach(chk => {
                chk.addEventListener('change', () => {
                    timeFrameDiv.style.display = Array.from(historyChks).some(c => c.checked) ? 'block' : 'none';
                });
            });
        }

        @* Compressor filter: Unclaimed, Branch, Line, Team, Brand *@
        function compApplyFilter() {
            const unclaimedOnly = document.getElementById('compFilterUnclaimed')?.checked;
            const branch = document.getElementById('compFilterBranch')?.value || '';
            const line = document.getElementById('compFilterLine')?.value || '';
            const team = document.getElementById('compFilterTeam')?.value || '';
            const brand = document.getElementById('compFilterBrand')?.value || '';
            const rows = document.querySelectorAll('#compressorRegistryModal .comp-row');
            let shown = 0;
            rows.forEach(function (row) {
                let visible = true;
                if (unclaimedOnly && row.dataset.unclaimed !== '1') visible = false;
                if (branch && row.dataset.branch !== branch) visible = false;
                if (line && row.dataset.line !== line) visible = false;
                if (team && row.dataset.team !== team) visible = false;
                if (brand && row.dataset.brand !== brand) visible = false;
                row.style.display = visible ? '' : 'none';
                if (visible) shown++;
            });
            const countEl = document.getElementById('compFilterCount');
            if (countEl) countEl.textContent = shown + ' of ' + rows.length + ' shown';
        }
        ['compFilterUnclaimed', 'compFilterBrand'].forEach(function (id) {
            const el = document.getElementById(id);
            if (el) el.addEventListener('change', compApplyFilter);
        });
        const compFilterBranchEl = document.getElementById('compFilterBranch');
        const compFilterLineEl = document.getElementById('compFilterLine');
        wireLineCascade(compFilterBranchEl, compFilterLineEl, compApplyFilter, 'All Branches', 'All Lines');
        const compFilterTeamEl = document.getElementById('compFilterTeam');
        if (compFilterTeamEl) {
            compFilterTeamEl.addEventListener('change', function () {
                const suggested = teamLines[compFilterTeamEl.value];
                if (suggested) setLineCascade(compFilterBranchEl, compFilterLineEl, suggested, 'All Branches', 'All Lines');
                compApplyFilter();
            });
        }
        const compressorRegistryModal = document.getElementById('compressorRegistryModal');
        if (compressorRegistryModal) compressorRegistryModal.addEventListener('shown.bs.modal', compApplyFilter);

        @* Motor filter, same shape *@
        function motorApplyFilter() {
            const unclaimedOnly = document.getElementById('motorFilterUnclaimed')?.checked;
            const branch = document.getElementById('motorFilterBranch')?.value || '';
            const line = document.getElementById('motorFilterLine')?.value || '';
            const team = document.getElementById('motorFilterTeam')?.value || '';
            const brand = document.getElementById('motorFilterBrand')?.value || '';
            const rows = document.querySelectorAll('#motorRegistryModal .motor-row');
            let shown = 0;
            rows.forEach(function (row) {
                let visible = true;
                if (unclaimedOnly && row.dataset.unclaimed !== '1') visible = false;
                if (branch && row.dataset.branch !== branch) visible = false;
                if (line && row.dataset.line !== line) visible = false;
                if (team && row.dataset.team !== team) visible = false;
                if (brand && row.dataset.brand !== brand) visible = false;
                row.style.display = visible ? '' : 'none';
                if (visible) shown++;
            });
            const countEl = document.getElementById('motorFilterCount');
            if (countEl) countEl.textContent = shown + ' of ' + rows.length + ' shown';
        }
        ['motorFilterUnclaimed', 'motorFilterBrand'].forEach(function (id) {
            const el = document.getElementById(id);
            if (el) el.addEventListener('change', motorApplyFilter);
        });
        const motorFilterBranchEl = document.getElementById('motorFilterBranch');
        const motorFilterLineEl = document.getElementById('motorFilterLine');
        wireLineCascade(motorFilterBranchEl, motorFilterLineEl, motorApplyFilter, 'All Branches', 'All Lines');
        const motorFilterTeamEl = document.getElementById('motorFilterTeam');
        if (motorFilterTeamEl) {
            motorFilterTeamEl.addEventListener('change', function () {
                const suggested = teamLines[motorFilterTeamEl.value];
                if (suggested) setLineCascade(motorFilterBranchEl, motorFilterLineEl, suggested, 'All Branches', 'All Lines');
                motorApplyFilter();
            });
        }
        const motorRegistryModal = document.getElementById('motorRegistryModal');
        if (motorRegistryModal) motorRegistryModal.addEventListener('shown.bs.modal', motorApplyFilter);

        @* Export Wizard location filter. The selects post codes the server matches against columns,
           so each level is optional. Narrowing is show and hide, as in Advanced Filters. *@
        (function () {
            var p = document.getElementById('exp-parent');
            var m = document.getElementById('exp-major');
            var s = document.getElementById('exp-sub');
            var rk = document.getElementById('exp-rack');
            var rw = document.getElementById('exp-row');
            if (!p || !m || !s) return;

            function refresh() {
                Array.prototype.forEach.call(m.options, function (o) {
                    if (!o.value) return;
                    var show = !p.value || o.getAttribute('data-parent') === p.value;
                    o.hidden = !show; o.disabled = !show;
                    if (o.selected && !show) { o.selected = false; m.value = ''; }
                });
                @* Sub narrows on BOTH levels: a Sub only means something under *@
                @* its own Major, and two Majors can hold Subs with the same name. *@
                Array.prototype.forEach.call(s.options, function (o) {
                    if (!o.value) return;
                    var show = (!p.value || o.getAttribute('data-parent') === p.value)
                            && (!m.value || o.getAttribute('data-major') === m.value);
                    o.hidden = !show; o.disabled = !show;
                    if (o.selected && !show) { o.selected = false; s.value = ''; }
                });
            }

            p.addEventListener('change', function () { m.value = ''; s.value = ''; refresh(); });
            m.addEventListener('change', function () { s.value = ''; refresh(); });
            refresh();

            @* Rack/Row suggestions from the picked codes: no encodeLoc, and a union across every
               entry consistent with the levels chosen, since Rack alone is a valid filter. *@
            function suggest(which) {
                var out = [];
                Object.keys(rackRowMap).forEach(function (key) {
                    var parts = key.split('|');
                    if (p.value && parts[0] !== p.value) return;
                    if (m.value && parts[1] !== m.value) return;
                    if (s.value && parts[2] !== s.value) return;
                    (rackRowMap[key][which] || []).forEach(function (v) {
                        if (v && out.indexOf(v) === -1) out.push(v);
                    });
                });
                return out.sort();
            }
            if (rk) bindValueAutocomplete(rk, document.getElementById('exp-rack-list'),
                function () { return suggest('racks'); });
            if (rw) bindValueAutocomplete(rw, document.getElementById('exp-row-list'),
                function () { return suggest('rows'); });
        })();
    })();
</script>
