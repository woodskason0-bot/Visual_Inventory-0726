                            <select name="exportTeam" class="form-select form-select-sm">
                                <option value="">-- Any Team --</option>
                                @foreach (var t in (List<Visual_Inventory_System.Models.Team>)(ViewBag.AllTeams ?? new List<Visual_Inventory_System.Models.Team>()))
                                {
                                    <option value="@t.Name">@t.Name@(t.IsActive ? "" : " (hidden)")</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-light-gray">Type</label>
                            <input type="text" name="exportType" class="form-control form-control-sm" placeholder="e.g. Motor" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-light-gray">Brand</label>
                            <input type="text" name="exportBrand" class="form-control form-control-sm" placeholder="e.g. Broad Ocean" />
                        </div>
                    </div>

                    <hr class="border-secondary" />
                    <h6 class="text-info fw-bold small mb-2">Location Filter (Cascading)</h6>

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <select id="exp-parent" class="form-select form-select-sm">
                                <option value="">Any Parent...</option>
                                @foreach (var lp in (List<(string Code, string Name)>)(ViewBag.LocationParents ?? new List<(string Code, string Name)>()))
                                {
                                    <option value="@lp.Name">@lp.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select id="exp-major" class="form-select form-select-sm" disabled>
                                <option value="">Any Major...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select id="exp-sub" class="form-select form-select-sm" disabled>
                                <option value="">Any Sub...</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6 position-relative">
                            <input type="text" id="exp-rack" class="form-control form-control-sm" placeholder="Any Rack..." autocomplete="off" />
                            <div id="exp-rack-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div>
                        </div>
                        <div class="col-md-6 position-relative">
                            <input type="text" id="exp-row" class="form-control form-control-sm" placeholder="Any Row..." autocomplete="off" />
                            <div id="exp-row-list" class="list-group position-absolute shadow" style="z-index: 2000; display: none; max-height: 160px; overflow-y: auto; width: calc(100% - 24px);"></div>
                        </div>
                    </div>
                    <input type="hidden" name="exportFda" id="exp-fda" />

                    <hr class="border-secondary" />
                    <h6 class="text-warning fw-bold small mb-2">Include Status (OR Logic)</h6>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="expAvailable" id="expAvailable" value="true" checked>
                                <label class="form-check-label small fw-bold text-light-gray" for="expAvailable">Available (Qty > 0)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="expAlerts" id="expAlerts" value="true">
                                <label class="form-check-label small fw-bold text-warning" for="expAlerts">Stock Alerts</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check">
                                <input class="form-check-input exp-history-chk" type="checkbox" name="expScrap" id="expScrap" value="true">
                                <label class="form-check-label small fw-bold text-danger" for="expScrap">Scrapped</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input exp-history-chk" type="checkbox" name="expOwnership" id="expOwnership" value="true">
                                <label class="form-check-label small fw-bold text-info" for="expOwnership">Ownership Change</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-1 mt-3" id="expTimeFrameDiv" style="display:none;">
                        <label class="form-label small fw-bold text-light-gray">History Time Frame</label>
                        <select name="expTimeFrame" class="form-select form-select-sm">
                            <option value="7">Last 7 Days</option>
                            <option value="30" selected>Last 30 Days</option>
                            <option value="90">Last 90 Days</option>
                            <option value="all">All Time</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold" onclick="setTimeout(()=>$('#exportWizardModal').modal('hide'), 500);">Download CSV</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openDeleteItem(itemId, itemName) {
        const idField = document.getElementById('delete-item-id');
        const nameEl = document.getElementById('delete-item-name');
        const idLabelEl = document.getElementById('delete-item-idlabel');
        if (idField) idField.value = itemId;
        if (nameEl) nameEl.textContent = itemName || itemId;
        if (idLabelEl) idLabelEl.textContent = '(' + itemId + ')';
        const el = document.getElementById('deleteItemModal');
        if (el) { new bootstrap.Modal(el).show(); }
    }

    // Variants of the item currently shown in the Add to Cart modal (with tcqty),
    // so the TC cap can react to the chosen pull-location.
    let atcCurrentVariants = [];

    function openAddToCart(itemId) {
        const item = itemsList.find(function (i) { return i.id === itemId; });
        if (!item) return;

        atcCurrentVariants = (item.variants || []);

        document.getElementById('atc-item-id').value = itemId;
        document.getElementById('atc-item-name').textContent = item.name || itemId;
        document.getElementById('atc-item-sub').textContent =
            'ID: ' + itemId + (item.type ? '  ·  ' + item.type : '');

        const xbtn = document.querySelector('#add-to-cart-frm .btn-close');
        if (xbtn) { xbtn.textContent = ''; xbtn.disabled = false; }

        const qty = document.getElementById('atc-qty');
        qty.value = 1;

        const locDiv = document.getElementById('atc-loc-div');
        const locSel = document.getElementById('atc-loc-sel');
        const vars = atcCurrentVariants;
        locSel.innerHTML = '';
        if (vars.length > 1) {
            const either = document.createElement('option');
            either.value = '';
            either.textContent = 'Either location (picker chooses)';
            locSel.appendChild(either);
            vars.forEach(function (v) {
                const o = document.createElement('option');
                o.value = String(v.vid);
                const teamTag = v.team ? ' [' + v.team + ']' : '';
                o.textContent = 'V' + v.num + ' — ' + (v.fda || '--') + teamTag + ' (Qty ' + v.qty + ')';
                locSel.appendChild(o);
            });
            locDiv.style.display = 'block';
        } else {
            locDiv.style.display = 'none';
        }
        locSel.onchange = atcRecomputeTcCap;

        // TEAM (per-team quantity ownership, 2026-08-26): only asked when this
        // item's variants span more than one team AND this user belongs to
        // more than one of those specific teams -- everyone else never sees it.
        const teamDiv = document.getElementById('atc-team-div');
        const teamSel = document.getElementById('atc-team-sel');
        const itemTeams = Array.from(new Set(vars.map(function (v) { return v.team; }).filter(Boolean)));
        const applicableTeams = itemTeams.filter(function (t) { return myTeams.indexOf(t) !== -1; });
        teamSel.innerHTML = '';
        if (applicableTeams.length > 1) {
            applicableTeams.forEach(function (t) {
                const o = document.createElement('option');
                o.value = t;
                o.textContent = t;
                teamSel.appendChild(o);
            });
            teamDiv.style.display = 'block';
        } else {
            teamDiv.style.display = 'none';
        }

        const tcDiv = document.getElementById('atc-tc-div');
        const tc = document.getElementById('atc-tc');
        if (typeof isMotorType === 'function' && isMotorType(item.type)) {
            tc.value = 0;
            tc.disabled = false;
            tcDiv.style.display = 'block';
        } else {
            tc.value = 0;
            tc.disabled = true;
            tcDiv.style.display = 'none';
        }
        atcRecomputeTcCap();

        const el = document.getElementById('addToCartModal');
        if (el) { new bootstrap.Modal(el).show(); }
    }

    // Pass 30: same shape as openAddToCart above, for the other Line's item
    // Search stopped hiding -- location list and TC gate both read the same
    // transferItemsList data, just posted to RequestTransfer instead of AddToCart.
    function openTransfer(itemId) {
        const item = transferItemsList.find(function (i) { return i.id === itemId; });
        if (!item) return;

        const vars = (item.variants || []);

        document.getElementById('trf-item-id').value = itemId;
        document.getElementById('trf-item-name').textContent = item.name || itemId;
        document.getElementById('trf-item-sub').textContent =
            'ID: ' + itemId + (item.type ? '  ·  ' + item.type : '');

        document.getElementById('trf-qty').value = 1;

        const locDiv = document.getElementById('trf-loc-div');
        const locSel = document.getElementById('trf-loc-sel');
        locSel.innerHTML = '';
        if (vars.length > 1) {
            vars.forEach(function (v) {
                const o = document.createElement('option');
                o.value = String(v.vid);
                // Per-team quantity ownership (2026-08-26): this dropdown was
                // already effectively required whenever it's shown (no "Either"
                // option here, unlike Add to Cart) -- once a variant carries a
                // Team, that same required pick doubles as which team's slice
                // is being requested, so it needs to actually be visible here.
                const teamTag = v.team ? ' [' + v.team + ']' : '';
                o.textContent = 'V' + v.num + ' — ' + (v.fda || '--') + teamTag + ' (Qty ' + v.qty + ')';
                locSel.appendChild(o);
            });
            locDiv.style.display = 'block';
        } else {
            locDiv.style.display = 'none';
        }

        const ownerDiv = document.getElementById('trf-owner-div');
        if (ownerDiv) {
            const lineText = item.line ? item.line : 'Unassigned';
            const teams = Array.from(new Set(vars.map(function (v) { return v.team; }).filter(Boolean)));
            const teamText = teams.length ? teams.join(', ') : 'No team';
            ownerDiv.textContent = 'Line: ' + lineText + '  ·  Team: ' + teamText;
        }

        const tcDiv = document.getElementById('trf-tc-div');
        const tc = document.getElementById('trf-tc');
        tc.value = 0;
        tcDiv.style.display = (typeof isMotorType === 'function' && isMotorType(item.type)) ? 'block' : 'none';

        const el = document.getElementById('transferModal');
        if (el) { new bootstrap.Modal(el).show(); }
    }

    function atcRecomputeTcCap() {
        const tc = document.getElementById('atc-tc');
        if (!tc || tc.disabled) return;
        const qty = parseInt(document.getElementById('atc-qty').value, 10) || 0;
        const sel = document.getElementById('atc-loc-sel');
        const locDiv = document.getElementById('atc-loc-div');
        const vars = atcCurrentVariants || [];

        let availTc = 0;
        if (locDiv && locDiv.style.display !== 'none' && sel) {
            if (sel.value === '') {
                availTc = vars.reduce(function (s, v) { return s + (v.tcqty || 0); }, 0);
            } else {
                const vid = parseInt(sel.value, 10);
                const hit = vars.find(function (v) { return v.vid === vid; });
                availTc = hit ? (hit.tcqty || 0) : 0;
            }
        } else {
            availTc = vars.length ? (vars[0].tcqty || 0) : 0;
        }

        const ceil = Math.max(0, Math.min(qty, availTc));
        tc.max = ceil;
        let v = parseInt(tc.value, 10); if (isNaN(v) || v < 0) v = 0;
        if (v > ceil) v = ceil;
        tc.value = v;
    }

    // Order Mode is "active" once the cart holds at least one item.
    let orderActive = @(hasDraft ? "true" : "false");
    let pendingAddForm = null;

    function performAdd(form) {
        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                orderActive = true;
                document.querySelector('.top-bar')?.classList.add('order-mode');
                if (window.showToast) showToast(data.message, "success");
                const b = form.querySelector('button');
                if (b) { b.classList.replace('btn-primary', 'btn-success'); b.innerText = "Added!"; b.disabled = true; }
            }
        }).catch(err => console.error(err));
    }

    document.addEventListener('submit', function (e) {
        if (e.target && typeof e.target.action === 'string' && e.target.action.includes('AddToCart')) {
            e.preventDefault();
            const form = e.target;

            const proceed = function () {
                if (!orderActive) {
                    pendingAddForm = form;
                    const el = document.getElementById('startOrderModal');
                    if (el) { new bootstrap.Modal(el).show(); }
                    else { performAdd(form); }
                } else {
                    performAdd(form);
                }
            };

            const atc = document.getElementById('addToCartModal');
            const inst = atc ? bootstrap.Modal.getInstance(atc) : null;
            if (inst) {
                atc.addEventListener('hidden.bs.modal', proceed, { once: true });
                inst.hide();
            } else {
                proceed();
            }
        }
    });

    (function () {
        const btn = document.getElementById('startOrderConfirmBtn');
        if (btn) {
            btn.addEventListener('click', function () {
                const el = document.getElementById('startOrderModal');
                const m = el ? bootstrap.Modal.getInstance(el) : null;
                if (m) m.hide();
                if (pendingAddForm) { performAdd(pendingAddForm); pendingAddForm = null; }
            });
        }
    })();

    document.addEventListener('click', function (e) {
        const row = e.target.closest('.holo-row');
        if (!row) return;
        document.querySelectorAll('.holo-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        const b = document.getElementById('holo-add-submit');
        const i = document.getElementById('holo-add-itemId');
        if (b && i) { b.disabled = false; i.value = row.dataset.itemId; }
    });

    (function() {
        const historyChks = document.querySelectorAll('.exp-history-chk');
        const timeFrameDiv = document.getElementById('expTimeFrameDiv');
        if (historyChks && timeFrameDiv) {
            historyChks.forEach(chk => {
                chk.addEventListener('change', () => {
                    timeFrameDiv.style.display = Array.from(historyChks).some(c => c.checked) ? 'block' : 'none';
                });
            });
        }

        // ---- Compressor filter (Unclaimed / Branch / Line / Team / Brand) ----
        function compApplyFilter() {
            const unclaimedOnly = document.getElementById('compFilterUnclaimed')?.checked;
            const branch = document.getElementById('compFilterBranch')?.value || '';
            const line = document.getElementById('compFilterLine')?.value || '';
            const team = document.getElementById('compFilterTeam')?.value || '';
            const brand = document.getElementById('compFilterBrand')?.value || '';
            const rows = document.querySelectorAll('#compressorRegistryModal .comp-row');
            let shown = 0;
            rows.forEach(function (row) {
                let visible = true;
                if (unclaimedOnly && row.dataset.unclaimed !== '1') visible = false;
                if (branch && row.dataset.branch !== branch) visible = false;
                if (line && row.dataset.line !== line) visible = false;
                if (team && row.dataset.team !== team) visible = false;
                if (brand && row.dataset.brand !== brand) visible = false;
                row.style.display = visible ? '' : 'none';
                if (visible) shown++;
            });
            const countEl = document.getElementById('compFilterCount');
            if (countEl) countEl.textContent = shown + ' of ' + rows.length + ' shown';
        }
        ['compFilterUnclaimed', 'compFilterBrand'].forEach(function (id) {
            const el = document.getElementById(id);
            if (el) el.addEventListener('change', compApplyFilter);
        });
        const compFilterBranchEl = document.getElementById('compFilterBranch');
        const compFilterLineEl = document.getElementById('compFilterLine');
        wireLineCascade(compFilterBranchEl, compFilterLineEl, compApplyFilter, 'All Branches', 'All Lines');
        const compFilterTeamEl = document.getElementById('compFilterTeam');
        if (compFilterTeamEl) {
            compFilterTeamEl.addEventListener('change', function () {
                const suggested = teamLines[compFilterTeamEl.value];
                if (suggested) setLineCascade(compFilterBranchEl, compFilterLineEl, suggested, 'All Branches', 'All Lines');
                compApplyFilter();
            });
        }
        const compressorRegistryModal = document.getElementById('compressorRegistryModal');
        if (compressorRegistryModal) compressorRegistryModal.addEventListener('shown.bs.modal', compApplyFilter);

        // ---- Motor filter (same shape as compressor filter above) ----
        function motorApplyFilter() {
            const unclaimedOnly = document.getElementById('motorFilterUnclaimed')?.checked;
            const branch = document.getElementById('motorFilterBranch')?.value || '';
            const line = document.getElementById('motorFilterLine')?.value || '';
            const team = document.getElementById('motorFilterTeam')?.value || '';
            const brand = document.getElementById('motorFilterBrand')?.value || '';
            const rows = document.querySelectorAll('#motorRegistryModal .motor-row');
            let shown = 0;
            rows.forEach(function (row) {
                let visible = true;
                if (unclaimedOnly && row.dataset.unclaimed !== '1') visible = false;
                if (branch && row.dataset.branch !== branch) visible = false;
                if (line && row.dataset.line !== line) visible = false;
                if (team && row.dataset.team !== team) visible = false;
                if (brand && row.dataset.brand !== brand) visible = false;
                row.style.display = visible ? '' : 'none';
                if (visible) shown++;
            });
            const countEl = document.getElementById('motorFilterCount');
            if (countEl) countEl.textContent = shown + ' of ' + rows.length + ' shown';
        }
        ['motorFilterUnclaimed', 'motorFilterBrand'].forEach(function (id) {
            const el = document.getElementById(id);
            if (el) el.addEventListener('change', motorApplyFilter);
        });
        const motorFilterBranchEl = document.getElementById('motorFilterBranch');
        const motorFilterLineEl = document.getElementById('motorFilterLine');
        wireLineCascade(motorFilterBranchEl, motorFilterLineEl, motorApplyFilter, 'All Branches', 'All Lines');
        const motorFilterTeamEl = document.getElementById('motorFilterTeam');
        if (motorFilterTeamEl) {
            motorFilterTeamEl.addEventListener('change', function () {
                const suggested = teamLines[motorFilterTeamEl.value];
                if (suggested) setLineCascade(motorFilterBranchEl, motorFilterLineEl, suggested, 'All Branches', 'All Lines');
                motorApplyFilter();
            });
        }
        const motorRegistryModal = document.getElementById('motorRegistryModal');
        if (motorRegistryModal) motorRegistryModal.addEventListener('shown.bs.modal', motorApplyFilter);

        // locMap itself is declared earlier, at the top of this page's first
        // <script> block -- see the comment there for why it can't live here.
        bindCascadingLocation('exp-parent', 'exp-major', 'exp-sub', 'exp-rack', 'exp-row', 'exp-fda', 'exp-rack-list', 'exp-row-list');
    })();
</script>
