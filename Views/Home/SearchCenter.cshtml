                </div>
                <div class="modal-body text-white">
                    <div class="mb-3">
                        <div class="fw-bold fs-5 text-white" id="trf-item-name">--</div>
                        <small class="text-light-gray" id="trf-item-sub">ID: --</small>
                        <!-- Per-team quantity ownership (2026-08-26): who actually
                             owns this, so the requester isn't guessing before they ask. -->
                        <small class="text-warning d-block mt-1 fw-bold" id="trf-owner-div">--</small>
                    </div>

                    <div class="mb-3" id="trf-loc-div" style="display:none;">
                        <label class="form-label small fw-bold text-light-gray">Pull location</label>
                        <select name="requestedVariantId" id="trf-loc-sel" class="form-select fw-bold text-info"
                                style="background-color:#14151A; border-color:#3D4351;"></select>
                        <small class="text-light-gray d-block mt-1" style="font-size:10px;">A preference -- the owning Line can still pull from elsewhere if this shelf runs short.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-light-gray">Quantity</label>
                        <input type="number" name="quantity" id="trf-qty" class="form-control fw-bold" value="1" min="1" required />
                    </div>

                    <div class="mb-3" id="trf-tc-div" style="display:none;">
                        <label class="form-label small fw-bold" style="color:#F59E0B;">
                            <i class="bi bi-thermometer-half me-1"></i>Thermocoupled count
                        </label>
                        <input type="number" name="thermocoupledCount" id="trf-tc" class="form-control fw-bold" value="0" min="0"
                               style="border-color:#F59E0B;" />
                    </div>

                    <div class="mb-1">
                        <label class="form-label small fw-bold text-light-gray">Note (optional)</label>
                        <input type="text" name="note" maxlength="100" class="form-control" placeholder="What it's for" />
                    </div>
                    <small class="text-light-gray d-block mt-2" style="font-size:10px;">This sends a request -- the owning Line approves it before anything leaves their shelf. Once approved, it's a permanent transfer, not a loan.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="bi bi-arrow-left-right me-1"></i>Send Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

