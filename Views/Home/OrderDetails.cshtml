@model Visual_Inventory_System.Models.Order

@{
    ViewData["Title"] = "Order Details";
    var inventoryLookup = ViewBag.InventoryLookup as System.Collections.Generic.Dictionary<string, Visual_Inventory_System.Models.InventoryItem>;

    // Build a compact friendly breadcrumb of all five location levels. Parent/
    // Major/Sub are stored as codes; LocationCodec.Decode turns them back into
    // names (unknown codes pass through unchanged). "0"/blank levels are dropped.
    // Rack/Row are free-form numbers the team assigns, shown as-is.
    bool Real(string? s) => !string.IsNullOrWhiteSpace(s) && s.Trim() != "0";
    string Friendly(string? code) => Visual_Inventory_System.Services.LocationCodec.Decode(code);
    string FmtLocation(Visual_Inventory_System.Models.InventoryItem? inv)
    {
        if (inv == null) return "-";
        var crumbs = new System.Collections.Generic.List<string>();
        if (Real(inv.Parent)) crumbs.Add(Friendly(inv.Parent));
        if (Real(inv.Major)) crumbs.Add(Friendly(inv.Major));
        if (Real(inv.Sub)) crumbs.Add(Friendly(inv.Sub));
        string path = string.Join(" › ", crumbs);

        string rackRow = "";
        if (Real(inv.Rack) || Real(inv.Row))
            rackRow = $"Rack: {(Real(inv.Rack) ? inv.Rack.Trim() : "-")} / Row: {(Real(inv.Row) ? inv.Row.Trim() : "-")}";

        if (path == "" && rackRow == "") return "-";
        if (path == "") return rackRow;
        if (rackRow == "") return path;
        return $"{path}  ·  {rackRow}";
    }
}

@{
    var splitTo = ViewBag.SplitTo as System.Collections.Generic.List<int> ?? new System.Collections.Generic.List<int>();
    var unitsByOrderItem = ViewBag.UnitsByOrderItem as System.Collections.Generic.Dictionary<int?, System.Collections.Generic.List<Visual_Inventory_System.Models.CompressorUnit>>
        ?? new System.Collections.Generic.Dictionary<int?, System.Collections.Generic.List<Visual_Inventory_System.Models.CompressorUnit>>();
}
<h2>Order @Model.Id</h2>
<p>Created: @Model.CreatedAt.ToLocalTime() @(string.IsNullOrEmpty(Model.RequestedBy) ? "" : $"by {Model.RequestedBy}")</p>
<p>Status: @Model.Status</p>
@if (Model.SplitFromOrderId.HasValue)
{
    <p class="text-muted">Split from <a asp-controller="Home" asp-action="OrderDetails" asp-route-id="@Model.SplitFromOrderId">Order #@Model.SplitFromOrderId</a> -- the rest of that line's original request.</p>
}
@if (splitTo.Any())
{
    <p class="text-muted">
        Part of this order's demand was split off to
        @for (int i = 0; i < splitTo.Count; i++)
        {
            <a asp-controller="Home" asp-action="OrderDetails" asp-route-id="@splitTo[i]">Order #@splitTo[i]</a>@(i < splitTo.Count - 1 ? ", " : "")
        }
        -- a picker took what was on hand and deferred the rest.
    </p>
}
@if (Model.FulfilledAt.HasValue || !string.IsNullOrEmpty(Model.FulfilledBy))
{
    <p>Received: @(Model.FulfilledAt.HasValue ? Model.FulfilledAt.Value.ToLocalTime().ToString() : "—") @(string.IsNullOrEmpty(Model.FulfilledBy) ? "" : $"by {Model.FulfilledBy}")</p>
}

<div class="table-responsive">
<table class="table table-sm" style="min-width:640px;">
    <thead>
        <tr>
            <th>Item ID</th>
            <th>Name</th>
            <th>Brand</th>
            <th>Description</th>
            <th>Location</th>
            <th class="text-end">Quantity</th>
            <th>Serial #</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var it in Model.Items)
    {
        var inv = (inventoryLookup != null && inventoryLookup.ContainsKey(it.ItemId)) ? inventoryLookup[it.ItemId] : null;
        @* "Corrected" is what ReportShortPull flips a short line to once it acts on
           it, so keying only on "Cancelled" dropped the badge at exactly the moment
           its own tooltip became true -- a corrected order rendered as a Cancelled
           header over an unannotated line, with nothing pointing at the reissue. The
           two states get their own wording since one still needs a picker to act. *@
        var wasShort = it.Status == "Cancelled" || it.Status == "Corrected";
        var shortCorrected = it.Status == "Corrected";
        var isCompressor = Visual_Inventory_System.Services.InventoryService.IsCompressorType(inv?.Type);
        var lineUnits = unitsByOrderItem.TryGetValue(it.Id, out var uList) ? uList : new System.Collections.Generic.List<Visual_Inventory_System.Models.CompressorUnit>();
        <tr class="@(wasShort ? "text-muted" : "")">
            <td>@it.ItemId</td>
            <td>@(inv?.ItemName ?? "Unknown item")@(string.IsNullOrWhiteSpace(inv?.RheemPartNumber) ? "" : $" — PN: {inv!.RheemPartNumber}")</td>
            <td>@(string.IsNullOrWhiteSpace(inv?.Brand) ? "----" : inv.Brand)</td>
            <td>@(string.IsNullOrWhiteSpace(inv?.Description) ? "-" : inv.Description)</td>
            <td>
                @(
                    (inv != null) ? FmtLocation(inv) : "-"
                )
            </td>
            <td class="text-end">@it.Quantity</td>
            <td>
                @if (!isCompressor)
                {
                    @:—
                }
                else if (!lineUnits.Any())
                {
                    <span class="text-muted">none on record</span>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var cu in lineUnits)
                        {
                            <li>
                                @(string.IsNullOrWhiteSpace(cu.SerialNumber) ? "(no serial)" : cu.SerialNumber)
                                @if (!string.IsNullOrWhiteSpace(cu.LabNumber))
                                {
                                    <span class="text-muted"> · Lab @cu.LabNumber</span>
                                }
                            </li>
                        }
                    </ul>
                    @if (lineUnits.Count < it.Quantity)
                    {
                        <div class="text-muted" style="font-size:11px;">@(it.Quantity - lineUnits.Count) more unidentified</div>
                    }
                }
            </td>
            <td>
                @if (shortCorrected)
                {
                    <span class="badge bg-warning text-dark" title="Came up short on the shelf; stock was corrected and the real quantity was reissued and picked up on a separate order.">Short — reissued separately</span>
                }
                else if (wasShort)
                {
                    <span class="badge bg-danger" title="Came up short on the shelf. Nothing was pulled — report the real count from the Pickup Queue to correct stock and reissue.">Short — needs correction</span>
                }
                @if (it.Status == "Split")
                {
                    <span class="badge bg-info text-dark" title="Picker took what was on hand here; the remainder was deliberately deferred to a new order.">Split — remainder deferred</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<p><a asp-action="Orders" class="btn btn-sm btn-secondary">Back to Orders</a></p>
